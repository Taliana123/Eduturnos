.page-head {
    margin-bottom: 24px;
}

.page-head h1 {
    margin-bottom: 6px;
}

/* Tablas */
.table-wrap,
.table-responsive {
    border-radius: var(--edu-radius);
    border: 1px solid var(--edu-border);
    background: var(--edu-white);
    box-shadow: var(--edu-shadow);
    overflow-x: auto;
}

table {
    border-collapse: separate;
    border-spacing: 0;
}

thead th {
    color: var(--edu-navy);
    background: #F7F9FC;
    font-weight: 700;
}

tbody tr {
    transition: background-color .2s ease;
}

tbody tr:hover {
    background: rgba(77,145,245,.045);
}

/* Estados */
.badge,
.estado,
.status {
    border-radius: 999px;
    font-weight: 600;
}

/* Filtros */
.filters,
.filtros,
.edc-filters {
    border: 1px solid var(--edu-border);
    border-radius: var(--edu-radius);
    background: var(--edu-white);
    box-shadow: 0 6px 20px rgba(18,57,95,.055);
}

/* Acciones */
.actions,
.form-actions,
.page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
