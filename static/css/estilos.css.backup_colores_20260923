/* ============================================================
   MOVIMIENTO Y ANIMACIÓN — dirección visual "animada, elegante"
   Se apoya en las variables ya existentes (--azul, --azul2,
   --sombra, --radio); no redefine colores nuevos.
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .entrada-hero,.palabra-hero,.revelar,.boton,.boton::before,.hero-visual::after{animation:none!important;transition:none!important}
}

/* Botones vivos: elevación + barrido de brillo + micro-rebote al clic */
.boton{position:relative;overflow:hidden;isolation:isolate;transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .35s ease,background .2s ease}
.boton::before{content:"";position:absolute;inset:0;z-index:-1;transform:translateX(-120%) skewX(-20deg);background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);transition:transform .6s ease}
.boton:hover::before{transform:translateX(120%) skewX(-20deg)}
.boton:hover{transform:translateY(-3px);box-shadow:0 14px 26px -12px rgba(15,63,143,.45)}
.boton:active{transform:translateY(-1px) scale(.97);transition-duration:.12s}

/* Entrada orquestada del héroe: una sola vez al cargar la página */
.entrada-hero{opacity:0;transform:translateY(16px);animation:eduHeroEntrar .6s ease forwards}
.palabra-hero{display:inline-block;opacity:0;transform:translateY(14px);animation:eduHeroEntrar .6s ease forwards}
@keyframes eduHeroEntrar{to{opacity:1;transform:translateY(0)}}

/* Realce sutil del panel "Multiusuario" para que no se sienta plano */
.hero-visual{position:relative;background:linear-gradient(135deg,#eef5ff,#e3f0ff)!important;overflow:hidden}
.hero-visual::after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(22,93,202,.12),transparent 70%);top:-90px;right:-60px;animation:eduFlotar 9s ease-in-out infinite}
@keyframes eduFlotar{0%,100%{transform:translateY(0)}50%{transform:translateY(18px)}}

/* Tarjetas que revelan al hacer scroll, en cascada */
.revelar{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease,box-shadow .3s ease,border-color .3s ease}
.revelar.visible{opacity:1;transform:translateY(0)}
.feature-grid .revelar:nth-child(1){transition-delay:0s}
.feature-grid .revelar:nth-child(2){transition-delay:.1s}
.feature-grid .revelar:nth-child(3){transition-delay:.2s}
.revelar:hover{transform:translateY(-6px);box-shadow:0 16px 28px -16px rgba(15,37,63,.28);border-color:#b8cceb}

/* ============================================================
   EDUTURNOS - TINTA PIZARRA + AZUL + AMBAR
   EDUTURNOS_TINTA_PIZARRA_AMBAR_20260923

   Capa exclusivamente visual.
   No modifica estructura HTML ni funcionalidad.
   ============================================================ */

:root {
    --edu-tinta: #071B33;
    --edu-tinta-2: #0E2F52;
    --edu-tinta-3: #16406B;

    --edu-azul: #165DCA;
    --edu-azul-brillante: #4E8FF0;
    --edu-azul-suave: #EAF2FF;

    --edu-ambar: #D9A441;
    --edu-ambar-claro: #F2C66D;

    --edu-papel: #F5F7FA;
    --edu-blanco: #FFFFFF;

    --edu-texto: #172333;
    --edu-texto-suave: #607080;

    --edu-borde: #D9E2EC;

    --edu-sombra:
        0 14px 35px rgba(7,27,51,.10);

    --edu-sombra-fuerte:
        0 22px 50px rgba(7,27,51,.18);

    --edu-serif:
        "Source Serif 4",
        Georgia,
        serif;

    --edu-sans:
        "Public Sans",
        "Segoe UI",
        Arial,
        sans-serif;
}

/* ------------------------------------------------------------
   TIPOGRAFIA GENERAL
   ------------------------------------------------------------ */

html,
body {
    font-family: var(--edu-sans);
}

h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: var(--edu-serif);
}

/* ------------------------------------------------------------
   PORTADA
   ------------------------------------------------------------ */

.hero.hero-animado {
    position: relative;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(78,143,240,.20),
            transparent 30%
        ),
        radial-gradient(
            circle at 12% 85%,
            rgba(217,164,65,.12),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            var(--edu-tinta),
            var(--edu-tinta-2)
        ) !important;

    color: var(--edu-blanco);
}

/* Luz ambiental discreta */

.hero.hero-animado::before {
    content: "";
    position: absolute;

    width: 420px;
    height: 420px;

    right: -180px;
    top: -190px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(78,143,240,.20),
            transparent 68%
        );

    pointer-events: none;

    animation:
        edu-luz-flotante
        10s
        ease-in-out
        infinite;
}

@keyframes edu-luz-flotante {

    0%,
    100% {
        transform: translate3d(0,0,0);
    }

    50% {
        transform: translate3d(-18px,14px,0);
    }
}

/* ------------------------------------------------------------
   TARJETA PRINCIPAL DEL HERO
   ------------------------------------------------------------ */

.hero-card {
    border-color:
        rgba(255,255,255,.13) !important;

    box-shadow:
        0 24px 55px rgba(0,0,0,.18) !important;
}

.hero.hero-animado .hero-card {
    background:
        rgba(255,255,255,.055);

    backdrop-filter:
        blur(8px);

    -webkit-backdrop-filter:
        blur(8px);
}

/* ------------------------------------------------------------
   TITULO HERO
   ------------------------------------------------------------ */

.hero-titulo {
    font-family: var(--edu-serif) !important;
    letter-spacing: -.025em;
}

.hero-titulo span,
.palabra-hero {
    color: var(--edu-blanco);
}

.hero-titulo span::after {
    content: "";

    display: block;

    width: 62px;
    height: 4px;

    margin-top: 12px;

    border-radius: 999px;

    background:
        linear-gradient(
            90deg,
            var(--edu-ambar),
            var(--edu-ambar-claro)
        );
}

/* ------------------------------------------------------------
   PANEL MULTIUSUARIO
   ------------------------------------------------------------ */

.hero-visual {
    border:
        1px solid rgba(255,255,255,.14) !important;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.10),
            rgba(78,143,240,.09)
        ) !important;

    box-shadow:
        0 25px 55px rgba(0,0,0,.16) !important;
}

.hero-visual::after {
    background:
        radial-gradient(
            circle,
            rgba(217,164,65,.20),
            transparent 70%
        ) !important;
}

/* ------------------------------------------------------------
   TARJETAS DE FUNCIONES
   ------------------------------------------------------------ */

.feature-grid .feature-card {
    background:
        var(--edu-blanco) !important;

    border:
        1px solid var(--edu-borde) !important;

    box-shadow:
        var(--edu-sombra) !important;

    transition:
        transform .30s ease,
        box-shadow .30s ease,
        border-color .30s ease !important;
}

.feature-grid .feature-card:hover {
    transform:
        translateY(-5px);

    border-color:
        rgba(22,93,202,.35) !important;

    box-shadow:
        var(--edu-sombra-fuerte) !important;
}

.feature-grid .feature-card h3 {
    color:
        var(--edu-tinta) !important;
}

.feature-grid .feature-card p {
    color:
        var(--edu-texto-suave);
}

/* Línea superior ámbar */

.feature-grid .feature-card::before {
    content: "";

    display: block;

    width: 38px;
    height: 3px;

    margin-bottom: 14px;

    border-radius: 999px;

    background:
        var(--edu-ambar);
}

/* ------------------------------------------------------------
   BOTONES
   ------------------------------------------------------------ */

.boton {
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        background-color .25s ease,
        border-color .25s ease !important;
}

.boton:hover {
    transform:
        translateY(-2px);

    box-shadow:
        0 12px 24px rgba(7,27,51,.16);
}

.boton:active {
    transform:
        translateY(0);
}

/* ------------------------------------------------------------
   DASHBOARD
   No se cambia su estructura.
   Solo se mejora su lenguaje visual.
   ------------------------------------------------------------ */

.ed-dashboard {
    font-family:
        var(--edu-sans);
}

/* Bienvenida */

.ed-dashboard .ed-welcome {
    border-radius:
        18px;

    border:
        1px solid rgba(22,93,202,.16);

    box-shadow:
        var(--edu-sombra);
}

/* Titulos */

.ed-dashboard .ed-welcome h1,
.ed-dashboard .ed-section h2,
.ed-dashboard .ed-account h2 {
    font-family:
        var(--edu-serif);
}

/* KPIs */

.ed-dashboard .ed-kpi {
    border:
        1px solid var(--edu-borde);

    border-radius:
        15px;

    box-shadow:
        0 8px 22px rgba(7,27,51,.07);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.ed-dashboard .ed-kpi:hover {
    transform:
        translateY(-3px);

    border-color:
        rgba(22,93,202,.30);

    box-shadow:
        0 14px 30px rgba(7,27,51,.11);
}

.ed-dashboard .ed-kpi-value {
    color:
        var(--edu-tinta);
}

.ed-dashboard .ed-kpi-label {
    color:
        var(--edu-texto-suave);
}

/* Acciones */

.ed-dashboard .ed-action {
    border:
        1px solid var(--edu-borde);

    transition:
        transform .25s ease,
        border-color .25s ease,
        box-shadow .25s ease,
        background-color .25s ease;
}

.ed-dashboard .ed-action:hover {
    transform:
        translateY(-3px);

    border-color:
        rgba(22,93,202,.32);

    box-shadow:
        0 14px 28px rgba(7,27,51,.10);

    background:
        #FFFFFF;
}

.ed-dashboard .ed-action-icon {
    color:
        var(--edu-azul);
}

/* ------------------------------------------------------------
   CUENTA
   ------------------------------------------------------------ */

.ed-dashboard .ed-account {
    border-radius:
        18px;
}

/* ------------------------------------------------------------
   ENFOQUE ACCESIBLE
   ------------------------------------------------------------ */

.boton:focus-visible,
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline:
        3px solid rgba(217,164,65,.45);

    outline-offset:
        3px;
}

/* ------------------------------------------------------------
   MOVIMIENTO DISCRETO
   ------------------------------------------------------------ */

@keyframes edu-aparecer-suave {

    from {
        opacity: 0;
        transform:
            translateY(10px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
    }
}

.hero-card.entrada-hero {
    animation:
        edu-aparecer-suave
        .65s
        ease-out
        forwards;
}

/* ------------------------------------------------------------
   REDUCIR ANIMACION SI EL USUARIO LO PREFIERE
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

    .hero.hero-animado::before,
    .hero-card.entrada-hero,
    .boton,
    .feature-grid .feature-card,
    .ed-dashboard .ed-kpi,
    .ed-dashboard .ed-action {
        animation: none !important;
        transition: none !important;
    }
}

/* ------------------------------------------------------------
   MOVIL
   ------------------------------------------------------------ */

@media (max-width: 700px) {

    .hero.hero-animado {
        background:
            linear-gradient(
                150deg,
                var(--edu-tinta),
                var(--edu-tinta-2)
            ) !important;
    }

    .hero.hero-animado::before {
        width: 260px;
        height: 260px;
    }
}


/* ============================================================
   EDUTURNOS — REDISEÑO GLOBAL 2026
   FASE 1 — IDENTIDAD VISUAL CENTRAL
   NO modifica lógica, rutas, formularios ni calendario.
   ============================================================ */

:root {
    --edu-navy: #12395F;
    --edu-navy-2: #0D2D4D;
    --edu-blue: #4D91F5;
    --edu-blue-light: #73ACFF;
    --edu-bg: #F4F7FB;
    --edu-white: #FFFFFF;
    --edu-text: #172033;
    --edu-muted: #64748B;
    --edu-border: #DCE5F0;
    --edu-success: #198754;
    --edu-warning: #D99A17;
    --edu-danger: #C94A4A;
    --edu-radius: 16px;
    --edu-shadow: 0 10px 30px rgba(18,57,95,.08);
    --edu-shadow-hover: 0 16px 38px rgba(18,57,95,.13);
}

/* Base */
html {
    scroll-behavior: smooth;
}

body {
    background: var(--edu-bg);
    color: var(--edu-text);
    font-family: "Public Sans", "Segoe UI", Arial, sans-serif;
}

/* Encabezados */
h1,
h2,
h3,
h4,
h5 {
    color: var(--edu-navy);
    font-family: "Source Serif 4", Georgia, serif;
    letter-spacing: -.015em;
}

h1 {
    font-weight: 700;
}

h2,
h3 {
    font-weight: 600;
}

/* Contenedor */
.contenedor {
    max-width: 1440px;
    margin-inline: auto;
}

/* Tarjetas principales */
.tarjeta,
.panel,
.card,
.dashboard-card,
.quick-card,
.content-card,
.tabla-card,
.form-card {
    border: 1px solid var(--edu-border);
    border-radius: var(--edu-radius);
    background: var(--edu-white);
    box-shadow: var(--edu-shadow);
}

/* Hover únicamente para tarjetas interactivas */
.quick-card,
.dashboard-card,
.ed-card,
.feature-card {
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.quick-card:hover,
.dashboard-card:hover,
.ed-card:hover,
.feature-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--edu-shadow-hover);
    border-color: rgba(77,145,245,.35);
}

/* Botones principales */
.boton,
.btn,
button[type="submit"],
input[type="submit"] {
    font-family: "Public Sans", "Segoe UI", Arial, sans-serif;
    font-weight: 600;
    border-radius: 11px;
    transition:
        transform .25s cubic-bezier(.34,1.56,.64,1),
        box-shadow .25s ease,
        background-color .2s ease,
        border-color .2s ease;
}

.boton:hover,
.btn:hover,
button[type="submit"]:hover,
input[type="submit"]:hover {
    transform: translateY(-2px);
}

.boton:active,
.btn:active,
button[type="submit"]:active,
input[type="submit"]:active {
    transform: translateY(0) scale(.98);
}

/* Campos */
input,
select,
textarea {
    font-family: "Public Sans", "Segoe UI", Arial, sans-serif;
    border-color: var(--edu-border);
    border-radius: 10px;
    color: var(--edu-text);
    background: var(--edu-white);
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: var(--edu-blue);
    box-shadow: 0 0 0 3px rgba(77,145,245,.16);
}

/* Etiquetas */
label {
    color: var(--edu-text);
    font-weight: 600;
}

