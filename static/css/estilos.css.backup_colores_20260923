    }

    .tarjeta,
    .panel,
    .card,
    .dashboard-card,
    .quick-card,
    .content-card,
    .tabla-card,
    .form-card {
        border-radius: 13px;
    }

    h1 {
        font-size: clamp(1.7rem, 8vw, 2.25rem);
    }
}

/* Accesibilidad */
@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
    }
}


