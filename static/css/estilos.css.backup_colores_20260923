}

#contenido .personal-login .form-grid {
    display: grid;
    grid-template-columns: 200px minmax(360px, 1fr) 190px;
    column-gap: 20px;
    row-gap: 20px;
    width: 100%;
    align-items: start;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#contenido .personal-login .form-grid > label {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#contenido .personal-login .form-grid > label select,
#contenido .personal-login .form-grid > label input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

#contenido .personal-login .form-grid > label:nth-child(2) select,
#contenido .personal-login .form-grid > label:nth-child(3) select {
    font-size: 14px;
    font-weight: 400;
    white-space: nowrap;
}

#contenido .personal-login .form-grid > label:nth-child(2) select {
    padding-left: 12px;
    padding-right: 12px;
}

@media (max-width: 950px) {
    #contenido .personal-login .form-grid {
        grid-template-columns: 1fr 1.5fr 1fr;
    }
}

@media (max-width: 900px) {
    #contenido .personal-login .form-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    #contenido .form-card {
        max-width: 100%;
    }

    #contenido .personal-login {
        padding: 18px;
    }

    #contenido .personal-login .form-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }
}

/* =========================================================
   FIN - FORMULARIO INSTITUCIONAL INTEGRADO
   ========================================================= */


/* =========================================================
   EDUTURNOS - LOGIN EDITORIAL
   ========================================================= */

#contenido.login-page {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
}

.login-page {
    width: 100%;
    max-width: none;
    min-height: calc(100vh - 90px);
    margin: 0;
    padding: 54px 24px 64px;
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(77,145,245,.16),
            transparent 34%
        ),
        radial-gradient(
            circle at 88% 80%,
            rgba(217,154,23,.10),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #071B33 0%,
            #0E2F52 52%,
            #12395F 100%
        );

    position: relative;
    overflow: hidden;
}

.login-page::before {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    border: 1px solid rgba(143,193,255,.16);
    border-radius: 50%;
    right: -180px;
    top: -170px;
    pointer-events: none;
}

.login-page::after {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    border: 1px solid rgba(217,154,23,.14);
    border-radius: 50%;
    left: -130px;
    bottom: -130px;
    pointer-events: none;
}

.login-page .form-card {
    position: relative;
    z-index: 2;

    width: min(560px, 100%);
    max-width: 560px;

    margin: 0;
    padding: 42px;

    background: rgba(255,255,255,.98);
    border: 1px solid rgba(255,255,255,.7);
    border-radius: 22px;

    box-shadow:
        0 30px 70px rgba(0,0,0,.28),
        0 8px 24px rgba(7,27,51,.18);

    box-sizing: border-box;
}

.login-page .section-heading {
    position: relative;
    margin-bottom: 30px;
    padding-bottom: 24px;
}

.login-page .section-heading::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;

    width: 64px;
    height: 3px;

    background: #D99A17;
    border-radius: 99px;
}

.login-page .section-heading .badge {
    background: #EAF2FF;
    color: #12395F;
    border: 1px solid #D6E5FA;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.login-page .section-heading h1 {
    margin: 14px 0 10px;

    color: #071B33;

    font-family:
        "Source Serif 4",
        Georgia,
        serif;

    font-size: clamp(34px, 5vw, 46px);
    line-height: 1.05;
    letter-spacing: -.025em;
}

.login-page .section-heading p {
    max-width: 470px;
    color: #64748B;
    font-size: 14px;
    line-height: 1.65;
}

.login-page .stack-form {
    gap: 20px;
}

.login-page .stack-form > label {
    color: #172033;
    font-size: 13px;
    font-weight: 700;
}

.login-page .stack-form input,
.login-page .stack-form select {
    min-height: 48px;
    margin-top: 2px;

    background: #F8FAFC;
    border: 1px solid #DCE5F0;
    border-radius: 11px;

    color: #172033;
}

.login-page .stack-form input:hover,
.login-page .stack-form select:hover {
    border-color: #B9CBE0;
}

.login-page .stack-form input:focus,
.login-page .stack-form select:focus {
    border-color: #4D91F5;
    background: #FFFFFF;
    box-shadow: 0 0 0 4px rgba(77,145,245,.14);
}

/* Panel institucional */

.login-page .personal-login {
    position: relative;

    margin-top: 2px;
    padding: 22px;

    background:
        linear-gradient(
            145deg,
            #F4F7FB,
            #EEF4FA
        );

    border: 1px solid #DCE5F0;
    border-left: 4px solid #D99A17;
    border-radius: 14px;
}

.login-page .personal-login h3 {
    color: #12395F;
    font-family:
        "Source Serif 4",
        Georgia,
        serif;
    font-size: 21px;
    margin-bottom: 7px;
}

.login-page .personal-login > p {
    color: #64748B;
    font-size: 12px;
    line-height: 1.55;
    margin-bottom: 20px;
}

.login-page .personal-login strong {
    color: #12395F;
}

.login-page .personal-login .form-grid {
    margin: 0;
}

.login-page .personal-login .form-grid label {
    color: #334155;
    font-size: 12px;
}

.login-page .personal-login input,
.login-page .personal-login select {
    background: #FFFFFF;
}

/* Botón principal */

.login-page .boton-full {
    min-height: 50px;
    margin-top: 2px;

    background: #4D91F5;
    border: 1px solid #4D91F5;
    border-radius: 11px;

    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;

    box-shadow: 0 10px 24px rgba(18,57,95,.16);
}

.login-page .boton-full:hover {
    background: #12395F;
    border-color: #12395F;
    transform: translateY(-2px);
}

/* Enlaces */

.login-page .form-links {
    margin-top: 24px;
    padding-top: 20px;

    border-top: 1px solid #E5EBF2;
}

.login-page .form-links a {
    color: #386FAE;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
}

.login-page .form-links a:hover {
    color: #12395F;
    text-decoration: underline;
}

/* Responsive */

@media (max-width: 700px) {

    .login-page {
        min-height: auto;
        padding: 30px 16px 44px;
    }

    .login-page .form-card {
        padding: 28px 22px;
        border-radius: 18px;
    }

    .login-page .section-heading h1 {
        font-size: 36px;
    }

}

@media (max-width: 520px) {

    .login-page {
        padding: 20px 12px 32px;
    }

    .login-page .form-card {
        padding: 24px 18px;
    }

    .login-page .personal-login {
        padding: 17px;
    }

}

