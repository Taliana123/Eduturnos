/* Botones generales */
button,
input[type="submit"],
input[type="button"],
input[type="reset"],
.boton,
a.boton,
.btn,
.btn-primary,
.btn-secondary,
.btn-success,
.btn-danger,
.btn-warning,
.action-button,
.accion,
.boton-accion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 9px 16px;
    margin: 0;
    box-sizing: border-box;

    background: var(--edu-blue);
    color: #ffffff;

    border: 1px solid var(--edu-blue);
    border-radius: 10px;

    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;
    cursor: pointer;

    box-shadow: 0 6px 16px rgba(18,57,95,.10);

    transition:
        transform .25s cubic-bezier(.34,1.56,.64,1),
        background-color .2s ease,
        border-color .2s ease,
        box-shadow .25s ease,
        color .2s ease;
}

/* Hover general */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
.boton:hover,
a.boton:hover,
.btn:hover,
.btn-primary:hover,
.btn-secondary:hover,
.btn-success:hover,
.btn-danger:hover,
.btn-warning:hover,
.action-button:hover,
.accion:hover,
.boton-accion:hover {
    background: var(--edu-navy);
    color: #ffffff;
    border-color: var(--edu-navy);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(18,57,95,.16);
}

/* Activación */
button:active,
input[type="submit"]:active,
input[type="button"]:active,
input[type="reset"]:active,
.boton:active,
a.boton:active {
    transform: translateY(0) scale(.98);
}

/* Texto interno de botones */
button *,
.boton *,
a.boton *,
.btn *,
.action-button *,
.accion *,
.boton-accion * {
    color: inherit;
}

/* Estados deshabilitados */
button:disabled,
input[type="submit"]:disabled,
input[type="button"]:disabled,
.boton.disabled,
.boton[aria-disabled="true"] {
    background: #94a3b8;
    color: #ffffff;
    border-color: #94a3b8;
    opacity: .6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

