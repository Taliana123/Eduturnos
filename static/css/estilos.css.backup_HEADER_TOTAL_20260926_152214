/* ============================================================
   EDUTURNOS — SISTEMA VISUAL GLOBAL 2026
   Capa visual global
   NO modifica lógica, rutas, JS ni componentes funcionales.
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap');

:root {
    --ed-ink: #0b1d33;
    --ed-ink-2: #123b68;
    --ed-blue: #2f78ff;
    --ed-blue-2: #6ea8ff;
    --ed-blue-soft: #eaf3ff;
    --ed-amber: #f2b84b;
    --ed-amber-soft: #fff0d1;
    --ed-white: #ffffff;
    --ed-bg: #f4f9ff;
    --ed-surface: #ffffff;
    --ed-line: #dce7f3;
    --ed-text: #17365d;
    --ed-muted: #647b94;
    --ed-green: #20b486;
    --ed-red: #e56b6f;

    --ed-radius-sm: 10px;
    --ed-radius-md: 16px;
    --ed-radius-lg: 24px;
    --ed-radius-xl: 32px;

    --ed-shadow-sm: 0 6px 20px rgba(11, 29, 51, .06);
    --ed-shadow-md: 0 16px 45px rgba(11, 29, 51, .10);
    --ed-shadow-lg: 0 28px 80px rgba(11, 29, 51, .14);

    --ed-transition: 180ms ease;
}

/* ============================================================
   BASE
   ============================================================ */

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Public Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    background:
        radial-gradient(circle at 5% 0%, rgba(47,120,255,.07), transparent 28rem),
        linear-gradient(180deg, #f8fbff 0%, var(--ed-bg) 100%) !important;
    color: var(--ed-text) !important;
    -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4 {
    font-family: "Source Serif 4", Georgia, serif !important;
    color: var(--ed-ink) !important;
    letter-spacing: -.025em;
}

a {
    transition:
        color var(--ed-transition),
        background var(--ed-transition),
        transform var(--ed-transition);
}

button,
.btn,
input[type="submit"],
input[type="button"] {
    font-family: "Public Sans", system-ui, sans-serif !important;
}

/* ============================================================
   CONTENEDORES GENERALES
   ============================================================ */

main,
main.container,
.container {
    position: relative;
}

.container {
    max-width: 1380px;
}

section {
    position: relative;
}

/* ============================================================
   NAV / HEADER
   ============================================================ */

header,
.site-header,
.main-header,
.app-header,
.topbar,
.top-bar {
    position: relative;
    z-index: 20;
}

nav,
.navbar {
    font-family: "Public Sans", system-ui, sans-serif !important;
}

.navbar,
.site-header,
.topbar {
    background: rgba(255,255,255,.90) !important;
    border-bottom: 1px solid rgba(220,231,243,.85) !important;
    box-shadow: 0 4px 25px rgba(11,29,51,.045) !important;
    backdrop-filter: blur(16px);
}

/* ============================================================
   CARDS — QUITAR ASPECTO DE PLANTILLA GENÉRICA
   ============================================================ */

.card,
.panel,
.box,
.widget,
.stat-card,
.info-card,
.dashboard-card,
.content-card {
    background: rgba(255,255,255,.96) !important;
    border: 1px solid var(--ed-line) !important;
    border-radius: var(--ed-radius-lg) !important;
    box-shadow: var(--ed-shadow-sm) !important;
    transition:
        transform var(--ed-transition),
        box-shadow var(--ed-transition),
        border-color var(--ed-transition) !important;
}

.card:hover,
.panel:hover,
.widget:hover,
.dashboard-card:hover,
.content-card:hover {
    transform: translateY(-2px);
    border-color: rgba(47,120,255,.25) !important;
    box-shadow: var(--ed-shadow-md) !important;
}

.card-header,
.panel-header,
.widget-header {
    border-bottom-color: var(--ed-line) !important;
}

/* ============================================================
   BOTONES
   ============================================================ */

.btn,
button.btn,
a.btn {
    border-radius: 12px !important;
    font-weight: 700 !important;
    letter-spacing: -.01em;
    transition:
        transform 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease !important;
}

.btn:hover,
button.btn:hover,
a.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(11,29,51,.12) !important;
}

.btn-primary,
button.btn-primary,
a.btn-primary {
    background: linear-gradient(135deg, #2f78ff, #2464dc) !important;
    border-color: #2f78ff !important;
    color: #fff !important;
}

.btn-primary:hover,
button.btn-primary:hover,
a.btn-primary:hover {
    background: linear-gradient(135deg, #3c82ff, #1f5dcc) !important;
}

.btn-secondary {
    background: #eef5ff !important;
    border-color: #d5e5fa !important;
    color: var(--ed-ink-2) !important;
}

/* ============================================================
   FORMULARIOS
   ============================================================ */

label {
    color: var(--ed-text) !important;
    font-weight: 700 !important;
}

input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
select,
textarea {
    width: 100%;
    min-height: 46px;
    border: 1px solid #d5e2ef !important;
    border-radius: 12px !important;
    background: #fff !important;
    color: var(--ed-text) !important;
    padding: 11px 13px !important;
    font-family: "Public Sans", system-ui, sans-serif !important;
    transition:
        border-color 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease !important;
}

textarea {
    min-height: 110px;
}

input:not([type="checkbox"]):not([type="radio"]):focus,
select:focus,
textarea:focus {
    outline: none !important;
    border-color: #6ea8ff !important;
    box-shadow: 0 0 0 4px rgba(47,120,255,.11) !important;
}

/* ============================================================
   TABLAS
   ============================================================ */

table {
    border-collapse: separate !important;
    border-spacing: 0 !important;
    overflow: hidden;
    border: 1px solid var(--ed-line) !important;
    border-radius: 18px !important;
    background: #fff !important;
    box-shadow: var(--ed-shadow-sm) !important;
}

thead th {
    background: #f1f6fc !important;
    color: var(--ed-ink) !important;
    font-weight: 800 !important;
    border-bottom: 1px solid var(--ed-line) !important;
}

tbody td {
    border-bottom: 1px solid #edf2f7 !important;
}

tbody tr:last-child td {
    border-bottom: 0 !important;
}

tbody tr {
    transition: background 140ms ease;
}

tbody tr:hover {
    background: #f8fbff !important;
}

/* ============================================================
   ALERTAS / ESTADOS
   ============================================================ */

.alert,
.flash,
.message,
.notification,
.badge {
    border-radius: 12px !important;
}

.alert-success,
.status-success {
    background: #e7f8f2 !important;
    border-color: #bcebdc !important;
    color: #117456 !important;
}

.alert-warning,
.status-warning {
    background: #fff5df !important;
    border-color: #f5d99b !important;
    color: #76520b !important;
}

.alert-danger,
.status-danger {
    background: #fff0f1 !important;
    border-color: #f2c2c5 !important;
    color: #9b3c42 !important;
}

/* ============================================================
   TITULOS DE PAGINA
   ============================================================ */

.page-title,
.section-title,
.content-title,
.dashboard-title {
    position: relative;
    margin-bottom: 8px;
}

.page-title::after,
.section-title::after {
    content: "";
    display: block;
    width: 42px;
    height: 4px;
    margin-top: 12px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--ed-blue), var(--ed-amber));
}

/* ============================================================
   SIDEBAR / MENU SI EXISTE EN ALGUNA VISTA
   ============================================================ */

aside,
.sidebar,
.app-sidebar,
.side-menu {
    background:
        radial-gradient(circle at 15% 0%, rgba(110,168,255,.16), transparent 22rem),
        linear-gradient(180deg, #0b1d33 0%, #102c4b 100%) !important;
    color: #fff !important;
}

aside a,
.sidebar a,
.app-sidebar a,
.side-menu a {
    border-radius: 11px !important;
    color: rgba(255,255,255,.78) !important;
    transition:
        background 160ms ease,
        color 160ms ease,
        transform 160ms ease !important;
}

aside a:hover,
.sidebar a:hover,
.app-sidebar a:hover,
.side-menu a:hover {
    background: rgba(255,255,255,.09) !important;
    color: #fff !important;
    transform: translateX(2px);
}

/* ============================================================
   DASHBOARD — APARIENCIA EDITORIAL
   ============================================================ */

.dashboard,
.dashboard-page,
.dashboard-container {
    background:
        radial-gradient(circle at 85% 0%, rgba(47,120,255,.08), transparent 26rem),
        #f4f9ff !important;
}

.dashboard .card,
.dashboard-page .card {
    min-height: 100%;
}

.dashboard h1,
.dashboard h2,
.dashboard-page h1,
.dashboard-page h2 {
    font-family: "Source Serif 4", Georgia, serif !important;
}

/* ============================================================
   CALENDARIO — SOLO PRESENTACION
   NO MODIFICA FULLCALENDAR NI SU LOGICA
   ============================================================ */

.fc {
    font-family: "Public Sans", system-ui, sans-serif !important;
}

.fc .fc-toolbar-title {
    font-family: "Source Serif 4", Georgia, serif !important;
