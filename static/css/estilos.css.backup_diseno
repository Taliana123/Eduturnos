/* ============================================================
   NOTIFICACIONES
============================================================ */

.notifications-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.notification-card {
    padding: 18px;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
}

.notification-unread {
    border-left: 4px solid #1f5eff;
}

.notification-content p {
    margin: 8px 0;
}

.notification-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.notification-header h3 {
    margin: 0;
}

.notification-card small {
    opacity: 0.65;
}


/* ============================================================
   ESTADO VACÍO
============================================================ */

.empty-state {
    padding: 35px 20px;
    text-align: center;
    border: 1px dashed #ccc;
    border-radius: 10px;
    background: #fafafa;
}

.empty-state h3 {
    margin-top: 0;
}

/* =========================================================
   EDUTURNOS - LISTAS DESPLEGABLES
   ========================================================= */

select {
    width: 100%;
    min-height: 46px;
    padding: 10px 40px 10px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background-color: #ffffff;
    color: #1e293b;
    font-size: 15px;
    cursor: pointer;
    box-sizing: border-box;
}

select:hover {
    border-color: #2563eb;
}

select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

select.eduturnos-select-vacio {
    color: transparent;
}

select.eduturnos-select-vacio option {
    color: #1e293b;
}

select option {
    background: #ffffff;
    color: #1e293b;
}

/* =========================================================
   EDUTURNOS - LISTAS: TEXTO NORMAL
   ========================================================= */

select {
    font-weight: 400 !important;
}

select option {
    font-weight: 400 !important;
}
