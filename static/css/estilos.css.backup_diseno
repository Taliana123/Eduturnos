/* ============================================================
   NAVEGACIÓN DEL DASHBOARD - EDUTURNOS
============================================================ */

.dashboard-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 24px;
}

.dashboard-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: flex-end;
}

.boton-secondary {
    background: #ffffff;
    color: #17365d;
    border: 1px solid #cbd5e1;
}

.boton-secondary:hover {
    background: #f1f5f9;
}

.boton-danger {
    background: #b91c1c;
    color: #ffffff;
    border: 1px solid #b91c1c;
}

.boton-danger:hover {
    background: #991b1b;
}

.card-heading {
    margin-bottom: 20px;
}

.card-heading h2 {
    margin-top: 6px;
    margin-bottom: 6px;
}

.quick-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
}

.quick-card small {
    margin-top: 6px;
    font-weight: 600;
}

.quick-icon {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 4px;
}

.account-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 800px) {

    .dashboard-head {
        flex-direction: column;
    }

    .dashboard-navigation {
        width: 100%;
        justify-content: flex-start;
    }

    .dashboard-navigation .boton {
        flex: 1;
        min-width: 150px;
    }

}

@media (max-width: 520px) {

    .dashboard-navigation {
        flex-direction: column;
        align-items: stretch;
    }

    .dashboard-navigation .boton {
        width: 100%;
    }

}

/* ============================================================
   NAVEGACIÓN INTERNA
============================================================ */

.page-navigation {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
}

.page-navigation .link-back {
    text-decoration: none;
    font-weight: 600;
}

.navigation-separator {
    opacity: 0.45;
}


/* ============================================================
   EVITAR SATURACIÓN EN ACCIONES
============================================================ */

.acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.inline-form {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 2px;
}

.table-wrap td:last-child {
    white-space: normal;
}

.table-wrap td:last-child a {
    margin: 2px 4px;
    display: inline-block;
}

