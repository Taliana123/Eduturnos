import mysql.connector
from flask import current_app


def ensure_database(config=None):
    """
    Comprueba que EDUTURNOS pueda conectarse a la base de datos.
    La configuración inicial de MySQL se realiza mediante
    PRIMERA_VEZ.bat / setup_database.py, no en cada arranque de Flask.
    """
    cfg = config or current_app.config

    try:
        cnx = mysql.connector.connect(
            host=cfg["MYSQL_HOST"],
            port=cfg["MYSQL_PORT"],
            user=cfg["MYSQL_USER"],
            password=cfg["MYSQL_PASSWORD"],
            database=cfg["MYSQL_DATABASE"],
            connection_timeout=8,
        )

        cursor = cnx.cursor()
        cursor.execute("SELECT 1")
        cursor.fetchone()

        # Migraciones pequeñas y seguras para instalaciones existentes.
        # La creación inicial completa sigue estando en database/eduturnos.sql.
        cursor.execute("SHOW COLUMNS FROM citas LIKE 'recordatorio_24h_enviado'")
        if cursor.fetchone() is None:
            cursor.execute("ALTER TABLE citas ADD COLUMN recordatorio_24h_enviado TINYINT(1) NOT NULL DEFAULT 0")

        cursor.execute("SHOW COLUMNS FROM citas LIKE 'recordatorio_2h_enviado'")
        if cursor.fetchone() is None:
            cursor.execute("ALTER TABLE citas ADD COLUMN recordatorio_2h_enviado TINYINT(1) NOT NULL DEFAULT 0")

        cursor.execute("SHOW INDEX FROM citas WHERE Key_name = 'idx_cita_recordatorios'")
        if cursor.fetchone() is None:
            cursor.execute("CREATE INDEX idx_cita_recordatorios ON citas (fecha, hora, recordatorio_24h_enviado, recordatorio_2h_enviado)")

        cnx.commit()
        cursor.close()
        cnx.close()

        return True, "Base de datos verificada y migraciones compatibles aplicadas."

    except Exception as exc:
        return False, f"No fue posible conectar con MySQL: {exc}"


def inicializar_datos_base():
    """Alias para comprobación manual de la base de datos."""
    return ensure_database()


if __name__ == "__main__":
    ok, mensaje = inicializar_datos_base()
    print(mensaje)