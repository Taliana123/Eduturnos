{% extends 'base.html' %}

{% block title %}Panel · EDUTURNOS{% endblock %}

{% block content %}

<section class="dashboard-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="dashboard-head">

        <div class="dashboard-head-info">

            <span class="badge">
                {{ usuario.rol_nombre }}
            </span>

            <h1>
                Hola, {{ usuario.nombres }} {{ usuario.apellidos }}
            </h1>

            <p class="muted">
                Información y accesos según tu rol institucional.
            </p>

        </div>

        <div class="dashboard-head-action">

            <a
                class="boton boton-danger dashboard-logout"
                href="{{ url_for('auth.logout') }}"
            >
                Cerrar sesión
            </a>

        </div>

    </div>


    <!-- =====================================================
         INDICADORES
         ===================================================== -->

    <section class="dashboard-kpis">

        <article class="dashboard-kpi">
            <span>Total de citas</span>
            <strong>{{ datos.total_citas }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Pendientes</span>
            <strong>{{ datos.pendientes }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Confirmadas</span>
            <strong>{{ datos.confirmadas }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Notificaciones sin leer</span>
            <strong>{{ notificaciones_no_leidas }}</strong>
        </article>

    </section>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="dashboard-main">

        <!-- ACCIONES -->
        <section class="dashboard-card dashboard-actions-card">

            <div class="dashboard-card-head">

                <div>
                    <span class="badge">Accesos</span>

                    <h2>Acciones rápidas</h2>

                    <p class="muted">
                        Accede directamente a las funciones disponibles para tu rol.
                    </p>
                </div>

            </div>


            <div class="dashboard-action-grid">

                <!-- CITAS -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('citas.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Citas
                        </span>
                    </div>

                    <h3>Citas</h3>

                    <p>
                        Consultar y gestionar citaciones.
                    </p>

                    <span class="dashboard-action-link">
                        Ver citas →
                    </span>

                </a>


                <!-- CALENDARIO -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('calendario.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Calendario
                        </span>
                    </div>

                    <h3>Calendario</h3>

                    <p>
                        Revisar fechas y horarios.
                    </p>

                    <span class="dashboard-action-link">
                        Abrir calendario →
                    </span>

                </a>


                <!-- NOTIFICACIONES -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('notificaciones.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Avisos
                        </span>
                    </div>

                    <h3>Notificaciones</h3>

                    <p>
                        Ver avisos y novedades del sistema.
                    </p>

                    {% if notificaciones_no_leidas > 0 %}

                    <span class="dashboard-action-link">
                        {{ notificaciones_no_leidas }} sin leer →
                    </span>

                    {% else %}

                    <span class="dashboard-action-link">
                        Ver notificaciones →
                    </span>

                    {% endif %}

                </a>


                <!-- SOLICITUDES -->

                {% if usuario.rol_nombre in [
                    'Docente',
                    'Administrador / Coordinador',
                    'Rector',
                    'Super Admin'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('solicitudes.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Solicitudes
                        </span>
                    </div>

                    <h3>Solicitudes</h3>

                    <p>
                        Gestionar reuniones y propuestas.
                    </p>

                    <span class="dashboard-action-link">
                        Ver solicitudes →
                    </span>

                </a>

                {% endif %}


                <!-- REPORTES -->

                {% if usuario.rol_nombre in [
                    'Administrador / Coordinador',
                    'Rector',
                    'Super Admin'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('reportes.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Reportes
                        </span>
                    </div>

                    <h3>Reportes</h3>

                    <p>
                        Consultar indicadores institucionales.
                    </p>

                    <span class="dashboard-action-link">
                        Ver reportes →
                    </span>

                </a>

                {% endif %}


                <!-- JUSTIFICACIONES -->

                {% if usuario.rol_nombre in [
                    'Estudiante',
                    'Acudiente'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('justificaciones.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Justificaciones
                        </span>
                    </div>

                    <h3>Justificaciones</h3>

                    <p>
                        Consultar o presentar solicitudes.
                    </p>

                    <span class="dashboard-action-link">
                        Ver justificaciones →
                    </span>

                </a>

                {% endif %}

            </div>

        </section>


        <!-- CUENTA -->

        <section class="dashboard-card dashboard-account-card">

            <div class="dashboard-card-head">

                <div>
                    <span class="badge">Cuenta</span>

                    <h2>Mi cuenta</h2>
                </div>

            </div>

            <p class="muted dashboard-account-text">
                Mantén una contraseña personal segura y actualizada.
            </p>

            <div class="dashboard-account-action">

                <a
                    class="boton boton-full"
                    href="{{ url_for('passwords.cambiar_password') }}"
                >
                    Cambiar contraseña
                </a>

            </div>

        </section>

    </div>

</section>


<style>

/* =========================================================
   EDUTURNOS - DASHBOARD ORGANIZADO
   ========================================================= */

.dashboard-page {
    width: 100%;
    max-width: 1180px;

    margin: 0 auto;

    padding: 10px 0 35px;

    box-sizing: border-box;
}

/* =========================================================
   ENCABEZADO
   ========================================================= */

.dashboard-head {
    width: 100%;

    display: flex;

    justify-content: space-between;
    align-items: flex-start;

    gap: 25px;

    margin-bottom: 24px;

    box-sizing: border-box;
}

.dashboard-head-info {
    min-width: 0;
}

.dashboard-head-info h1 {
    margin: 8px 0 8px;

    color: #0f172a;

    font-size: 30px;

    line-height: 1.2;
}

.dashboard-head-info p {
    margin: 0;

    line-height: 1.5;
}

.dashboard-head-action {
    flex-shrink: 0;
}

.dashboard-logout {
    white-space: nowrap;
}

/* =========================================================
   INDICADORES
   ========================================================= */

.dashboard-kpis {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;

    width: 100%;

    margin-bottom: 24px;
}

.dashboard-kpi {
    min-width: 0;

    padding: 20px;

    background: #ffffff;

    border: 1px solid #dbe3ec;

    border-radius: 12px;

    box-shadow:
        0 2px 7px rgba(15, 23, 42, 0.05);

    box-sizing: border-box;
}

.dashboard-kpi span {
    display: block;

    margin-bottom: 8px;

    color: #64748b;

    font-size: 13px;

    line-height: 1.35;
}

.dashboard-kpi strong {
    display: block;

    color: #0f172a;

    font-size: 27px;

    line-height: 1.1;

    font-weight: 700;
}

/* =========================================================
   CONTENEDORES
   ========================================================= */

.dashboard-main {
    width: 100%;

    display: grid;

    grid-template-columns:
        minmax(0, 1fr);

    gap: 20px;
}

.dashboard-card {
    width: 100%;

    padding: 24px;

    background: #ffffff;

    border: 1px solid #dbe3ec;

    border-radius: 14px;

    box-shadow:
        0 3px 9px rgba(15, 23, 42, 0.05);

    box-sizing: border-box;
}

/* =========================================================
   ENCABEZADO DE CADA TARJETA
   ========================================================= */

.dashboard-card-head {
    width: 100%;

    margin-bottom: 20px;
}

.dashboard-card-head h2 {
    margin: 8px 0 7px;

    color: #0f172a;

    font-size: 22px;

    line-height: 1.2;
}

.dashboard-card-head p {
    margin: 0;

    line-height: 1.5;
}

/* =========================================================
   ACCIONES RÁPIDAS
   ========================================================= */

.dashboard-action-grid {
    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;

    align-items: stretch;
}

.dashboard-action {
    min-width: 0;

    min-height: 190px;

    padding: 18px;

    display: flex;

    flex-direction: column;

    align-items: stretch;

    justify-content: flex-start;

    text-decoration: none;

    background: #f8fafc;

    border: 1px solid #dbe3ec;

    border-radius: 11px;

    box-sizing: border-box;

    transition:
        transform 0.15s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.dashboard-action:hover {
    transform: translateY(-2px);

    background: #ffffff;

    border-color: #bfdbfe;

    box-shadow:
        0 7px 18px rgba(15, 23, 42, 0.08);
}

.dashboard-action-top {
    width: 100%;

    margin-bottom: 15px;
}

.dashboard-action-icon {
    display: inline-flex;

    align-items: center;

    min-height: 30px;

    padding: 6px 10px;

    border-radius: 7px;

    background: #eaf2ff;

    color: #2563eb;

    font-size: 12px;

    font-weight: 600;

    line-height: 1;
}

.dashboard-action h3 {
    margin: 0 0 8px;

    color: #0f172a;

    font-size: 18px;

    line-height: 1.2;
}

.dashboard-action p {
    flex: 1;

    margin: 0;

    color: #64748b;

    font-size: 13.5px;

    line-height: 1.45;
}

.dashboard-action-link {
    display: block;

    margin-top: 16px;

    color: #2563eb;

    font-size: 13px;

    font-weight: 600;

    line-height: 1.3;
}

/* =========================================================
   MI CUENTA
   ========================================================= */

.dashboard-account-card {
    max-width: 100%;
}

.dashboard-account-text {
    margin: 0 0 18px;

    line-height: 1.5;
}

.dashboard-account-action {
    width: 100%;
    max-width: 300px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .dashboard-action-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 800px) {

    .dashboard-kpis {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .dashboard-head {
        flex-direction: column;
        align-items: stretch;
    }

    .dashboard-head-action {
        width: 100%;
    }

    .dashboard-logout {
        width: 100%;
    }
}

@media (max-width: 600px) {

    .dashboard-page {
        padding-top: 5px;
    }

    .dashboard-card {
        padding: 18px;
    }

    .dashboard-head-info h1 {
        font-size: 25px;
    }

    .dashboard-kpis {
        grid-template-columns: 1fr;

        gap: 12px;
    }

    .dashboard-action-grid {
        grid-template-columns: 1fr;

        gap: 12px;
    }

    .dashboard-action {
        min-height: 0;
    }

    .dashboard-account-action {
        max-width: none;
    }
}

</style>



<!-- EDUTURNOS - ESPACIADO TITULOS DASHBOARD -->

<style>

/* =========================================================
   ESPACIADO DE TITULOS DEL DASHBOARD
   ========================================================= */

/* DOCENTE */
.dashboard-head-info .badge {
    display: inline-block !important;
    margin-bottom: 14px !important;
}

.dashboard-head-info h1 {
    margin-top: 0 !important;
    margin-bottom: 12px !important;
}

.dashboard-head-info p {
    margin-top: 0 !important;
}

/* ACCESOS */
.dashboard-card-head .badge {
    display: inline-block !important;
    margin-bottom: 13px !important;
}

.dashboard-card-head h2 {
    margin-top: 0 !important;
    margin-bottom: 11px !important;
}

.dashboard-card-head p {
    margin-top: 0 !important;
}

/* CUENTA */
.dashboard-account-card .dashboard-card-head {
    margin-bottom: 17px !important;
}

.dashboard-account-card .dashboard-card-head .badge {
    margin-bottom: 13px !important;
}

.dashboard-account-card .dashboard-card-head h2 {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

.dashboard-account-text {
    margin-top: 0 !important;
    margin-bottom: 20px !important;
}

/* Un poco más de aire antes de los indicadores */
.dashboard-head {
    margin-bottom: 28px !important;
}

/* Separación entre indicadores y Accesos */
.dashboard-kpis {
    margin-bottom: 28px !important;
}

/* Separación dentro de Acciones rápidas */
.dashboard-actions-card .dashboard-card-head {
    margin-bottom: 24px !important;
}

</style>

<!-- FIN EDUTURNOS - ESPACIADO TITULOS DASHBOARD -->



<!-- EDUTURNOS_ACCESOS_ANIMADOS -->

<style id="eduturnos-accesos-animados">

/* =========================================================
   EDUTURNOS - ACCESOS ELEGANTES Y ANIMADOS
   ========================================================= */

.dashboard-action-grid {
    display: grid !important;

    grid-template-columns:
        repeat(4, minmax(0, 1fr)) !important;

    gap: 18px !important;

    width: 100% !important;

    align-items: stretch !important;
}

/* =========================================================
   TARJETAS
   ========================================================= */

.dashboard-action {
    position: relative !important;

    isolation: isolate !important;

    overflow: hidden !important;

    min-height: 205px !important;

    padding: 20px !important;

    display: flex !important;

    flex-direction: column !important;

    justify-content: flex-start !important;

    border: 1px solid #dbe4ef !important;

    border-radius: 16px !important;

    background:
        linear-gradient(
            145deg,
            #ffffff 0%,
            #f8fbff 100%
        ) !important;

    box-shadow:
        0 5px 16px rgba(15, 23, 42, 0.06) !important;

    text-decoration: none !important;

    transform: translateY(0) !important;

    transition:
        transform 0.28s ease,
        box-shadow 0.28s ease,
        border-color 0.28s ease,
        background 0.28s ease !important;

    animation:
        entradaAcceso 0.55s ease both;
}

/* =========================================================
   ANIMACIÓN DE ENTRADA
   ========================================================= */

.dashboard-action:nth-child(1) {
    animation-delay: 0.05s;
}

.dashboard-action:nth-child(2) {
    animation-delay: 0.12s;
}

.dashboard-action:nth-child(3) {
    animation-delay: 0.19s;
}

.dashboard-action:nth-child(4) {
    animation-delay: 0.26s;
}

.dashboard-action:nth-child(5) {
    animation-delay: 0.33s;
}

.dashboard-action:nth-child(6) {
    animation-delay: 0.40s;
}

@keyframes entradaAcceso {

    from {
        opacity: 0;
        transform: translateY(14px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* =========================================================
   BRILLO SUTIL
   ========================================================= */

.dashboard-action::before {
    content: "";

    position: absolute;

    top: -80%;
    left: -35%;

    width: 35%;
    height: 260%;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,0.72),
            transparent
        );

    transform: rotate(18deg) translateX(-220%);

    transition:
        transform 0.65s ease;

    pointer-events: none;

    z-index: -1;
}

.dashboard-action:hover::before {
    transform:
        rotate(18deg)
        translateX(520%);
}

/* =========================================================
   HOVER
   ========================================================= */

.dashboard-action:hover {

    transform:
        translateY(-7px)
        scale(1.01) !important;

    border-color: #b8d3f8 !important;

    background:
        linear-gradient(
            145deg,
            #ffffff 0%,
            #f2f7ff 100%
        ) !important;

    box-shadow:
        0 14px 30px rgba(15, 23, 42, 0.12),
        0 0 0 1px rgba(37, 99, 235, 0.04) !important;
}

/* =========================================================
   ETIQUETA SUPERIOR
   ========================================================= */

.dashboard-action-top {
    display: flex !important;

    align-items: center !important;

    width: 100% !important;

    margin-bottom: 16px !important;
}

.dashboard-action-icon {

    position: relative !important;

    display: inline-flex !important;

    align-items: center !important;

    justify-content: center !important;

    min-height: 32px !important;

    padding: 7px 12px !important;

    border-radius: 9px !important;

    background:
        linear-gradient(
            135deg,
            #e9f2ff,
            #dceaff
        ) !important;

    color: #2563eb !important;

    font-size: 12px !important;

    font-weight: 700 !important;

    line-height: 1 !important;

    box-shadow:
        inset 0 0 0 1px rgba(37, 99, 235, 0.08) !important;

    transition:
        transform 0.28s ease,
        box-shadow 0.28s ease,
        background 0.28s ease !important;
}

.dashboard-action:hover
.dashboard-action-icon {

    transform:
        translateY(-2px)
        scale(1.04);

    background:
        linear-gradient(
            135deg,
            #dceaff,
            #cfe0ff
        ) !important;

    box-shadow:
        0 5px 12px rgba(37, 99, 235, 0.14) !important;
}

/* =========================================================
   TÍTULO
   ========================================================= */

.dashboard-action h3 {

    margin: 0 0 9px 0 !important;

    color: #0f172a !important;

    font-size: 19px !important;

    font-weight: 700 !important;

    line-height: 1.2 !important;

    letter-spacing: -0.01em !important;

    transition:
        transform 0.25s ease,
        color 0.25s ease !important;
}

.dashboard-action:hover h3 {

    transform: translateX(2px);

    color: #1d4ed8 !important;
}

/* =========================================================
   DESCRIPCIÓN
   ========================================================= */

.dashboard-action p {

    flex: 1 !important;

    margin: 0 !important;

    color: #64748b !important;

    font-size: 13.5px !important;

    line-height: 1.55 !important;
}

/* =========================================================
   ENLACE INFERIOR
   ========================================================= */

.dashboard-action-link {

    display: inline-flex !important;

    align-items: center !important;

    width: fit-content !important;

    margin-top: 17px !important;

    color: #2563eb !important;

    font-size: 13px !important;

    font-weight: 700 !important;

    line-height: 1.3 !important;

    transition:
        transform 0.25s ease,
        color 0.25s ease !important;
}

.dashboard-action:hover
.dashboard-action-link {

    transform: translateX(5px);

    color: #1d4ed8 !important;
}

/* =========================================================
   BORDE SUPERIOR DECORATIVO
   ========================================================= */

.dashboard-action::after {

    content: "";

    position: absolute;

    top: 0;
    left: 18px;
    right: 18px;

    height: 3px;

    border-radius: 0 0 8px 8px;

    background:
        linear-gradient(
            90deg,
            #2563eb,
            #60a5fa
        );

    opacity: 0.7;

    transform: scaleX(0.35);

    transform-origin: center;

    transition:
        transform 0.28s ease,
        opacity 0.28s ease;
}

.dashboard-action:hover::after {

    transform: scaleX(1);

    opacity: 1;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

    .dashboard-action-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 600px) {

    .dashboard-action-grid {
        grid-template-columns: 1fr !important;
    }

    .dashboard-action {
        min-height: 175px !important;
    }
}

/* =========================================================
   REDUCIR MOVIMIENTO SI EL SISTEMA LO SOLICITA
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .dashboard-action {
        animation: none !important;

        transition: none !important;
    }

    .dashboard-action::before,
    .dashboard-action::after {
        transition: none !important;
    }
}

</style>

<!-- FIN EDUTURNOS_ACCESOS_ANIMADOS -->

{% endblock %}
