{% extends 'base.html' %}{% block content %}<h1>Asignaciones: {{ docente.nombres }} {{ docente.apellidos }}</h1><div class="panel"><form method="post" class="form-grid">{{ csrf_field()|safe }}<label>Estudiante<select name="estudiante">
<option value="" selected disabled hidden></option>
{% for e in catalogos.estudiantes %}<option value="{{ e.id_estudiante }}">{{ e.apellidos }} {{ e.nombres }} · {{ e.documento }}</option>{% endfor %}</select></label><label>Grupo<select name="grupo">
<option value="" selected disabled hidden></option>
{% for g in catalogos.grupos %}<option value="{{ g.id }}">{{ g.grado }} - {{ g.nombre }}</option>{% endfor %}</select></label><button class="boton">Guardar asignación</button></form></div><div class="table-wrap"><table><tr><th>Estudiante</th><th>Grupo</th><th>Estado</th></tr>{% for a in asignaciones %}<tr><td>{{ (a.estudiante_n or '') }} {{ (a.estudiante_a or '') }}</td><td>{{ (a.grado or '') }} {{ (a.grupo or '') }}</td><td>{{ 'Activa' if a.estado else 'Inactiva' }}</td></tr>{% else %}<tr><td colspan="3">No hay asignaciones.</td></tr>{% endfor %}</table></div>

<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
