                           C256 113 244 106 229 104
                           C211 119 187 122 163 115
                           C160 122 156 129 151 132 Z"
                    />


                    <!-- oreja izquierda -->

                    <path
                        class="persona-piel"
                        d="M154 147
                           C145 143 140 151 144 163
                           C147 173 154 177 161 173"
                    />


                    <!-- oreja derecha -->

                    <path
                        class="persona-piel"
                        d="M259 147
                           C268 143 273 151 269 163
                           C266 173 259 177 252 173"
                    />


                    <!-- rostro -->

                    <path
                        class="persona-piel"
                        d="M158 128
                           C158 100 180 87 210 87
                           C241 87 259 105 259 131
                           L259 157
                           C259 184 239 205 210 205
                           C181 205 158 184 158 157 Z"
                    />


                    <!-- flequillo -->

                    <path
                        class="persona-cabello"
                        d="M157 130
                           C157 99 179 80 209 80
                           C238 80 260 99 261 129
                           C245 116 232 109 217 106
                           C204 119 183 126 157 130 Z"
                    />


                    <!-- ojos -->

                    <ellipse
                        class="persona-ojo"
                        cx="188"
                        cy="150"
                        rx="4"
                        ry="6"
                    />

                    <ellipse
                        class="persona-ojo"
                        cx="232"
                        cy="150"
                        rx="4"
                        ry="6"
                    />


                    <!-- cejas -->

                    <path
                        class="persona-ceja"
                        d="M178 137 Q188 132 198 137"
                    />

                    <path
                        class="persona-ceja"
                        d="M222 137 Q232 132 242 137"
                    />


                    <!-- nariz -->

                    <path
                        class="persona-nariz"
                        d="M210 150 L206 166 L214 166"
                    />


                    <!-- sonrisa -->

                    <path
                        class="persona-sonrisa"
                        d="M197 178 Q210 188 223 178"
                    />


                    <!-- cuerpo -->

                    <path
                        class="persona-camisa"
                        d="M161 220
                           C176 210 190 207 210 207
                           C230 207 245 211 259 220
                           C276 231 284 255 287 293
                           L133 293
                           C136 255 144 231 161 220 Z"
                    />


                    <!-- cuello camisa -->

                    <path
                        class="persona-cuello-camisa"
                        d="M188 211 L210 232 L232 211"
                    />


                    <!-- brazo izquierdo -->

                    <path
                        class="persona-camisa"
                        d="M160 228
                           C143 239 132 260 125 284
                           L153 293
                           L178 250 Z"
                    />


                    <!-- brazo derecho -->

                    <path
                        class="persona-camisa"
                        d="M260 228
                           C276 240 287 260 293 282
                           L267 294
                           L242 250 Z"
                    />


                    <!-- mano -->

                    <path
                        class="persona-piel mano"
                        d="M288 273
                           C297 267 307 272 309 281
                           C311 289 304 295 296 293
                           L285 288 Z"
                    />

                </g>


                <!-- lápiz -->

                <g class="dibujo-lapiz">

                    <rect
                        x="276"
                        y="246"
                        width="12"
                        height="61"
                        rx="5"
                        transform="rotate(22 276 246)"
                    />

                    <path
                        d="M299 302 L310 314 L295 310 Z"
                    />

                </g>


                <!-- pequeño check -->

                <g class="dibujo-check">

                    <circle
                        cx="327"
                        cy="264"
                        r="21"
                    />

                    <path
                        d="M316 264 L324 272 L340 254"
                    />

                </g>

            </svg>


            <div class="registro-ilustracion-texto">

                <strong>Crear tu cuenta</strong>

                <span>Un paso más para comenzar</span>

            </div>

        </div>


        <!-- =================================================
             CREAR CUENTA
             ================================================= -->

        <div class="registro-contenedor">

            <div class="registro-encabezado">

                <p class="registro-etiqueta">EDUTURNOS</p>

                <h1>Crear cuenta</h1>

                <p class="registro-descripcion">
                    Selecciona el tipo de cuenta que deseas crear
                    para continuar.
                </p>

            </div>


            <div class="registro-grid">

{% for slug, info in portales.items() %}

            <article class="registro-opcion">

                <div class="registro-opcion-contenido">

                    <h3>{{ info.label }}</h3>

                    <p>{{ info.descripcion }}</p>

                </div>

                <a
                    class="registro-boton"
                    href="{{ url_for('auth.registro_portal', portal=slug) }}"
                >
                    Crear cuenta
                </a>

            </article>

            {% endfor %}

            </div>


            <div class="registro-retorno">

                <a
                    href="{{ url_for('auth.login') }}"
                    class="link-back"
                >
                    <span aria-hidden="true">←</span>
                    <span>Volver al inicio de sesión</span>
                </a>

            </div>

        </div>

    </div>

</section>


<style id="EDUTURNOS_REGISTRO_UNICO_2026">

/* =========================================================
   FONDO ÚNICO
   ========================================================= */

.registro-pagina {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 28px 20px 40px;

    background: transparent !important;
}


/* =========================================================
   DOS COLUMNAS
   ========================================================= */

.registro-layout {
    width: 100%;

    display: grid;

    grid-template-columns: minmax(320px, .9fr) minmax(410px, 1fr);

    align-items: center;

    gap: 46px;
}


/* =========================================================
   ILUSTRACIÓN
   SIN CUADRO
   SIN FONDO
   ========================================================= */

.registro-ilustracion {
    position: relative;

    width: 100%;
    min-height: 460px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: transparent !important;

    border: 0 !important;
    border-radius: 0 !important;

    box-shadow: none !important;

    overflow: visible;
}


.registro-dibujo {
    width: min(100%, 420px);
    height: auto;

    overflow: visible;

    animation: dibujo-flotar 5s ease-in-out infinite;
}


/* =========================================================
   COLORES DEL DIBUJO
   ========================================================= */

.persona-piel {
    fill: #ffd9c2;

    stroke: #123b68;
    stroke-width: 4;

    stroke-linejoin: round;
}


.persona-cabello {
    fill: #123b68;

    stroke: #123b68;
    stroke-width: 4;

    stroke-linejoin: round;
}


.persona-ojo {
    fill: #123b68;
}


.persona-ceja {
    fill: none;

    stroke: #123b68;
    stroke-width: 4;

    stroke-linecap: round;
}


.persona-nariz {
    fill: none;

    stroke: #123b68;
    stroke-width: 3;

    stroke-linecap: round;
    stroke-linejoin: round;
}


.persona-sonrisa {
    fill: none;

    stroke: #123b68;
    stroke-width: 3;

    stroke-linecap: round;
}


.persona-camisa {
    fill: #2f78ff;

    stroke: #123b68;
    stroke-width: 4;

    stroke-linejoin: round;
}


.persona-cuello-camisa {
    fill: none;

    stroke: #123b68;
    stroke-width: 4;

    stroke-linecap: round;
    stroke-linejoin: round;
}


/* =========================================================
   DOCUMENTO
   ========================================================= */

.dibujo-documento rect {
    fill: #ffffff;

    stroke: #123b68;
    stroke-width: 4;
}


.dibujo-documento path {
    fill: #eaf3ff;

    stroke: #123b68;
    stroke-width: 4;
}


.dibujo-documento line {
    stroke: #9db7d3;
    stroke-width: 5;

    stroke-linecap: round;
}


.dibujo-documento circle {
    fill: #2f78ff;
}


/* =========================================================
   LÁPIZ
   ========================================================= */

.dibujo-lapiz rect {
    fill: #f4bd4f;

    stroke: #123b68;
    stroke-width: 3;
}


.dibujo-lapiz path {
    fill: #ffd9c2;

    stroke: #123b68;
    stroke-width: 3;
}


/* =========================================================
   CHECK
   ========================================================= */

.dibujo-check circle {
    fill: #ffffff;

    stroke: #2f78ff;
    stroke-width: 4;
}


.dibujo-check path {
    fill: none;

    stroke: #2f78ff;
    stroke-width: 5;

    stroke-linecap: round;
    stroke-linejoin: round;

    stroke-dasharray: 45;
    stroke-dashoffset: 45;

    animation: dibujo-check 2.8s ease-in-out infinite;
}


/* =========================================================
   DECORACIÓN
   ========================================================= */

.dibujo-punto {
    fill: #2f78ff;

    opacity: .35;

    animation: dibujo-punto 3s ease-in-out infinite;
}


.punto-2 {
    animation-delay: .5s;
}


.punto-3 {
    animation-delay: 1s;
}


.punto-4 {
    animation-delay: 1.5s;
}


.dibujo-estrella {
    fill: #f4bd4f;

    opacity: .75;

    animation: dibujo-estrella 3.5s ease-in-out infinite;
}


.estrella-2 {
    animation-delay: 1s;
}


.dibujo-trazo {
    fill: none;

    stroke: #2f78ff;
    stroke-width: 3;

    stroke-linecap: round;

    stroke-dasharray: 9 12;

    opacity: .35;
}


.dibujo-sombra {
    fill: rgba(18, 59, 104, .10);

    animation: dibujo-sombra 5s ease-in-out infinite;
}


/* =========================================================
   TEXTO DE LA ILUSTRACIÓN
   ========================================================= */

.registro-ilustracion-texto {
    position: absolute;

    bottom: 26px;

    left: 0;
    right: 0;

    display: flex;

    flex-direction: column;

    align-items: center;

    text-align: center;
}


.registro-ilustracion-texto strong {
    color: #123b68;

    font-family: "Source Serif 4", Georgia, serif;

    font-size: 22px;

    font-weight: 700;
}


.registro-ilustracion-texto span {
    margin-top: 3px;

    color: #6b8098;

    font-size: 12px;
}


/* =========================================================
   TARJETA DEL FORMULARIO
   ========================================================= */

.registro-contenedor {
    width: 100%;
    max-width: 540px;

    padding: 27px;

    background: #ffffff;

    border: 1px solid #dce7f4;

    border-radius: 17px;

    box-shadow:
        0 14px 34px rgba(18, 59, 104, .08);

    box-sizing: border-box;
}


/* =========================================================
   ENCABEZADO
   ========================================================= */

.registro-encabezado {
    margin-bottom: 18px;
}


.registro-etiqueta {
    margin: 0 0 3px;

    color: #2f78ff;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .14em;

    text-transform: uppercase;
}


.registro-encabezado h1 {
    margin: 0;

    color: #123b68;

    font-family: "Source Serif 4", Georgia, serif;

    font-size: 33px;

    line-height: 1.05;
}


.registro-descripcion {
    margin: 7px 0 0;

    color: #5f7895;

    font-size: 13px;

    line-height: 1.45;
}


/* =========================================================
   ROLES COMPACTOS
   ========================================================= */

.registro-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 8px;
}


.registro-opcion {
    min-height: 67px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 8px;

    padding: 9px 10px;

    background: #ffffff;

    border: 1px solid #e0e8f1;

    border-radius: 9px;

    box-sizing: border-box;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;
}


.registro-opcion:hover {
    transform: translateY(-1px);

    border-color: #bdd6f5;

    box-shadow:
        0 5px 13px rgba(18, 59, 104, .07);
}


.registro-opcion h3 {
    margin: 0 0 2px;

    color: #123b68;

    font-size: 12.5px;

    font-weight: 750;

    line-height: 1.15;
}


.registro-opcion p {
    margin: 0;

    color: #71859a;

    font-size: 9.5px;

    line-height: 1.25;
}


/* =========================================================
   BOTONES
   ========================================================= */

.registro-opcion .registro-boton {
    flex: 0 0 auto;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 29px;

    padding: 6px 9px;

    background: #2f78ff;

    color: #ffffff;

    border: 1px solid #2f78ff;

    border-radius: 7px;

    font-size: 9.5px;

    font-weight: 700;

    line-height: 1;

    text-decoration: none;

    box-shadow: 0 3px 7px rgba(47, 120, 255, .13);
}


.registro-opcion .registro-boton:hover {
    background: #2368eb;

    border-color: #2368eb;

    transform: translateY(-1px);
}


/* =========================================================
   VOLVER
   ========================================================= */

.registro-retorno {
    margin-top: 16px;

    padding: 0 !important;

    border: 0 !important;

    text-align: left;
}


.registro-retorno a {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 2px 0 !important;

    background: transparent !important;

    border: 0 !important;

    box-shadow: none !important;

    color: #2f78ff !important;

    font-size: 12px;

    font-weight: 700;

    text-decoration: none;
}


.registro-retorno a:hover {
    background: transparent !important;

    border: 0 !important;

    box-shadow: none !important;

    color: #123b68 !important;
}


/* =========================================================
   ANIMACIONES
   ========================================================= */

@keyframes dibujo-flotar {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }

}


@keyframes dibujo-sombra {

    0%, 100% {
        transform: scaleX(1);

        opacity: .45;
    }

    50% {
        transform: scaleX(.88);

        opacity: .25;
    }

}


@keyframes dibujo-check {

    0%, 25% {
        stroke-dashoffset: 45;
    }

    45%, 100% {
        stroke-dashoffset: 0;
    }

}


@keyframes dibujo-punto {

    0%, 100% {
        transform: translateY(0);

        opacity: .3;
    }

    50% {
        transform: translateY(-5px);

        opacity: .65;
    }

}


@keyframes dibujo-estrella {

    0%, 100% {
        transform: scale(1);

        opacity: .65;
    }

    50% {
        transform: scale(1.12);

        opacity: 1;
    }

}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 850px) {

    .registro-layout {
        grid-template-columns: 1fr;

        gap: 10px;
    }

    .registro-ilustracion {
        min-height: 330px;
    }

    .registro-dibujo {
        width: 330px;
    }

    .registro-ilustracion-texto {
        bottom: 10px;
    }

    .registro-contenedor {
        max-width: 600px;

        margin: 0 auto;
    }

}


@media (max-width: 540px) {

    .registro-pagina {
        padding: 15px 10px 25px;
    }

    .registro-ilustracion {
        min-height: 285px;
    }

    .registro-dibujo {
        width: 290px;
    }

    .registro-grid {
        grid-template-columns: 1fr;
    }

    .registro-contenedor {
        padding: 21px 16px;
    }

    .registro-encabezado h1 {
        font-size: 29px;
    }

}

</style>

{% endblock %}