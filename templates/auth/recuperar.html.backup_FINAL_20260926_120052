{% extends 'base.html' %}

{% block title %}Recuperar acceso - EDUTURNOS{% endblock %}

{% block content %}

<style>
/* =========================================================
   EDUTURNOS - RECUPERAR ACCESO
   Diseño exclusivo de esta página
   ========================================================= */

html body.eduturnos-recuperar-page {
    background: #f4f7fa !important;
}

html body.eduturnos-recuperar-page .contenedor {
    background: #f4f7fa !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar {
    width: 100% !important;
    min-height: calc(100vh - 76px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 42px 28px !important;
    box-sizing: border-box !important;
    background: #f4f7fa !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__layout {
    width: 100% !important;
    max-width: 900px !important;
    min-height: 430px !important;
    display: grid !important;
    grid-template-columns: 1fr 430px !important;
    align-items: center !important;
    gap: 42px !important;
}

/* ---------- ILUSTRACIÓN ---------- */

html body.eduturnos-recuperar-page .eduturnos-recuperar__illustration {
    position: relative !important;
    min-height: 380px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: visible !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__scene {
    position: relative !important;
    width: 330px !important;
    height: 330px !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__glow {
    position: absolute !important;
    width: 270px !important;
    height: 270px !important;
    left: 30px !important;
    top: 28px !important;
    border-radius: 50% !important;
    background: rgba(40,117,199,.09) !important;
    animation: recuperarGlow 4s ease-in-out infinite !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__envelope {
    position: absolute !important;
    left: 48px !important;
    top: 104px !important;
    width: 235px !important;
    height: 155px !important;
    background: #ffffff !important;
    border: 4px solid #2875c7 !important;
    border-radius: 22px !important;
    box-shadow: 0 18px 38px rgba(23,55,88,.16) !important;
    transform: rotate(-3deg) !important;
    animation: recuperarFloat 4s ease-in-out infinite !important;
    z-index: 3 !important;
    box-sizing: border-box !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__envelope::before {
    content: "" !important;
    position: absolute !important;
    left: 15px !important;
    right: 15px !important;
    top: 12px !important;
    height: 105px !important;
    border-left: 4px solid #2875c7 !important;
    border-bottom: 4px solid #2875c7 !important;
    transform: rotate(-45deg) skew(8deg,8deg) !important;
    opacity: .85 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__envelope::after {
    content: "" !important;
    position: absolute !important;
    left: 15px !important;
    right: 15px !important;
    bottom: 13px !important;
    height: 75px !important;
    border-top: 4px solid #2875c7 !important;
    transform: rotate(0deg) !important;
    opacity: .28 !important;
}

/* ---------- CANDADO ---------- */

html body.eduturnos-recuperar-page .eduturnos-recuperar__lock {
    position: absolute !important;
    right: 22px !important;
    top: 54px !important;
    width: 94px !important;
    height: 112px !important;
    z-index: 5 !important;
    animation: recuperarLock 3.6s ease-in-out infinite !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__shackle {
    position: absolute !important;
    left: 23px !important;
    top: 0 !important;
    width: 48px !important;
    height: 58px !important;
    border: 9px solid #d99b2b !important;
    border-bottom: 0 !important;
    border-radius: 28px 28px 0 0 !important;
    box-sizing: border-box !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__lock-body {
    position: absolute !important;
    left: 7px !important;
    bottom: 0 !important;
    width: 80px !important;
    height: 70px !important;
    background: #d99b2b !important;
    border-radius: 15px !important;
    box-shadow: 0 10px 22px rgba(145,96,18,.22) !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__keyhole {
    position: absolute !important;
    left: 39px !important;
    bottom: 27px !important;
    width: 16px !important;
    height: 25px !important;
    background: #ffffff !important;
    border-radius: 10px 10px 7px 7px !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__keyhole::before {
    content: "" !important;
    position: absolute !important;
    left: 3px !important;
    top: -6px !important;
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
}

/* ---------- DETALLES ---------- */

html body.eduturnos-recuperar-page .eduturnos-recuperar__dot {
    position: absolute !important;
    border-radius: 50% !important;
    background: #d99b2b !important;
    opacity: .8 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__dot--one {
    width: 11px !important;
    height: 11px !important;
    left: 30px !important;
    top: 84px !important;
    animation: recuperarDot 3s ease-in-out infinite !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__dot--two {
    width: 8px !important;
    height: 8px !important;
    right: 5px !important;
    bottom: 76px !important;
    animation: recuperarDot 3.5s ease-in-out infinite .7s !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__dot--three {
    width: 13px !important;
    height: 13px !important;
    left: 80px !important;
    bottom: 35px !important;
    animation: recuperarDot 3.2s ease-in-out infinite 1.1s !important;
}

/* ---------- TARJETA ---------- */

html body.eduturnos-recuperar-page .eduturnos-recuperar__card {
    width: 100% !important;
    max-width: 430px !important;
    box-sizing: border-box !important;
    background: #ffffff !important;
    border: 1px solid #e4eaf0 !important;
    border-radius: 18px !important;
    padding: 30px 34px 27px !important;
    box-shadow: 0 16px 38px rgba(25,52,79,.10) !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__back {
    display: inline-flex !important;
    align-items: center !important;
    margin-bottom: 18px !important;
    color: #2875c7 !important;
    text-decoration: none !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__back:hover {
    color: #1d5d9e !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__header h1 {
    margin: 0 0 9px !important;
    color: #18324d !important;
    font-family: "Source Serif 4", Georgia, serif !important;
    font-size: 30px !important;
    line-height: 1.1 !important;
    font-weight: 600 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__header p {
    margin: 0 0 23px !important;
    color: #657487 !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 13px !important;
    line-height: 1.55 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__field {
    margin-bottom: 18px !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__field label {
    display: block !important;
    margin-bottom: 7px !important;
    color: #26394d !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__field input {
    width: 100% !important;
    height: 44px !important;
    box-sizing: border-box !important;
    padding: 0 13px !important;
    border: 1px solid #ccd6e0 !important;
    border-radius: 9px !important;
    background: #ffffff !important;
    color: #26394d !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 14px !important;
    outline: none !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__field input:focus {
    border-color: #2875c7 !important;
    box-shadow: 0 0 0 3px rgba(40,117,199,.10) !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__button {
    width: 100% !important;
    min-height: 44px !important;
    border: 0 !important;
    border-radius: 9px !important;
    background: #2875c7 !important;
    color: #ffffff !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    box-shadow: 0 7px 16px rgba(40,117,199,.20) !important;
    transition: transform .18s ease, box-shadow .18s ease !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__button:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 20px rgba(40,117,199,.25) !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__footer {
    margin-top: 17px !important;
    padding-top: 15px !important;
    border-top: 1px solid #edf0f3 !important;
    text-align: center !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__footer p {
    margin: 0 !important;
    color: #7b8794 !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 11.5px !important;
    line-height: 1.45 !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__messages {
    margin-bottom: 18px !important;
}

html body.eduturnos-recuperar-page .eduturnos-recuperar__message {
    padding: 10px 12px !important;
    border-radius: 8px !important;
    background: #f1f6fb !important;
    color: #285577 !important;
    font-family: "Public Sans", Arial, sans-serif !important;
    font-size: 12px !important;
}

/* ---------- ANIMACIONES ---------- */

@keyframes recuperarFloat {
    0%,100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-8px) rotate(-3deg); }
}

@keyframes recuperarLock {
    0%,100% { transform: translateY(0) rotate(3deg); }
    50% { transform: translateY(-10px) rotate(6deg); }
}

@keyframes recuperarGlow {
    0%,100% { transform: scale(1); opacity: .75; }
    50% { transform: scale(1.06); opacity: 1; }
}

@keyframes recuperarDot {
    0%,100% { transform: translateY(0); opacity: .55; }
    50% { transform: translateY(-10px); opacity: 1; }
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 760px) {
    html body.eduturnos-recuperar-page .eduturnos-recuperar {
        padding: 28px 18px !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__layout {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
        max-width: 500px !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__illustration {
        min-height: 250px !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__scene {
        transform: scale(.78) !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__card {
        max-width: 430px !important;
        margin: 0 auto !important;
    }
}

@media (max-width: 480px) {
    html body.eduturnos-recuperar-page .eduturnos-recuperar__illustration {
        min-height: 210px !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__scene {
        transform: scale(.62) !important;
    }

    html body.eduturnos-recuperar-page .eduturnos-recuperar__card {
        padding: 25px 22px 23px !important;
    }
}
</style>

<section class="eduturnos-recuperar">

    <div class="eduturnos-recuperar__layout">

        <div class="eduturnos-recuperar__illustration" aria-hidden="true">

            <div class="eduturnos-recuperar__scene">

                <div class="eduturnos-recuperar__glow"></div>

                <div class="eduturnos-recuperar__dot eduturnos-recuperar__dot--one"></div>
                <div class="eduturnos-recuperar__dot eduturnos-recuperar__dot--two"></div>
                <div class="eduturnos-recuperar__dot eduturnos-recuperar__dot--three"></div>

                <div class="eduturnos-recuperar__envelope"></div>

                <div class="eduturnos-recuperar__lock">
                    <div class="eduturnos-recuperar__shackle"></div>
                    <div class="eduturnos-recuperar__lock-body"></div>
                    <div class="eduturnos-recuperar__keyhole"></div>
                </div>

            </div>

        </div>

        <div class="eduturnos-recuperar__card">

            <a class="eduturnos-recuperar__back"
               href="{{ url_for('auth.login') }}">
                ← Volver al inicio de sesión
            </a>

            <div class="eduturnos-recuperar__header">
                <h1>Recuperar acceso</h1>
                <p>
                    Ingresa el correo asociado a tu cuenta y te enviaremos
                    un código de recuperación de 6 dígitos.
                </p>
            </div>

            {% with mensajes = get_flashed_messages(with_categories=true) %}
                {% if mensajes %}
                    <div class="eduturnos-recuperar__messages">
                        {% for categoria, mensaje in mensajes %}
                            <div class="eduturnos-recuperar__message">
                                {{ mensaje }}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endwith %}

            <form method="POST"
                  action="{{ url_for('passwords.recuperar') }}"
                  autocomplete="off">

                <input type="hidden"
                       name="csrf_token"
                       value="{{ csrf_token() }}">

                <div class="eduturnos-recuperar__field">

                    <label for="correo">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        value="{{ request.form.get('correo', '') }}"
                        placeholder="correo@ejemplo.com"
                        autocomplete="email"
                        required
                        autofocus>

                </div>

                <button type="submit"
                        class="eduturnos-recuperar__button">
                    Enviar código de recuperación
                </button>

            </form>

            <div class="eduturnos-recuperar__footer">
                <p>
                    Recibirás un código de 6 dígitos válido durante 10 minutos.
                </p>
            </div>

        </div>

    </div>

</section>

<script>
document.body.classList.add("eduturnos-recuperar-page");
</script>

{% endblock %}
