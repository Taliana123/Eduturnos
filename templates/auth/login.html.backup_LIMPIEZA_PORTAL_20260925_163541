<script id="EDUTURNOS_LOGIN_VISUAL_UNICO_JS">
(function () {

    function aplicarLoginVisual() {

        const page =
            document.querySelector(".login-page");

        if (!page) {
            return;
        }


        /* ============================================
           GRID
           ============================================ */

        const grid =
            page.querySelector(
                ".personal-fields-grid, .personal-login .form-grid"
            );

        if (grid) {

            grid.style.setProperty(
                "display",
                "grid",
                "important"
            );

            grid.style.setProperty(
                "grid-template-columns",
                "88px 185px 78px",
                "important"
            );

            grid.style.setProperty(
                "column-gap",
                "8px",
                "important"
            );

            grid.style.setProperty(
                "width",
                "367px",
                "important"
            );

            grid.style.setProperty(
                "max-width",
                "100%",
                "important"
            );

            grid.style.setProperty(
                "margin-left",
                "auto",
                "important"
            );

            grid.style.setProperty(
                "margin-right",
                "auto",
                "important"
            );

            grid.style.setProperty(
                "align-items",
                "end",
                "important"
            );
        }


        /* ============================================
           CODIGO
           ============================================ */

        const codigo =
            page.querySelector(
                'input[name="codigo_institucional"]'
            );

        if (codigo) {

            codigo.removeAttribute(
                "placeholder"
            );

            if (
                codigo.value === "123456"
            ) {

                codigo.value = "";
            }

            codigo.style.setProperty(
                "width",
                "88px",
                "important"
            );

            codigo.style.setProperty(
                "min-width",
                "88px",
                "important"
            );

            codigo.style.setProperty(
                "max-width",
                "88px",
                "important"
            );
        }


        /* ============================================
           SEDE
           ============================================ */

        const sede =
            page.querySelector(
                'select[name="sede_id"]'
            );

        if (sede) {

            sede.style.setProperty(
                "width",
                "185px",
                "important"
            );

            sede.style.setProperty(
                "min-width",
                "185px",
                "important"
            );

            sede.style.setProperty(
                "max-width",
                "185px",
                "important"
            );
        }


        /* ============================================
           JORNADA
           ============================================ */

        const jornada =
            page.querySelector(
                'select[name="jornada_id"]'
            );

        if (jornada) {

            jornada.style.setProperty(
                "width",
                "78px",
                "important"
            );

            jornada.style.setProperty(
                "min-width",
                "78px",
                "important"
            );

            jornada.style.setProperty(
                "max-width",
                "78px",
                "important"
            );
        }


        /* ============================================
           DIBUJO
           QUITAR FONDOS
           ============================================ */

        const svgs =
            page.querySelectorAll("svg");

        svgs.forEach(
            function (svg) {

                svg.style.setProperty(
                    "background",
                    "transparent",
                    "important"
                );

                svg.style.setProperty(
                    "background-color",
                    "transparent",
                    "important"
                );

                svg.style.setProperty(
                    "border",
                    "0",
                    "important"
                );

                svg.style.setProperty(
                    "box-shadow",
                    "none",
                    "important"
                );


                /*
                 * Quitar rectangulos grandes
                 * que funcionan como fondo.
                 */

                const box =
                    svg.getBoundingClientRect();

                svg.querySelectorAll(
                    "rect"
                ).forEach(
                    function (rect) {

                        const r =
                            rect.getBoundingClientRect();

                        const style =
                            getComputedStyle(rect);

                        const grande =
                            box.width > 0 &&
                            box.height > 0 &&
                            r.width >=
                                box.width * 0.75 &&
                            r.height >=
                                box.height * 0.75;

                        const fondoOscuro =
                            style.fill &&
                            (
                                style.fill.includes(
                                    "rgb(15"
                                ) ||
                                style.fill.includes(
                                    "rgb(17"
                                ) ||
                                style.fill.includes(
                                    "rgb(23"
                                ) ||
                                style.fill.includes(
                                    "rgb(30"
                                ) ||
                                style.fill.includes(
                                    "rgb(31"
                                ) ||
                                style.fill.includes(
                                    "rgb(37"
                                )
                            );

                        if (
                            grande &&
                            fondoOscuro
                        ) {

                            rect.style.setProperty(
                                "fill",
                                "transparent",
                                "important"
                            );

                            rect.style.setProperty(
                                "fill-opacity",
                                "0",
                                "important"
                            );
                        }
                    }
                );


                /*
                 * Quitar líneas blancas verticales
                 * del dibujo.
                 */

                svg.querySelectorAll(
                    "line, path, polyline, rect"
                ).forEach(
                    function (element) {

                        const style =
                            getComputedStyle(
                                element
                            );

                        const stroke =
                            (
                                style.stroke || ""
                            ).toLowerCase();

                        const fill =
                            (
                                style.fill || ""
                            ).toLowerCase();

                        const r =
                            element.getBoundingClientRect();

                        const esBlanco =
                            stroke.includes(
                                "255, 255, 255"
                            ) ||
                            stroke ===
                                "white" ||
                            stroke ===
                                "#fff" ||
                            stroke ===
                                "#ffffff";

                        const esVertical =
                            r.height >
                            r.width * 3;

                        if (
                            esBlanco &&
                            esVertical
                        ) {

                            element.style.setProperty(
                                "stroke",
                                "transparent",
                                "important"
                            );

                            element.style.setProperty(
                                "stroke-opacity",
                                "0",
                                "important"
                            );

                            element.style.setProperty(
                                "fill",
                                "transparent",
                                "important"
                            );
                        }
                    }
                );
            }
        );


        /*
         * Quitar bordes blancos verticales
         * en el contenedor inmediato del dibujo.
         */

        const dibujos =
            page.querySelectorAll(
                "svg"
            );

        dibujos.forEach(
            function (svg) {

                let padre =
                    svg.parentElement;

                let nivel = 0;

                while (
                    padre &&
                    nivel < 3
                ) {

                    const cs =
                        getComputedStyle(
                            padre
                        );

                    const borderLeft =
                        (
                            cs.borderLeftColor || ""
                        ).toLowerCase();

                    const borderRight =
                        (
                            cs.borderRightColor || ""
                        ).toLowerCase();

                    if (
                        borderLeft.includes(
                            "255, 255, 255"
                        )
                    ) {

                        padre.style.setProperty(
                            "border-left",
                            "0",
                            "important"
                        );
                    }

                    if (
                        borderRight.includes(
                            "255, 255, 255"
                        )
                    ) {

                        padre.style.setProperty(
                            "border-right",
                            "0",
                            "important"
                        );
                    }

                    padre.style.setProperty(
                        "background-color",
                        "transparent",
                        "important"
                    );

                    nivel++;
                    padre =
                        padre.parentElement;
                }
            }
        );
    }


    document.addEventListener(
        "DOMContentLoaded",
        aplicarLoginVisual
    );

    window.addEventListener(
        "load",
        aplicarLoginVisual
    );

    setTimeout(
        aplicarLoginVisual,
        100
    );

    setTimeout(
        aplicarLoginVisual,
        300
    );

    setTimeout(
        aplicarLoginVisual,
        700
    );

    setTimeout(
        aplicarLoginVisual,
        1200
    );

})();
</script>

