<script id="EDUTURNOS_LOGIN_DIBUJO_TRANSPARENTE_FINAL">
(function () {

    function azul(v) {

        if (!v) return false;

        v = v
            .toLowerCase()
            .replace(/\s/g, "");

        return (
            v === "#2563eb" ||
            v === "#1d4ed8" ||
            v === "#1e40af" ||
            v === "#1e3a8a" ||
            v === "#172554" ||
            v === "#0f172a" ||
            v.includes("rgb(37,99,235)") ||
            v.includes("rgb(29,78,216)") ||
            v.includes("rgb(30,64,175)")
        );
    }


    function limpiar() {

        const page =
            document.querySelector(
                ".login-page"
            );

        if (!page) return;


        page.querySelectorAll(
            "svg"
        ).forEach(
            function (svg) {

                svg.style.setProperty(
                    "background",
                    "transparent",
                    "important"
                );

                svg.style.setProperty(
                    "background-color",
                    "transparent",
                    "important"
                );


                const svgBox =
                    svg.getBoundingClientRect();


                svg.querySelectorAll(
                    "rect"
                ).forEach(
                    function (rect) {

                        const r =
                            rect.getBoundingClientRect();

                        const s =
                            getComputedStyle(
                                rect
                            );


                        const cubreTodo =
                            svgBox.width > 0 &&
                            svgBox.height > 0 &&
                            r.width >=
                                svgBox.width * 0.80 &&
                            r.height >=
                                svgBox.height * 0.80;


                        if (
                            cubreTodo &&
                            (
                                azul(s.fill) ||
                                azul(s.backgroundColor)
                            )
                        ) {

                            rect.style.setProperty(
                                "fill",
                                "transparent",
                                "important"
                            );

                            rect.style.setProperty(
                                "fill-opacity",
                                "0",
                                "important"
                            );

                        }

                    }
                );

            }
        );
    }


    function campos() {

        const page =
            document.querySelector(
                ".login-page"
            );

        if (!page) return;


        const grid =
            page.querySelector(
                ".personal-fields-grid, .personal-login .form-grid"
            );

        if (grid) {

            grid.style.setProperty(
                "display",
                "grid",
                "important"
            );

            grid.style.setProperty(
                "grid-template-columns",
                "94px 210px 82px",
                "important"
            );

            grid.style.setProperty(
                "column-gap",
                "8px",
                "important"
            );

            grid.style.setProperty(
                "width",
                "402px",
                "important"
            );

            grid.style.setProperty(
                "max-width",
                "100%",
                "important"
            );

            grid.style.setProperty(
                "margin-left",
                "auto",
                "important"
            );

            grid.style.setProperty(
                "margin-right",
                "auto",
                "important"
            );

            grid.style.setProperty(
                "align-items",
                "end",
                "important"
            );

            grid.style.setProperty(
                "justify-content",
                "center",
                "important"
            );
        }


        const codigo =
            page.querySelector(
                'input[name="codigo_institucional"]'
            );

        if (codigo) {

            codigo.removeAttribute(
                "placeholder"
            );

            if (
                codigo.value === "123456"
            ) {

                codigo.value = "";
            }

            codigo.style.setProperty(
                "width",
                "94px",
                "important"
            );

            codigo.style.setProperty(
                "min-width",
                "94px",
                "important"
            );

            codigo.style.setProperty(
                "max-width",
                "94px",
                "important"
            );
        }


        const sede =
            page.querySelector(
                'select[name="sede_id"]'
            );

        if (sede) {

            sede.style.setProperty(
                "width",
                "210px",
                "important"
            );

            sede.style.setProperty(
                "min-width",
                "210px",
                "important"
            );

            sede.style.setProperty(
                "max-width",
                "210px",
                "important"
            );
        }


        const jornada =
            page.querySelector(
                'select[name="jornada_id"]'
            );

        if (jornada) {

            jornada.style.setProperty(
                "width",
                "82px",
                "important"
            );

            jornada.style.setProperty(
                "min-width",
                "82px",
                "important"
            );

            jornada.style.setProperty(
                "max-width",
                "82px",
                "important"
            );
        }


        limpiar();
    }


    document.addEventListener(
        "DOMContentLoaded",
        campos
    );

    window.addEventListener(
        "load",
        campos
    );

    setTimeout(
        campos,
        100
    );

    setTimeout(
        campos,
        300
    );

    setTimeout(
        campos,
        700
    );

    setTimeout(
        campos,
        1200
    );

})();
</script>

