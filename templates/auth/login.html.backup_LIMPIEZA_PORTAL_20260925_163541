            </svg>

                </div>

            </section>


            <!-- =================================================
                 LOGIN
                 ================================================= -->

            <section class="login-card">


                <div class="section-heading">

                    <span class="badge">
                        Acceso seguro
                    </span>

                    <h1>
                        Iniciar sesión
                    </h1>

                    <p>
                        El sistema determina tu rol desde la información institucional.
                        No debes escogerlo.
                    </p>

                </div>


                <!-- Mensajes Flask -->

                {% with mensajes = get_flashed_messages(with_categories=true) %}

                    {% if mensajes %}

                        {% for categoria, mensaje in mensajes %}

                            <div
                                class="login-message {% if categoria in ['error','danger'] %}error{% else %}success{% endif %}"
                            >
                                {{ mensaje }}
                            </div>

                        {% endfor %}

                    {% endif %}

                {% endwith %}


                <form
                    method="post"
                    autocomplete="off"
                    class="stack-form"
                >

                    {{ csrf_field()|safe }}


                    <!-- Documento -->

                    <label>

                        Documento o correo

                        <input
                            type="text"
                            name="identificador"
                            autocomplete="username"
                            placeholder="Documento o correo"
                        >

                    </label>


                    <!-- Contraseña -->

                    <label>

                        Contraseña

                        <input
                            type="password"
                            name="password"
                            autocomplete="current-password"
                            placeholder="Contraseña"
                        >

                    </label>


                    <!-- Personal institucional -->

                    <div class="personal-login">

                        <h3>
                            Personal institucional
                        </h3>

                        <p>
                            Docentes, Coordinadores y Rectoría deben usar su correo
