{% extends "base.html" %}

{% block title %}
Registro - EDUTURNOS
{% endblock %}

{% block content %}

<div class="container" style="max-width: 1000px; margin: 30px auto;">

    <div class="card" style="padding: 30px;">

        <div style="margin-bottom: 25px;">

            <h1>Crear cuenta</h1>

            {% if info %}
                <p>{{ info.descripcion }}</p>
            {% endif %}

            {% if portal == "estudiante" %}

                <p>Registro de estudiante</p>

            {% elif portal == "acudiente" %}

                <p>Registro de padre, madre o acudiente</p>

            {% elif portal == "docente" %}

                <p>Registro de docente</p>

            {% elif portal == "coordinador" %}

                <p>Registro de coordinador</p>

            {% elif portal == "rector" %}

                <p>Registro de rector</p>

            {% endif %}

        </div>


        <!-- ================================================= -->
        <!-- MENSAJES -->
        <!-- ================================================= -->

        {% with mensajes = get_flashed_messages(with_categories=true) %}

            {% if mensajes %}

                <div style="margin-bottom: 20px;">

                    {% for categoria, mensaje in mensajes %}

                        <div class="alert alert-{{ categoria }}">
                            {{ mensaje }}
                        </div>

                    {% endfor %}

                </div>

            {% endif %}

        {% endwith %}


        <form method="POST" action="{{ request.path }}">

            <input
                type="hidden"
                name="csrf_token"
                value="{{ csrf_token() }}"
            >


            <!-- ================================================= -->
            <!-- ESTUDIANTE -->
            <!-- ================================================= -->

            {% if portal == "estudiante" %}

                <h2>Datos del estudiante</h2>


                <div class="form-group">

                    <label for="tipo_documento">
                        Tipo de documento
                    </label>

                    <select
                        name="tipo_documento"
                        id="tipo_documento"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="TI">
                            Tarjeta de identidad
                        </option>

                        <option value="CC">
                            Cédula de ciudadanía
                        </option>

                        <option value="RC">
                            Registro civil
                        </option>

                        <option value="CE">
                            Cédula de extranjería
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="documento">
                        Número de documento
                    </label>

                    <input
                        type="text"
                        name="documento"
                        id="documento"
                        required
                        autocomplete="off"
                    >

                </div>


                <div class="form-group">

                    <label for="nombres">
                        Nombres
                    </label>

                    <input
                        type="text"
                        name="nombres"
                        id="nombres"
                        required
                        autocomplete="given-name"
                    >

                </div>


                <div class="form-group">

                    <label for="apellidos">
                        Apellidos
                    </label>

                    <input
                        type="text"
                        name="apellidos"
                        id="apellidos"
                        required
                        autocomplete="family-name"
                    >

                </div>


                <div class="form-group">

                    <label for="correo">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        name="correo"
                        id="correo"
                        required
                        autocomplete="email"
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    >

                </div>


                <div class="form-group">

                    <label for="telefono">
                        Teléfono
                    </label>

                    <input
                        type="text"
                        name="telefono"
                        id="telefono"
                        autocomplete="tel"
                    >

                </div>


                <div class="form-group">

                    <label for="id_sede">
                        Sede
                    </label>

                    <select
                        name="id_sede"
                        id="id_sede"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for sede in sedes %}

                            <option value="{{ sede.id }}">

                                {{ sede.nombre }}

                                {% if sede.codigo %}
                                    - {{ sede.codigo }}
                                {% endif %}

                            </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="id_jornada">
                        Jornada
                    </label>

                    <select
                        name="id_jornada"
                        id="id_jornada"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for jornada in jornadas %}

                            <option value="{{ jornada.id }}">
                                {{ jornada.nombre }}
                            </option>

                        {% endfor %}

                    </select>

                </div>


                <!-- ================================================= -->
                <!-- GRADO -->
                <!-- ================================================= -->

                <div class="form-group">

                    <label for="id_grado">
                        Grado
                    </label>

                    <select
                        name="id_grado"
                        id="id_grado"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for grado in grados %}

                            {% if grado.nombre|string in ["6", "7", "8", "9", "10", "11"] %}

                                <option value="{{ grado.id }}">
                                    {{ grado.nombre }}
                                </option>

                            {% endif %}

                        {% endfor %}

                    </select>

                </div>


                <!-- ================================================= -->
                <!-- GRUPO -->
                <!-- ================================================= -->

                <div class="form-group">

                    <label for="id_grupo">
                        Grupo
                    </label>

                    <select
                        name="id_grupo"
                        id="id_grupo"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>

                    </select>

                </div>


            <!-- ================================================= -->
            <!-- ACUDIENTE -->
            <!-- ================================================= -->

            {% elif portal == "acudiente" %}

                <h2>Datos del acudiente</h2>


                <div class="form-group">

                    <label for="tipo_documento">
                        Tipo de documento
                    </label>

                    <select
                        name="tipo_documento"
                        id="tipo_documento"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="CC">
                            Cédula de ciudadanía
                        </option>

                        <option value="CE">
                            Cédula de extranjería
                        </option>

                        <option value="TI">
                            Tarjeta de identidad
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="documento">
                        Número de documento
                    </label>

                    <input
                        type="text"
                        name="documento"
                        id="documento"
                        required
                        autocomplete="off"
                    >

                </div>


                <div class="form-group">

                    <label for="nombres">
                        Nombres
                    </label>

                    <input
                        type="text"
                        name="nombres"
                        id="nombres"
                        required
                        autocomplete="given-name"
                    >

                </div>


                <div class="form-group">

                    <label for="apellidos">
                        Apellidos
                    </label>

                    <input
                        type="text"
                        name="apellidos"
                        id="apellidos"
                        required
                        autocomplete="family-name"
                    >

                </div>


                <div class="form-group">

                    <label for="correo">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        name="correo"
                        id="correo"
                        required
                        autocomplete="email"
                    >

                </div>


                <div class="form-group">

                    <label for="telefono">
                        Teléfono
                    </label>

                    <input
                        type="text"
                        name="telefono"
                        id="telefono"
                        autocomplete="tel"
                    >

                </div>


                <hr>

                <h2>Datos del estudiante</h2>


                <div class="form-group">

                    <label for="estudiante_tipo_documento">
                        Tipo de documento del estudiante
                    </label>

                    <select
                        name="estudiante_tipo_documento"
                        id="estudiante_tipo_documento"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="TI">
                            Tarjeta de identidad
                        </option>

                        <option value="CC">
                            Cédula de ciudadanía
                        </option>

                        <option value="RC">
                            Registro civil
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="estudiante_documento">
                        Documento del estudiante
                    </label>

                    <input
                        type="text"
                        name="estudiante_documento"
                        id="estudiante_documento"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="estudiante_nombres">
                        Nombres del estudiante
                    </label>

                    <input
                        type="text"
                        name="estudiante_nombres"
                        id="estudiante_nombres"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="estudiante_apellidos">
                        Apellidos del estudiante
                    </label>

                    <input
                        type="text"
                        name="estudiante_apellidos"
                        id="estudiante_apellidos"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="id_sede">
                        Sede
                    </label>

                    <select
                        name="id_sede"
                        id="id_sede"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for sede in sedes %}

                            <option value="{{ sede.id }}">

                                {{ sede.nombre }}

                                {% if sede.codigo %}
                                    - {{ sede.codigo }}
                                {% endif %}

                            </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="id_jornada">
                        Jornada
                    </label>

                    <select
                        name="id_jornada"
                        id="id_jornada"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for jornada in jornadas %}

                            <option value="{{ jornada.id }}">
                                {{ jornada.nombre }}
                            </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="id_grado">
                        Grado del estudiante
                    </label>

                    <select
                        name="id_grado"
                        id="id_grado"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for grado in grados %}

                            {% if grado.nombre|string in ["6", "7", "8", "9", "10", "11"] %}

                                <option value="{{ grado.id }}">
                                    {{ grado.nombre }}
                                </option>

                            {% endif %}

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="id_grupo">
                        Grupo
                    </label>

                    <select
                        name="id_grupo"
                        id="id_grupo"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="parentesco">
                        Parentesco
                    </label>

                    <input
                        type="text"
                        name="parentesco"
                        id="parentesco"
                        placeholder="Ejemplo: Padre, Madre, Tío"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    >

                </div>


            <!-- ================================================= -->
            <!-- DOCENTE / COORDINADOR / RECTOR -->
            <!-- ================================================= -->

            {% else %}

                <h2>Datos institucionales</h2>


                <div class="form-group">

                    <label for="tipo_documento">
                        Tipo de documento
                    </label>

                    <select
                        name="tipo_documento"
                        id="tipo_documento"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        <option value="CC">
                            Cédula de ciudadanía
                        </option>

                        <option value="CE">
                            Cédula de extranjería
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="documento">
                        Número de documento
                    </label>

                    <input
                        type="text"
                        name="documento"
                        id="documento"
                        required
                        autocomplete="off"
                    >

                </div>


                <div class="form-group">

                    <label for="nombres">
                        Nombres
                    </label>

                    <input
                        type="text"
                        name="nombres"
                        id="nombres"
                        required
                        autocomplete="given-name"
                    >

                </div>


                <div class="form-group">

                    <label for="apellidos">
                        Apellidos
                    </label>

                    <input
                        type="text"
                        name="apellidos"
                        id="apellidos"
                        required
                        autocomplete="family-name"
                    >

                </div>


                <div class="form-group">

                    <label for="correo">
                        Correo institucional
                    </label>

                    <input
                        type="email"
                        name="correo"
                        id="correo"
                        placeholder="usuario@jjfh.edu.co"
                        required
                        autocomplete="email"
                    >

                </div>


                <div class="form-group">

                    <label for="telefono">
                        Teléfono
                    </label>

                    <input
                        type="text"
                        name="telefono"
                        id="telefono"
                        autocomplete="tel"
                    >

                </div>


                <div class="form-group">

                    <label for="id_sede">
                        Sede
                    </label>

                    <select
                        name="id_sede"
                        id="id_sede"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for sede in sedes %}

                            <option value="{{ sede.id }}">

                                {{ sede.nombre }}

                                {% if sede.codigo %}
                                    - {{ sede.codigo }}
                                {% endif %}

                            </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="id_jornada">
                        Jornada
                    </label>

                    <select
                        name="id_jornada"
                        id="id_jornada"
                        required
                    >
<option value="" selected disabled hidden></option>


                        

                        {% for jornada in jornadas %}

                            <option value="{{ jornada.id }}">
                                {{ jornada.nombre }}
                            </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="codigo_institucional">
                        Código institucional
                    </label>

                    <input
                        type="text"
                        name="codigo_institucional"
                        id="codigo_institucional"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        minlength="6"
                        required
                        autocomplete="off"
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        required
                        minlength="8"
                        autocomplete="new-password"
                    >

                </div>

            {% endif %}


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div style="margin-top: 30px;">

                <button type="submit">
                    Crear cuenta
                </button>

                <a
                    href="{{ url_for('auth.login') }}"
                    style="margin-left: 15px;"
                >
                    Volver al inicio de sesión
                </a>

            </div>

        </form>

    </div>

</div>



<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
