input[type="button"]:disabled,
input[type="reset"]:disabled {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    opacity: .55 !important;
}

</style>


<script id="EDUTURNOS_BOTONES_JS_V9">
(function() {
    "use strict";

    const AZUL = "#1769aa";
    const HOVER = "#145b91";
    const BLANCO = "#ffffff";

    const SELECTORES = [
        "button",
        "input[type='submit']",
        "input[type='button']",
        "input[type='reset']",

        "a.boton",
        "a.btn",
        "a.btn-primary",
        "a.btn-secondary",
        "a.btn-success",
        "a.btn-danger",
        "a.btn-warning",
        "a.btn-info",
        "a.btn-dark",
        "a.btn-light",

        "a[role='button']",

        "a.link-back",
        "a.edc-back",

        ".edc-buttons button",
        ".edc-buttons a.boton",

        ".edc-header-actions button",
        ".edc-header-actions a.boton",

        ".edc-month-toolbar button",
        ".edc-month-toolbar a.boton",

        ".citas-actions button",
        ".citas-actions a.boton",

        ".form-actions button",
        ".form-actions a.boton",

        ".acciones button",
        ".acciones a.boton",

        ".page-actions button",
        ".page-actions a.boton",

        ".dashboard-actions button",
        ".dashboard-actions a.boton",

        ".quick-card button",
        ".quick-card a.boton",

        ".account-actions button",
        ".account-actions a.boton"
    ].join(",");


    function aplicar(elemento) {
        if (!elemento) return;

        elemento.style.setProperty(
            "background",
            AZUL,
            "important"
        );

        elemento.style.setProperty(
            "background-color",
            AZUL,
            "important"
        );

        elemento.style.setProperty(
            "color",
            BLANCO,
            "important"
        );

        elemento.style.setProperty(
            "border-color",
            AZUL,
            "important"
        );

        elemento.style.setProperty(
            "box-shadow",
            "none",
            "important"
        );

        elemento.querySelectorAll("*").forEach(function(hijo) {
            hijo.style.setProperty(
                "color",
                BLANCO,
                "important"
            );
        });

        if (!elemento.dataset.eduturnosV9) {
            elemento.dataset.eduturnosV9 = "1";

            elemento.addEventListener(
                "mouseenter",
                function() {
                    elemento.style.setProperty(
                        "background",
                        HOVER,
                        "important"
                    );

                    elemento.style.setProperty(
                        "background-color",
                        HOVER,
                        "important"
                    );

                    elemento.style.setProperty(
                        "border-color",
                        HOVER,
                        "important"
                    );

                    elemento.style.setProperty(
                        "color",
                        BLANCO,
                        "important"
                    );
                }
            );

            elemento.addEventListener(
                "mouseleave",
                function() {
                    elemento.style.setProperty(
                        "background",
                        AZUL,
                        "important"
                    );

                    elemento.style.setProperty(
                        "background-color",
                        AZUL,
                        "important"
                    );

                    elemento.style.setProperty(
                        "border-color",
                        AZUL,
                        "important"
                    );

                    elemento.style.setProperty(
                        "color",
                        BLANCO,
                        "important"
                    );
                }
            );
        }
    }


    function ejecutar() {
        document
            .querySelectorAll(SELECTORES)
            .forEach(aplicar);
    }


    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            ejecutar
        );
    } else {
        ejecutar();
    }


    const observador = new MutationObserver(
        function() {
            ejecutar();
        }
    );


    if (document.documentElement) {
        observador.observe(
            document.documentElement,
            {
                childList: true,
                subtree: true
            }
        );
    }

})();
</script>

