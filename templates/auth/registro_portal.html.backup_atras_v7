<script id="EDUTURNOS_BOTONES_REALES_V6">
(function() {
    "use strict";

    const azul = "#1769aa";
    const hover = "#145b91";
    const blanco = "#ffffff";

    const selectores = [
        "button",
        "input[type='submit']",
        "input[type='button']",
        "input[type='reset']",

        "a.boton",
        "a.btn",
        "a[class*='boton']",
        "a[class*='button']",
        "a[class*='btn-']",
        "a[class*='accion']",
        "a[class*='action']",
        "a[role='button']",

        "a.link-back",
        "a.edc-back",

        ".edc-header-actions a",
        ".edc-header-actions button",

        ".edc-buttons a",
        ".edc-buttons button",

        ".edc-month-toolbar a",
        ".edc-month-toolbar button",

        ".citas-actions a",
        ".citas-actions button",

        ".form-actions a",
        ".form-actions button",

        ".acciones a",
        ".acciones button",

        ".page-actions a",
        ".page-actions button",

        ".dashboard-actions a",
        ".dashboard-actions button",

        ".account-actions a",
        ".account-actions button",

        ".quick-card a.boton",
        ".quick-card button",

        ".dashboard-card a.boton",
        ".dashboard-card button"
    ].join(",");


    function aplicar(elemento) {
        if (!elemento) return;

        elemento.style.setProperty(
            "background",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "background-color",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "color",
            blanco,
            "important"
        );

        elemento.style.setProperty(
            "border-color",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "text-decoration",
            "none",
            "important"
        );

        elemento.style.setProperty(
            "box-shadow",
            "none",
            "important"
        );

        elemento.style.setProperty(
            "opacity",
            "1",
            "important"
        );

        elemento.querySelectorAll("*").forEach(function(hijo) {
            hijo.style.setProperty(
                "color",
                blanco,
                "important"
            );
        });

        if (!elemento.dataset.eduturnosBotonV6) {
            elemento.dataset.eduturnosBotonV6 = "1";

            elemento.addEventListener("mouseenter", function() {
                elemento.style.setProperty(
                    "background",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "background-color",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "border-color",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "color",
                    blanco,
                    "important"
                );
            });

            elemento.addEventListener("mouseleave", function() {
                elemento.style.setProperty(
                    "background",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "background-color",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "border-color",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "color",
                    blanco,
                    "important"
                );
            });
        }
    }


    function buscarBotonesPorTexto() {
        document.querySelectorAll("a").forEach(function(a) {
            const texto = (a.textContent || "")
                .trim()
                .toLowerCase();

            const href = (a.getAttribute("href") || "")
                .toLowerCase();

            const palabras = [
                "atrás",
                "atras",
                "nueva citación",
                "nueva cita",
                "ver citas",
                "filtrar",
                "limpiar",
                "editar",
                "eliminar",
                "confirmar",
                "cancelar",
                "reprogramar",
                "descargar",
                "exportar",
                "importar",
                "guardar",
                "enviar",
                "volver",
                "marcar",
                "crear",
                "solicitar"
            ];

            const coincideTexto = palabras.some(function(p) {
                return texto === p || texto.includes(p);
            });

            const coincideRuta =
                href.includes("/citas/") ||
                href.includes("/calendario") ||
                href.includes("/notificaciones/") ||
                href.includes("/solicitudes/") ||
                href.includes("/reportes/") ||
                href.includes("/usuarios/") ||
                href.includes("/auth/recuperar");

            const contenedor = a.closest(
                ".edc-header-actions," +
                ".edc-buttons," +
                ".edc-month-toolbar," +
                ".citas-actions," +
                ".form-actions," +
                ".acciones," +
                ".page-actions," +
                ".dashboard-actions," +
                ".dashboard-card," +
                ".quick-card," +
                ".account-actions"
            );

            if (coincideTexto || coincideRuta || contenedor) {
                aplicar(a);
            }
        });
    }


    function ejecutar() {
        document.querySelectorAll(selectores).forEach(aplicar);
        buscarBotonesPorTexto();
    }


    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ejecutar);
    } else {
        ejecutar();
    }


    const observador = new MutationObserver(function() {
        ejecutar();
    });

    observador.observe(document.documentElement, {
        childList: true,
        subtree: true
    });

})();
</script>

