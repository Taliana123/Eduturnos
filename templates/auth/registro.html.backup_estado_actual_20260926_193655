        </div>


        <!-- =================================================
             CONTENIDO DE REGISTRO
             ================================================= -->

        <div class="registro-contenedor">

            <div class="registro-encabezado">

                <p class="registro-etiqueta">EDUTURNOS</p>

                <h1>Crear cuenta</h1>

                <p class="registro-descripcion">
                    Selecciona el tipo de cuenta que deseas crear
                    para continuar.
                </p>

            </div>


            <div class="registro-grid">

{% for slug, info in portales.items() %}

            <article class="registro-opcion">

                <div class="registro-opcion-contenido">

                    <h3>{{ info.label }}</h3>

                    <p>{{ info.descripcion }}</p>

                </div>

                <a
                    class="registro-boton"
                    href="{{ url_for('auth.registro_portal', portal=slug) }}"
                >
                    Crear cuenta
                </a>

            </article>

            {% endfor %}

            </div>


            <div class="registro-retorno">

                <a
                    href="{{ url_for('auth.login') }}"
                    class="link-back"
                >
                    <span aria-hidden="true">←</span>
                    <span>Volver al inicio de sesión</span>
                </a>

            </div>

        </div>

    </div>

</section>




{% endblock %}

<!-- EDUTURNOS_REGISTRO_ESTILO_UNICO_FINAL_20260926 -->
<style id="EDUTURNOS_REGISTRO_ESTILO_UNICO_FINAL_20260926">

/* =========================================================
   FONDO ÚNICO
   ========================================================= */

html,
body {
    background: #f4f7fb !important;
    background-color: #f4f7fb !important;
}

#contenido,
#contenido main,
#contenido main.contenedor,
#contenido .contenedor,
#contenido main.container,
#contenido .container,
.registro-pagina {
    background: #f4f7fb !important;
    background-color: #f4f7fb !important;
    background-image: none !important;
}


/* =========================================================
   CONTENEDOR PRINCIPAL
   ========================================================= */

.registro-contenedor {
    width: 100% !important;
    max-width: 630px !important;
    padding: 37px !important;

    background: #ffffff !important;

    border: 1px solid #dce7f4 !important;
    border-radius: 18px !important;

    box-shadow: 0 15px 38px rgba(18, 59, 104, .08) !important;

    box-sizing: border-box !important;
}


/* =========================================================
   ENCABEZADO
   ========================================================= */

.registro-encabezado {
    margin-bottom: 24px !important;
}


/* =========================================================
   ROLES
   TODOS DEL MISMO TAMAÑO
   ========================================================= */

.registro-grid {
    width: 100% !important;

    display: grid !important;

    grid-template-columns:
        repeat(2, minmax(0, 1fr)) !important;

    gap: 13px !important;

    align-items: stretch !important;
}


/* Cada tarjeta exactamente igual */

.registro-grid .registro-opcion {
    width: 100% !important;

    min-width: 0 !important;

    height: 94px !important;
    min-height: 94px !important;
    max-height: 94px !important;

    margin: 0 !important;

    padding: 14px 15px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;

    gap: 13px !important;

    box-sizing: border-box !important;

    background: #ffffff !important;

    border: 1px solid #dfe8f2 !important;
    border-radius: 11px !important;

    overflow: hidden !important;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease !important;
}


/* Hover */

.registro-grid .registro-opcion:hover {
    transform: translateY(-2px) !important;

    border-color: #bdd5f2 !important;

    box-shadow:
        0 8px 18px rgba(18, 59, 104, .09) !important;
}


/* Texto */

.registro-grid .registro-opcion h3 {
    margin: 0 0 4px !important;

    color: #123b68 !important;

    font-size: 14px !important;
    line-height: 1.2 !important;
    font-weight: 750 !important;
}


.registro-grid .registro-opcion p {
    margin: 0 !important;

    color: #71859a !important;

    font-size: 10.5px !important;
    line-height: 1.35 !important;
}


/* Botones */

.registro-grid .registro-boton {
    flex: 0 0 auto !important;
    flex-shrink: 0 !important;

    min-height: 35px !important;

    padding: 8px 12px !important;

    background: #2f78ff !important;
    color: #ffffff !important;

    border: 1px solid #2f78ff !important;
    border-radius: 8px !important;

    font-size: 10.5px !important;
    font-weight: 700 !important;

    line-height: 1 !important;

    text-decoration: none !important;

    box-shadow:
        0 4px 9px rgba(47, 120, 255, .13) !important;
}


/* =========================================================
   ILUSTRACIÓN
   SIN CUADRO DE FONDO
   ========================================================= */

.registro-ilustracion,
.registro-dibujo {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;

    border: 0 !important;
    box-shadow: none !important;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 760px) {

    .registro-contenedor {
        max-width: calc(100% - 20px) !important;
        padding: 28px 20px !important;
    }

    .registro-grid {
        grid-template-columns: 1fr !important;
    }

    .registro-grid .registro-opcion {
        height: 94px !important;
        min-height: 94px !important;
        max-height: 94px !important;
    }
}

</style>
<!-- FIN EDUTURNOS_REGISTRO_ESTILO_UNICO_FINAL_20260926 -->
