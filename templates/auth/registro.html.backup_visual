{% extends 'base.html' %}
{% block title %}Crear cuenta · EDUTURNOS{% endblock %}
{% block content %}
<section class="formulario ancho-medio">
  <div class="tarjeta form-card">
    <div class="section-heading"><span class="badge">Registro</span><h1>Crear cuenta</h1><p>Elige el tipo de registro. Esto no asigna el rol: el sistema lo valida contra la información institucional.</p></div>
    <div class="grid registro-grid equal-cards">
    {% for slug,info in portales.items() %}
      <article class="tarjeta option-card"><h3>{{ info.label }}</h3><p>{{ info.descripcion }}</p><a class="boton boton-full" href="{{ url_for('auth.registro_portal',portal=slug) }}">Registrarme</a></article>
    {% endfor %}
    </div>
    <div class="form-links single"><a href="{{ url_for('auth.login') }}">← Volver a iniciar sesión</a></div>
  </div>
</section>
{% endblock %}
