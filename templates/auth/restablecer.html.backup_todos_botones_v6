{% extends 'base.html' %}{% block title %}Nueva contraseña · EDUTURNOS{% endblock %}{% block content %}
<section class="formulario"><div class="tarjeta form-card">
  <div class="form-top-actions"><a class="link-back" href="{{ url_for('auth.login') }}">← Iniciar sesión</a></div>
  <div class="section-heading"><span class="badge">Seguridad de cuenta</span><h1>Nueva contraseña</h1><p>Crea una contraseña de mínimo 12 caracteres con mayúsculas, minúsculas y números.</p></div>
  <form method="post" class="stack-form form-uniform">{{ csrf_field()|safe }}
    <label>Contraseña nueva<input type="password" name="password_nueva" minlength="12" required autocomplete="new-password"></label>
    <label>Confirmar contraseña<input type="password" name="password_confirmacion" minlength="12" required autocomplete="new-password"></label>
    <button class="boton boton-full" type="submit">Guardar contraseña</button>
  </form>
</div></section>

<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
