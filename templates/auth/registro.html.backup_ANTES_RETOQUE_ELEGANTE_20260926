{% extends 'base.html' %}

{% block title %}Crear cuenta · EDUTURNOS{% endblock %}

{% block content %}

<section class="formulario ancho-medio registro-pagina">

    <div class="tarjeta form-card registro-contenedor">

        <div class="section-heading registro-encabezado">

            <span class="badge">Registro</span>

            <h1>Crear cuenta</h1>

            <p>
                Elige el tipo de registro. Esto no asigna el rol:
                el sistema lo valida contra la información institucional.
            </p>

        </div>

        <div class="registro-grid">

            {% for slug, info in portales.items() %}

            <article class="registro-opcion">

                <div class="registro-opcion-contenido">

                    <h3>{{ info.label }}</h3>

                    <p>{{ info.descripcion }}</p>

                </div>

                <a
                    class="registro-boton"
                    href="{{ url_for('auth.registro_portal', portal=slug) }}"
                >
                    Crear cuenta
                </a>

            </article>

            {% endfor %}

        </div>

        <div class="registro-volver">

            <a
                class="registro-boton registro-boton-volver"
                href="{{ url_for('auth.login') }}"
            >
                <span>←</span>
                <span>Volver a iniciar sesión</span>
            </a>

        </div>

    </div>

</section>


<style id="EDUTURNOS_REGISTRO_FINAL_2026">

.formulario.registro-pagina {
    min-height: calc(100vh - 80px) !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 30px 22px !important;
    box-sizing: border-box !important;
}


/* CONTENEDOR */

.registro-pagina .registro-contenedor {
    width: min(1080px, 100%) !important;
    max-width: 1080px !important;
    margin: 0 auto !important;
    padding: 34px !important;
    box-sizing: border-box !important;

    background: rgba(255, 255, 255, .97) !important;

    border: 1px solid rgba(147, 197, 253, .65) !important;
    border-radius: 24px !important;

    box-shadow:
        0 30px 70px rgba(30, 64, 175, .16),
        0 8px 25px rgba(15, 23, 42, .07) !important;
}


/* ENCABEZADO */

.registro-pagina .registro-encabezado {
    width: 100% !important;
    margin: 0 0 28px 0 !important;
    text-align: left !important;
}

.registro-pagina .registro-encabezado .badge {
    display: inline-flex !important;
    align-items: center !important;

    padding: 7px 12px !important;

    border-radius: 999px !important;

    background: #eff6ff !important;
    color: #1d4ed8 !important;

    border: 1px solid #bfdbfe !important;

    font-size: 12px !important;
    font-weight: 800 !important;
    letter-spacing: .04em !important;
    text-transform: uppercase !important;
}

.registro-pagina .registro-encabezado h1 {
    margin: 14px 0 9px 0 !important;

    color: #172554 !important;

    font-size: clamp(30px, 4vw, 40px) !important;
    line-height: 1.08 !important;
    letter-spacing: -.035em !important;
}

.registro-pagina .registro-encabezado p {
    max-width: 820px !important;
    margin: 0 !important;

    color: #64748b !important;

    line-height: 1.6 !important;
}


/* GRID */

.registro-pagina .registro-grid {
    display: grid !important;

    grid-template-columns:
        repeat(6, minmax(0, 1fr)) !important;

    gap: 18px !important;

    width: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    align-items: stretch !important;

    box-sizing: border-box !important;
}


/* TARJETAS */

.registro-pagina .registro-opcion {
    grid-column: span 2 !important;

    min-height: 190px !important;

    margin: 0 !important;
    padding: 22px !important;

    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;

    width: 100% !important;
    min-width: 0 !important;

    box-sizing: border-box !important;

    background: #f8fbff !important;

    border: 1px solid #dbeafe !important;
    border-radius: 18px !important;

    box-shadow:
        0 5px 16px rgba(30, 64, 175, .06) !important;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease !important;
}


/* CENTRAR LAS DOS ÚLTIMAS */

.registro-pagina .registro-opcion:nth-child(4) {
    grid-column: 2 / span 2 !important;
}

.registro-pagina .registro-opcion:nth-child(5) {
    grid-column: 4 / span 2 !important;
}


/* HOVER TARJETA */

.registro-pagina .registro-opcion:hover {
    transform: translateY(-3px) !important;

    border-color: #93c5fd !important;

    box-shadow:
        0 14px 28px rgba(30, 64, 175, .12) !important;
}


/* CONTENIDO */

.registro-opcion-contenido {
    flex: 1 !important;
    width: 100% !important;
    min-width: 0 !important;
}

.registro-pagina .registro-opcion h3 {
    min-height: 46px !important;

    width: 100% !important;

    margin: 0 0 10px 0 !important;
    padding: 0 !important;

    color: #172554 !important;

    font-size: 18px !important;
    font-weight: 700 !important;

    line-height: 1.25 !important;
}

.registro-pagina .registro-opcion p {
    min-height: 70px !important;

    width: 100% !important;

    margin: 0 !important;

    color: #64748b !important;

    font-size: 14px !important;
    line-height: 1.5 !important;
}


/* =========================================================
   BOTONES
   ========================================================= */

.registro-pagina .registro-boton {
    width: 100% !important;

    min-height: 46px !important;

    margin-top: 18px !important;
    padding: 10px 16px !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 8px !important;

    box-sizing: border-box !important;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #3b82f6
        ) !important;

    color: #ffffff !important;

    border: 1px solid rgba(37, 99, 235, .25) !important;

    border-radius: 12px !important;

    font-size: 14px !important;
    font-weight: 800 !important;

    line-height: 1 !important;

    text-align: center !important;

    text-decoration: none !important;

    box-shadow:
        0 9px 22px rgba(37, 99, 235, .18) !important;

    cursor: pointer !important;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        background .18s ease !important;
}


/* CREAR CUENTA */

.registro-pagina .registro-boton:hover {
    transform: translateY(-2px) !important;

    background:
        linear-gradient(
            135deg,
            #1d4ed8,
            #2563eb
        ) !important;

    color: #ffffff !important;

    text-decoration: none !important;

    box-shadow:
        0 13px 27px rgba(37, 99, 235, .25) !important;
}


/* =========================================================
   VOLVER A INICIAR SESIÓN
   MISMO BOTÓN AZUL
   ========================================================= */

.registro-pagina .registro-volver {
    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;

    margin-top: 28px !important;
    padding-top: 22px !important;

    border-top: 1px solid #e2e8f0 !important;
}


/* BOTÓN VOLVER */

.registro-pagina .registro-boton-volver {
    width: auto !important;

    min-width: 250px !important;

    margin-top: 0 !important;

    padding: 12px 24px !important;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #3b82f6
        ) !important;

    color: #ffffff !important;

    border: 1px solid rgba(37, 99, 235, .25) !important;

    border-radius: 12px !important;

    font-size: 14px !important;
    font-weight: 800 !important;

    text-decoration: none !important;

    box-shadow:
        0 9px 22px rgba(37, 99, 235, .18) !important;
}


.registro-pagina .registro-boton-volver:hover {
    background:
        linear-gradient(
            135deg,
            #1d4ed8,
            #2563eb
        ) !important;

    color: #ffffff !important;

    text-decoration: none !important;

    transform: translateY(-2px) !important;

    box-shadow:
        0 13px 27px rgba(37, 99, 235, .25) !important;
}


.registro-pagina .registro-boton-volver:active {
    transform: translateY(0) !important;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

    .formulario.registro-pagina {
        padding: 28px 18px !important;
    }

    .registro-pagina .registro-contenedor {
        padding: 28px !important;
    }

    .registro-pagina .registro-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;

        gap: 16px !important;
    }

    .registro-pagina .registro-opcion,
    .registro-pagina .registro-opcion:nth-child(4),
    .registro-pagina .registro-opcion:nth-child(5) {
        grid-column: auto !important;
    }

    .registro-pagina .registro-opcion {
        min-height: 180px !important;
    }
}


/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 620px) {

    .formulario.registro-pagina {
        min-height: auto !important;
        padding: 24px 14px !important;
    }

    .registro-pagina .registro-contenedor {
        padding: 22px 18px !important;
        border-radius: 20px !important;
    }

    .registro-pagina .registro-grid {
        grid-template-columns: 1fr !important;
        gap: 14px !important;
    }

    .registro-pagina .registro-opcion,
    .registro-pagina .registro-opcion:nth-child(4),
    .registro-pagina .registro-opcion:nth-child(5) {
        grid-column: auto !important;
        min-height: 0 !important;
    }

    .registro-pagina .registro-opcion h3,
    .registro-pagina .registro-opcion p {
        min-height: 0 !important;
    }

    .registro-pagina .registro-encabezado h1 {
        font-size: 28px !important;
    }

    .registro-pagina .registro-boton-volver {
        width: 100% !important;
        min-width: 0 !important;
    }
}

</style>

{% endblock %}


