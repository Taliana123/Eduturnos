{% extends 'base.html' %}
{% block title %}Verificar código · EDUTURNOS{% endblock %}
{% block content %}
<section class="formulario"><div class="tarjeta form-card">
  <div class="form-top-actions"><a class="link-back" href="{{ url_for('passwords.recuperar') }}">← Solicitar otro código</a><a class="link-back" href="{{ url_for('auth.login') }}">Iniciar sesión</a></div>
  <div class="section-heading"><span class="badge">Seguridad de cuenta</span><h1>Verificar código</h1><p>Escribe el código de 6 dígitos que recibiste en tu correo.</p></div>
  <form method="post" class="stack-form form-uniform">{{ csrf_field()|safe }}
    <label>Correo electrónico<input type="email" name="correo" value="{{ correo }}" readonly></label>
    <label>Código de recuperación<input name="codigo" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus autocomplete="one-time-code" placeholder="000000"></label>
    <button class="boton boton-full" type="submit">Verificar código</button>
  </form>
</div></section>


<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
