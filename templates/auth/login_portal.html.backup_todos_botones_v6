{% extends 'base.html' %}
{% block contenido %}
<div class="tarjeta formulario">
    <p><a href="{{ url_for('auth.login') }}">← Cambiar tipo de acceso</a></p>
    <h1>{{ info.label }}</h1>
    <p>{{ info.instruccion }}</p>
    <form method="post">{{ csrf_field()|safe }}
        <label>
            {% if info.identificador == 'correo' %}Correo institucional{% else %}Número de documento{% endif %}
            <input name="identificador" type="{{ 'email' if info.identificador == 'correo' else 'text' }}" required>
        </label>
        <label>Contraseña<input type="password" name="password" required></label>
        <button class="boton" type="submit">Ingresar</button>
    </form>
    <p style="margin-top:14px;">¿Todavía no tienes cuenta? <a href="{{ url_for('auth.registro_portal', portal=portal) }}">Crear cuenta</a></p>
</div>


<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
