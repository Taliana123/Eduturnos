/* =========================================================
   ROLES
   TODAS LAS TARJETAS DEL MISMO TAMAÑO
   ========================================================= */

.registro-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    align-items: stretch;
}

.registro-opcion {
    width: 100%;
    height: 112px;
    min-height: 112px;
    max-height: 112px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;
    padding: 16px 17px;

    background: #ffffff;

    border: 1px solid #dfe8f2;
    border-radius: 12px;

    box-sizing: border-box;
    overflow: hidden;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;
}

.registro-opcion:hover {
    transform: translateY(-2px);

    border-color: #bdd5f2;

    box-shadow:
        0 8px 18px rgba(18, 59, 104, .08);
}


/* =========================================================
   CONTENIDO DEL ROL
   ========================================================= */

.registro-opcion-contenido {
    min-width: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.registro-opcion h3 {
    margin: 0 0 6px;

    color: #123b68;

    font-size: 15px;
    font-weight: 750;
    line-height: 1.2;
}

.registro-opcion p {
    margin: 0;

    color: #71859a;

    font-size: 11.5px;
    line-height: 1.45;

    max-width: 100%;
}


/* =========================================================
   BOTÓN CREAR CUENTA
   ========================================================= */

.registro-opcion .registro-boton {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 88px;
    min-height: 34px;

    padding: 8px 12px;

    background: #2f78ff;
    color: #ffffff;

    border: 1px solid #2f78ff;
    border-radius: 8px;

    font-size: 10.5px;
    font-weight: 700;
    line-height: 1;

    text-decoration: none;

    box-shadow:
        0 4px 9px rgba(47, 120, 255, .13);

    transition:
        transform .18s ease,
        background-color .18s ease;
}

.registro-opcion .registro-boton:hover {
    background: #2368eb;
    border-color: #2368eb;

    transform: translateY(-1px);
}