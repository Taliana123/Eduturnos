/* =========================================================
   EDUTURNOS — CREAR CUENTA
   MISMA IDENTIDAD VISUAL QUE LOGIN
   ========================================================= */

.formulario.registro-pagina {
    min-height: calc(100vh - 80px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 42px 22px !important;
    box-sizing: border-box !important;
}

.registro-pagina .registro-contenedor {
    width: min(1080px, 100%) !important;
    max-width: 1080px !important;
    margin: 0 auto !important;
    padding: 42px !important;
    border-radius: 28px !important;
    background: rgba(255,255,255,.97) !important;
    border: 1px solid rgba(147,197,253,.65) !important;
    box-shadow:
        0 30px 70px rgba(30,64,175,.16),
        0 8px 25px rgba(15,23,42,.07) !important;
    box-sizing: border-box !important;
}

.registro-pagina .registro-encabezado {
    margin-bottom: 30px !important;
}

.registro-pagina .registro-encabezado .badge {
    display: inline-flex !important;
    align-items: center !important;
    padding: 7px 12px !important;
    border-radius: 999px !important;
    background: #eff6ff !important;
    color: #1d4ed8 !important;
    border: 1px solid #bfdbfe !important;
    font-size: 12px !important;
    font-weight: 800 !important;
    letter-spacing: .04em !important;
    text-transform: uppercase !important;
}

.registro-pagina .registro-encabezado h1 {
    margin: 14px 0 8px !important;
    color: #172554 !important;
    font-size: clamp(30px,4vw,40px) !important;
    line-height: 1.08 !important;
    letter-spacing: -.035em !important;
}

.registro-pagina .registro-encabezado p {
    max-width: 820px !important;
    margin: 0 !important;
    color: #64748b !important;
    line-height: 1.6 !important;
}

.registro-pagina .registro-grid {
    display: grid !important;
    grid-template-columns: repeat(6,minmax(0,1fr)) !important;
    gap: 18px !important;
    width: 100% !important;
}

.registro-pagina .registro-opcion {
    grid-column: span 2 !important;
    min-height: 190px !important;
    padding: 22px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
    background: #f8fbff !important;
    border: 1px solid #dbeafe !important;
    border-radius: 18px !important;
    box-shadow: 0 5px 16px rgba(30,64,175,.06) !important;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease !important;
}

.registro-pagina .registro-opcion:hover {
    transform: translateY(-3px) !important;
    border-color: #93c5fd !important;
    box-shadow: 0 14px 28px rgba(30,64,175,.12) !important;
}

.registro-pagina .registro-opcion:nth-child(4) {
    grid-column: 2 / span 2 !important;
}

.registro-pagina .registro-opcion:nth-child(5) {
    grid-column: 4 / span 2 !important;
}

.registro-pagina .registro-opcion h3 {
    margin: 0 0 9px !important;
    color: #172554 !important;
    font-size: 18px !important;
    line-height: 1.25 !important;
}

.registro-pagina .registro-opcion p {
    margin: 0 !important;
    color: #64748b !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
}

.registro-pagina .registro-boton {
    width: 100% !important;
    min-height: 46px !important;
    margin-top: 20px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    border-radius: 12px !important;
    background: linear-gradient(135deg,#2563eb,#3b82f6) !important;
    color: #fff !important;
    font-weight: 800 !important;
    text-decoration: none !important;
    box-shadow: 0 9px 22px rgba(37,99,235,.18) !important;
    transition: transform .18s ease, box-shadow .18s ease !important;
}

.registro-pagina .registro-boton:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 13px 27px rgba(37,99,235,.25) !important;
}

.registro-pagina .registro-volver {
    display: flex !important;
    justify-content: center !important;
    margin-top: 28px !important;
    padding-top: 22px !important;
    border-top: 1px solid #e2e8f0 !important;
}

.registro-pagina .link-back {
    color: #2563eb !important;
    font-weight: 700 !important;
    text-decoration: none !important;
}

.registro-pagina .link-back:hover {
    text-decoration: underline !important;
}

@media (max-width: 900px) {
    .registro-pagina .registro-contenedor {
        padding: 30px !important;
    }

    .registro-pagina .registro-grid {
        grid-template-columns: repeat(2,minmax(0,1fr)) !important;
    }

    .registro-pagina .registro-opcion,
    .registro-pagina .registro-opcion:nth-child(4),
    .registro-pagina .registro-opcion:nth-child(5) {
        grid-column: auto !important;
    }
}

@media (max-width: 620px) {
    .formulario.registro-pagina {
        padding: 28px 16px !important;
    }

    .registro-pagina .registro-contenedor {
        padding: 24px 18px !important;
        border-radius: 22px !important;
    }

    .registro-pagina .registro-grid {
        grid-template-columns: 1fr !important;
    }
}

</style>
{% endblock %}

