                    Z"
                    fill="#6fa9d8"
                    opacity=".86"/>

            </svg>

                </div>

            </section>


            <!-- =================================================
                 LOGIN
                 ================================================= -->

            <section class="login-card">


                <div class="section-heading">

                    <span class="badge">
                        Acceso seguro
                    </span>

                    <h1>
                        Iniciar sesión
                    </h1>

                    <p>
                        El sistema determina tu rol desde la información institucional.
                        No debes escogerlo.
                    </p>

                </div>


                <!-- Mensajes Flask -->

                {% with mensajes = get_flashed_messages(with_categories=true) %}

                    {% if mensajes %}

                        {% for categoria, mensaje in mensajes %}

                            <div
                                class="login-message {% if categoria in ['error','danger'] %}error{% else %}success{% endif %}"
                            >
                                {{ mensaje }}
                            </div>

                        {% endfor %}

                    {% endif %}

                {% endwith %}


                <form
                    method="post"
                    autocomplete="off"
                    class="stack-form"
                >

                    {{ csrf_field()|safe }}


                    <!-- Documento -->

                    <label>

                        Documento o correo

                        <input
                            type="text"
                            name="identificador"
                            autocomplete="username"
                            placeholder="Documento o correo"
                        >

                    </label>


                    <!-- Contraseña -->

                    <label>

                        Contraseña

                        <input
                            type="password"
                            name="password"
                            autocomplete="current-password"
                            placeholder="Contraseña"
                        >

                    </label>


                    <!-- Personal institucional -->

                    <div class="personal-login">

                        <h3>
                            Personal institucional
                        </h3>

                        <p>
                            Docentes, Coordinadores y Rectoría deben usar su correo
                            <strong>@jjfh.edu.co</strong>, código de 6 dígitos,
                            sede y jornada.
                        </p>


                        <div class="personal-fields-grid">


                            <!-- Código -->

                            <label class="personal-field personal-field-code">

                                <span class="personal-field-title">
                                    Código institucional
                                </span>

                                <input
                                    type="text"
                                    name="codigo_institucional"
                                    inputmode="numeric"
                                    maxlength="6"
                                    pattern="[0-9]{6}"
                                    autocomplete="off"
                                   
                                >

                            </label>


                            <!-- Sede -->

                            <label class="personal-field personal-field-sede">

                                <span class="personal-field-title">
                                    Sede institucional
                                </span>

                                <select
                                    name="sede_id"
                                >

                                    {% for sede in sedes %}

                                        {% if sede is mapping %}

                                            <option
                                                value="{{ sede.get('id_sede', sede.get('id')) }}"
                                            >
                                                {{ sede.get('nombre_sede', sede.get('nombre')) }}
                                            </option>

                                        {% else %}

                                            <option
                                                value="{{ sede[0] }}"
                                            >
                                                {{ sede[1] }}
                                            </option>

                                        {% endif %}

                                    {% endfor %}

                                </select>

                            </label>


                            <!-- Jornada -->

                            <label class="personal-field personal-field-jornada">

                                <span class="personal-field-title">
                                    Jornada
                                </span>

                                <select
                                    name="jornada_id"
                                >

                                    {% for jornada in jornadas %}

                                        {% if jornada is mapping %}

                                            <option
                                                value="{{ jornada.get('id_jornada', jornada.get('id')) }}"
                                            >
                                                {{ jornada.get('nombre_jornada', jornada.get('nombre')) }}
                                            </option>

                                        {% else %}

                                            <option
                                                value="{{ jornada[0] }}"
                                            >
                                                {{ jornada[1] }}
                                            </option>

                                        {% endif %}

                                    {% endfor %}

                                </select>

                            </label>


                        </div>

                    </div>


                    <button
                        class="boton-full"
                        type="submit"
                    >
                        Ingresar
                    </button>


                </form>


                <div class="form-links">

                    <a
                        href="{{ url_for('passwords.recuperar') }}"
                    >
                        ¿Olvidaste tu contraseña?
                    </a>

                    <a
                        href="{{ url_for('auth.registro') }}"
                    >
                        Crear una cuenta
                    </a>

                </div>


            </section>


        </div>

    </main>































<script id="EDUTURNOS_LOGIN_FINAL_REAL_JS">

(function () {

    function eduturnosLoginFinal() {

        var grid = document.querySelector(
            '.login-page .personal-login .personal-fields-grid'
        );

        if (!grid) {
            return;
        }

        grid.style.setProperty(
            'display',
            'grid',
            'important'
        );

        grid.style.setProperty(
            'grid-template-columns',
            '90px minmax(215px, 1fr) 85px',
            'important'
        );

        grid.style.setProperty(
            'gap',
            '10px',
            'important'
        );

        grid.style.setProperty(
            'width',
            '100%',
            'important'
        );

        grid.style.setProperty(
            'max-width',
            '415px',
            'important'
        );

        grid.style.setProperty(
            'margin-left',
            'auto',
            'important'
        );

        grid.style.setProperty(
            'margin-right',
            'auto',
            'important'
        );

        var codigo = document.querySelector(
            '.login-page input[name="codigo_institucional"]'
        );

        var sede = document.querySelector(
            '.login-page select[name="sede_id"]'
        );

        var jornada = document.querySelector(
            '.login-page select[name="jornada_id"]'
        );

        if (codigo) {
            codigo.style.setProperty(
                'width',
                '90px',
                'important'
            );

            codigo.style.setProperty(
                'min-width',
                '90px',
                'important'
            );

            codigo.style.setProperty(
                'max-width',
                '90px',
                'important'
            );
        }

        if (sede) {
            sede.style.setProperty(
                'width',
                '100%',
                'important'
            );

            sede.style.setProperty(
                'min-width',
                '0',
                'important'
            );

            sede.style.setProperty(
                'max-width',
                'none',
                'important'
            );
        }

        if (jornada) {
            jornada.style.setProperty(
                'width',
                '85px',
                'important'
            );

            jornada.style.setProperty(
                'min-width',
                '85px',
                'important'
            );

            jornada.style.setProperty(
                'max-width',
                '85px',
                'important'
            );
        }
    }

    if (document.readyState === 'loading') {

        document.addEventListener(
            'DOMContentLoaded',
            eduturnosLoginFinal
        );

    } else {

        eduturnosLoginFinal();

    }

    setTimeout(eduturnosLoginFinal, 100);
    setTimeout(eduturnosLoginFinal, 500);

})();

</script>













</body>

</html>
































