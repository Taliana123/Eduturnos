<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Iniciar sesión · EDUTURNOS</title>


    <style>

        /* =====================================================
           BASE
           ===================================================== */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family:
                "Public Sans",
                "Segoe UI",
                Arial,
                sans-serif;

            color: #202938;

            background:
                linear-gradient(
                    180deg,
                    #eef3f8 0%,
                    #f5f7fa 100%
                );
        }


        /* =====================================================
           CABECERA
           ===================================================== */

        .eduturnos-header {

            width: 100%;

            min-height: 76px;

            padding:
                0 46px;

            display: flex;

            align-items: center;

            background:
                #172942;

            border: 0;

            box-shadow:
                0 4px 18px
                rgba(15, 32, 55, .16);
        }

        .eduturnos-logo {

            margin: 0;

            color: #ffffff;

            font-size: 28px;

            line-height: 1;

            font-weight: 900;

            letter-spacing: .04em;
        }

        .eduturnos-logo span {

            color: #f2c14e;
        }


        /* =====================================================
           ZONA PRINCIPAL
           ===================================================== */

        .login-page {

            width: 100%;

            min-height:
                calc(100vh - 76px);

            display: flex;

            align-items: flex-start;

            justify-content: center;

            padding:
                30px 30px 42px;

        }


        .login-shell {

            width: min(1080px, 100%);

            display: grid;

            grid-template-columns:
                minmax(0, 1fr)
                minmax(500px, 560px);

            align-items: center;

            gap: 32px;

            margin: 0 auto;
        }


        /* =====================================================
           ILUSTRACIÓN
           ===================================================== */

        .login-visual {

            min-width: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 14px;
        }


        .login-illustration {

            width: 600px;

            aspect-ratio: 1 / 1;

            position: relative;

            display: flex;

            align-items: center;

            justify-content: center;

            overflow: visible;

            border-radius: 30px;

            background:
                transparent;
            transform: translateX(-18px);`r`n}


        .login-illustration::before,
        .login-illustration::after {

            content: none !important;
        }


        .illustration-svg {

            width: 100%;

            height: 100%;

            display: block;

            overflow: visible;
        }


        /* Animaciones suaves */

        .ill-float {

            animation:
                eduturnosFloat
                5s
                ease-in-out
                infinite;
        }


        .ill-pulse {

            transform-box: fill-box;

            transform-origin: center;

            animation:
                eduturnosPulse
                3.8s
                ease-in-out
                infinite;
        }


        @keyframes eduturnosFloat {

            0%,
            100% {
                transform:
                    translateY(0);
            }

            50% {
                transform:
                    translateY(-7px);
            }
        }


        @keyframes eduturnosPulse {

            0%,
            100% {
                transform:
                    scale(1);
            }

            50% {
                transform:
                    scale(1.025);
            }
        }


        /* =====================================================
           TARJETA LOGIN
           ===================================================== */

        .login-card {

            width: 100%;

            padding:
                28px 34px 26px;

            background: #ffffff;

            border:
                1px solid #d9e1ea;

            border-radius: 24px;

            box-shadow:
                0 18px 48px
                rgba(22, 41, 64, .11);
        }


        /* =====================================================
           ENCABEZADO
           ===================================================== */

        .section-heading {

            margin: 0 0 21px;

            padding: 0;

            border: 0 !important;

            box-shadow: none !important;

            text-align: left;
        }


        .section-heading::before,
        .section-heading::after {

            content: none !important;

            display: none !important;
        }


        .badge {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-height: 29px;

            padding:
                5px 11px;

            margin: 0 0 9px;

            border-radius: 999px;

            background:
                #e8f1fc;

            color:
                #245c96;

            font-size: 11px;

            line-height: 1;

            font-weight: 800;

            letter-spacing: .03em;

            text-transform: uppercase;
        }


        .section-heading h1 {

            margin: 0;

            padding: 0;

            border: 0 !important;

            color:
                #172942;

            font-size: 30px;

            line-height: 1.15;

            font-weight: 850;
        }


        .section-heading p {

            margin: 9px 0 0;

            padding: 0;

            border: 0 !important;

            border-bottom: 0 !important;

            box-shadow: none !important;

            background: transparent !important;

            background-image: none !important;

            color:
                #657386;

            font-size: 13px;

            line-height: 1.52;

            text-decoration: none !important;
        }


        .section-heading p::before,
        .section-heading p::after {

            content: none !important;

            display: none !important;
        }


        /* =====================================================
           FORMULARIO
           ===================================================== */

        .stack-form {

            margin: 0;

            padding: 0;
        }


        .stack-form > label {

            display: block;

            margin: 0 0 14px;

            padding: 0;

            color:
                #273244;

            font-size: 13px;

            line-height: 1.35;

            font-weight: 750;
        }


        .stack-form > label input {

            display: block;

            width: 100%;

            height: 43px;

            margin-top: 7px;

            padding:
                0 12px;

            border:
                1px solid #c8d2de;

            border-radius: 10px;

            outline: none;

            background:
                #ffffff;

            color:
                #252d3a;

            font-size: 14px;

            font-weight: 500;

            box-shadow: none;

            transition:
                border-color .16s ease,
                box-shadow .16s ease;
        }


        .stack-form > label input::placeholder {

            color:
                #9aa6b4;
        }


        .stack-form > label input:focus {

            border-color:
                #4384c2;

            box-shadow:
                0 0 0 3px
                rgba(67, 132, 194, .12);
        }


        /* =====================================================
           PERSONAL INSTITUCIONAL
           ===================================================== */

        .personal-login {

            margin-top: 4px;

            padding:
                17px 16px 16px;

            border:
                1px solid #dbe5ef;

            border-radius: 15px;

            background:
                #f7faff;
        }


        .personal-login h3 {

            margin: 0 0 5px;

            padding: 0;

            color:
                #233d5f;

            font-size: 15px;

            line-height: 1.25;

            font-weight: 850;
        }


        .personal-login p {

            margin: 0 0 13px;

            padding: 0;

            color:
                #6b7888;

            font-size: 12px;

            line-height: 1.48;
        }


        


        .personal-field {

            display: block;

            margin: 0;

            padding: 0;

            text-align: center;
        }


        /* Código: exactamente para 6 dígitos
           + poco espacio */

        


        /* Sede: justo para la primera opción */

        .personal-field-sede {

            flex: 0 0 260px;

            width: 260px;

            min-width: 260px;

            max-width: 260px;
        }


        /* Jornada */

        .personal-field-jornada {

            flex: 0 0 112px;

            width: 112px;

            min-width: 112px;

            max-width: 112px;
        }


        .personal-field-title {

            display: block;

            width: 100%;

            margin:
                0 0 5px;

            padding: 0;

            color:
                #344255;

            font-size: 11px;

            line-height: 1.2;

            font-weight: 800;

            text-align: center;

            white-space: nowrap;
        }


        .personal-field input,
        .personal-field select {

            display: block;

            width: 100%;

            height: 40px;

            margin: 0;

            padding:
                0 8px;

            box-sizing: border-box;

            border:
                1px solid #c8d3df;

            border-radius: 9px;

            background:
                #ffffff;

            color:
                #1e2938;

            font-family: inherit;

            font-size: 12px;

            font-weight: 500;

            outline: none;
        }


        /* IMPORTANTE:
           NO appearance:none.
           El desplegable nativo continúa funcionando. */

        .personal-field select {

            cursor: pointer;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        .personal-field input:focus,
        .personal-field select:focus {

            border-color:
                #4384c2;

            box-shadow:
                0 0 0 3px
                rgba(67, 132, 194, .10);
        }


        .personal-field-code input {

            text-align: left;
        }


        .personal-field-sede select {

            padding-right: 8px;
        }


        .personal-field-jornada select {

            padding-right: 8px;
        }


        /* =====================================================
           BOTÓN
           ===================================================== */

        .boton-full {

            display: flex;

            width: 100%;

            height: 46px;

            margin-top: 17px;

            align-items: center;

            justify-content: center;

            border: 0;

            border-radius: 11px;

            background:
                #2769ad;

            color:
                #ffffff;

            font-family: inherit;

            font-size: 14px;

            font-weight: 850;

            cursor: pointer;

            box-shadow:
                0 9px 20px
                rgba(39, 105, 173, .19);

            transition:
                transform .16s ease,
                box-shadow .16s ease,
                background .16s ease;
        }


        .boton-full:hover {

            background:
                #225e9d;

            transform:
                translateY(-1px);

            box-shadow:
                0 12px 24px
                rgba(39, 105, 173, .23);
        }


        .boton-full:active {

            transform:
                translateY(0);
        }


        /* =====================================================
           ENLACES
           ===================================================== */

        .form-links {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 14px;

            margin-top: 17px;

            padding-top: 15px;

            border-top:
                1px solid #e4e9ef;
        }


        .form-links a {

            color:
                #386fa8;

            font-size: 12px;

            font-weight: 750;

            text-decoration: none;
        }


        .form-links a:hover {

            color:
                #234f7d;

            text-decoration:
                underline;
        }


        /* =====================================================
           MENSAJES
           ===================================================== */

        .login-message {

            margin: 0 0 15px;

            padding:
                9px 11px;

            border-radius: 9px;

            font-size: 12px;

            line-height: 1.4;
        }


        .login-message.error {

            background:
                #fff2f1;

            border:
                1px solid #f2cbc7;

            color:
                #9c3831;
        }


        .login-message.success {

            background:
                #eef9f1;

            border:
                1px solid #cbe8d1;

            color:
                #27683b;
        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @media (max-width: 980px) {

            .login-shell {

                grid-template-columns:
                    1fr;

                max-width:
                    650px;

                gap:
                    18px;
            }


            .login-visual {

                padding: 0;
            }


            .login-illustration {

                width:
                    250px;
            }
        }


        @media (max-width: 640px) {

            .eduturnos-header {

                min-height:
                    64px;

                padding:
                    0 20px;
            }


            .eduturnos-logo {

                font-size:
                    23px;
            }


            .login-page {

                min-height:
                    calc(100vh - 64px);

                padding:
                    18px 14px 28px;
            }


            .login-card {

                padding:
                    24px 18px 20px;

                border-radius:
                    20px;
            }


            .login-illustration {

                width:
                    200px;

                border-radius:
                    24px;
            }


            .section-heading h1 {

                font-size:
                    26px;
            }


            


            .personal-field-code,
            .personal-field-sede,
            .personal-field-jornada {

                width:
                    100%;

                min-width:
                    0;

                max-width:
                    none;

                flex:
                    none;
            }


            .personal-field input,
            .personal-field select {

                width:
                    100%;
            }


            .form-links {

                flex-direction:
                    column;

                align-items:
                    stretch;

                text-align:
                    center;
            }
        }

    </style>



