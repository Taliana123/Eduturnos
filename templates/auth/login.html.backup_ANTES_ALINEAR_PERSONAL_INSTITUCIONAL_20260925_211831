                        d="M91 126 Q109 115 127 128 L127 168 Q109 157 91 168 Z"
                        fill="#ffffff"/>

                    <path
                        d="M63 137 Q75 130 85 136"
                        fill="none"
                        stroke="#438ac7"
                        stroke-width="3"
                        stroke-linecap="round"/>

                    <path
                        d="M97 136 Q108 130 119 137"
                        fill="none"
                        stroke="#5d9bcf"
                        stroke-width="3"
                        stroke-linecap="round"/>

                    <line
                        x1="91"
                        y1="126"
                        x2="91"
                        y2="168"
                        stroke="#d7e2ec"
                        stroke-width="2"/>

                </g>

                <!-- CAMPANA -->
                <g
                    class="compact-bell"
                    filter="url(#edCompactSoft)">

                    <circle
                        cx="382"
                        cy="142"
                        r="32"
                        fill="#ffffff"/>

                    <path
                        d="
                        M370 150
                        V137
                        C370 129 375 123 382 123
                        C389 123 394 129 394 137
                        V150
                        L399 154
                        H365
                        Z"
                        fill="#2f6fae"/>

                    <circle
                        cx="382"
                        cy="158"
                        r="5"
                        fill="#3d86c1"/>

                </g>

                <!-- CHECK ANIMADO -->
                <g
                    class="compact-check"
                    filter="url(#edCompactSoft)">

                    <circle
                        cx="80"
                        cy="226"
                        r="23"
                        fill="#ffffff"/>

                    <circle
                        cx="80"
                        cy="226"
                        r="15"
                        fill="#e1f2ff"/>

                    <path
                        d="M72 226 L78 232 L90 218"
                        fill="none"
                        stroke="#2878c2"
                        stroke-width="5"
                        stroke-linecap="round"
                        stroke-linejoin="round"/>

                </g>

                <!-- PEQUEÑA ESTRELLA DECORATIVA -->
                <path
                    d="
                    M362 235
                    L367 245
                    L378 247
                    L370 255
