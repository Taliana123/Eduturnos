            <!-- =================================================
                 LOGIN
                 ================================================= -->

            <section class="login-card">


                <div class="section-heading">

                    <span class="badge">
                        Acceso seguro
                    </span>

                    <h1>
                        Iniciar sesión
                    </h1>

                    <p>
                        El sistema determina tu rol desde la información institucional.
                        No debes escogerlo.
                    </p>

                </div>


                <!-- Mensajes Flask -->

                {% with mensajes = get_flashed_messages(with_categories=true) %}

                    {% if mensajes %}

                        {% for categoria, mensaje in mensajes %}

                            <div
                                class="login-message {% if categoria in ['error','danger'] %}error{% else %}success{% endif %}"
                            >
                                {{ mensaje }}
                            </div>

                        {% endfor %}

                    {% endif %}

                {% endwith %}


                <form
                    method="post"
                    autocomplete="off"
                    class="stack-form"
                >

                    {{ csrf_field()|safe }}


                    <!-- Documento -->

                    <label>

                        Documento o correo

                        <input
                            type="text"
                            name="identificador"
                            autocomplete="username"
                            placeholder="Documento o correo"
                        >

                    </label>


                    <!-- Contraseña -->

                    <label>

                        Contraseña

                        <input
                            type="password"
                            name="password"
                            autocomplete="current-password"
                            placeholder="Contraseña"
                        >

                    </label>


                    <!-- Personal institucional -->

                    <div class="personal-login">

                        <h3>
                            Personal institucional
                        </h3>

                        <p>
                            Docentes, Coordinadores y Rectoría deben usar su correo
                            <strong>@jjfh.edu.co</strong>, código de 6 dígitos,
                            sede y jornada.
                        </p>


                        <div class="personal-fields-grid eduturnos-institution-fields">

    <label class="personal-field personal-field-code">
        <span class="personal-field-title">Código institucional</span>
        <input
            type="text"
            name="codigo_institucional"
            inputmode="numeric"
            maxlength="6"
            pattern="[0-9]{6}"
            autocomplete="off"
        >
    </label>

    <label class="personal-field personal-field-sede">
        <span class="personal-field-title">Sede institucional</span>
        <select name="sede_id">
            {% for sede in sedes %}
                <option value="{{ sede.id }}">{{ sede.nombre }}</option>
            {% endfor %}
        </select>
    </label>

    <label class="personal-field personal-field-jornada">
        <span class="personal-field-title">Jornada</span>
        <select name="jornada_id">
            {% for jornada in jornadas %}
                <option value="{{ jornada.id }}">{{ jornada.nombre }}</option>
            {% endfor %}
        </select>
    </label>

</div></div>


                    <button
                        class="boton-full"
                        type="submit"
                    >
                        Ingresar
                    </button>


                </form>


                <div class="form-links">

                    <a
                        href="{{ url_for('passwords.recuperar') }}"
                    >
                        ¿Olvidaste tu contraseña?
                    </a>

                    <a
                        href="{{ url_for('auth.registro') }}"
                    >
                        Crear una cuenta
                    </a>

