{% extends 'base.html' %}

{% block title %}Crear cuenta · EDUTURNOS{% endblock %}

{% block content %}

<section class="registro-pagina">

    <div class="registro-contenedor">

        <div class="registro-encabezado">

            <div class="registro-icono" aria-hidden="true">
                <span>+</span>
            </div>

            <div>
                <p class="registro-etiqueta">EDUTURNOS</p>

                <h1>Crear cuenta</h1>

                <p class="registro-descripcion">
                    Selecciona el tipo de cuenta que deseas crear
                    para continuar con tu registro.
                </p>
            </div>

        </div>


        <div class="registro-grid">

{% for slug, info in portales.items() %}

            <article class="registro-opcion">

                <div class="registro-opcion-contenido">

                    <h3>{{ info.label }}</h3>

                    <p>{{ info.descripcion }}</p>

                </div>

                <a
                    class="registro-boton"
                    href="{{ url_for('auth.registro_portal', portal=slug) }}"
                >
                    Crear cuenta
                </a>

            </article>

            {% endfor %}

        </div>


        <div class="registro-retorno">

            <a
                href="{{ url_for('auth.login') }}"
                class="link-back"
            >
                <span aria-hidden="true">←</span>
                <span>Volver al inicio de sesión</span>
            </a>

        </div>

    </div>

</section>


<style id="EDUTURNOS_REGISTRO_UNICO_2026">

/* =========================================================
   EDUTURNOS · CREAR CUENTA · BLOQUE ÚNICO
   ========================================================= */

.registro-pagina {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 28px 20px 42px;
}


/* ---------------------------------------------------------
   TARJETA PRINCIPAL
   --------------------------------------------------------- */

.registro-contenedor {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;

    background: #ffffff;
    border: 1px solid #dce7f4;
    border-radius: 18px;

    padding: 30px;

    box-shadow:
        0 16px 40px rgba(18, 59, 104, .09);

    box-sizing: border-box;
}


/* ---------------------------------------------------------
   ENCABEZADO
   --------------------------------------------------------- */

.registro-encabezado {
    display: flex;
    align-items: center;
    gap: 16px;

    margin-bottom: 24px;
}


.registro-icono {
    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background: #eaf3ff;
    border: 1px solid #d6e8ff;

    color: #2f78ff;

    font-size: 28px;
    font-weight: 700;

    box-shadow: 0 7px 18px rgba(47, 120, 255, .10);

    animation: registro-icono-flotante 3.5s ease-in-out infinite;
}


.registro-icono span {
    display: block;
    line-height: 1;
}


.registro-etiqueta {
    margin: 0 0 3px;

    color: #2f78ff;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: .13em;
    text-transform: uppercase;
}


.registro-encabezado h1 {
    margin: 0;

    color: #123b68;

    font-family: "Source Serif 4", Georgia, serif;

    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.05;
    letter-spacing: -.02em;
}


.registro-descripcion {
    margin: 7px 0 0;

    max-width: 590px;

    color: #5f7895;

    font-size: 14px;
    line-height: 1.55;
}


/* ---------------------------------------------------------
   OPCIONES DE ROL
   --------------------------------------------------------- */

.registro-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 12px;

    margin: 0;
}


.registro-opcion {
    min-height: 92px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 14px;

    padding: 15px 16px;

    background: #f8fbff;

    border: 1px solid #dce7f4;
    border-radius: 13px;

    box-sizing: border-box;

    transition:
        transform .20s ease,
        border-color .20s ease,
        box-shadow .20s ease,
        background-color .20s ease;
}


.registro-opcion:hover {
    transform: translateY(-2px);

    background: #ffffff;

    border-color: #bcd7fb;

    box-shadow:
        0 9px 22px rgba(18, 59, 104, .09);
}


.registro-opcion-contenido {
    min-width: 0;
}


.registro-opcion h3 {
    margin: 0 0 3px;

    color: #123b68;

    font-size: 16px;
    font-weight: 750;

    line-height: 1.2;
}


.registro-opcion p {
    margin: 0;

    color: #6b8098;

    font-size: 12px;
    line-height: 1.4;
}


/* ---------------------------------------------------------
   BOTÓN CREAR CUENTA
   --------------------------------------------------------- */

.registro-opcion .registro-boton {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 36px;

    padding: 8px 13px;

    background: #2f78ff;
    color: #ffffff;

    border: 1px solid #2f78ff;
    border-radius: 8px;

    font-family: inherit;
    font-size: 12px;
    font-weight: 700;

    line-height: 1;
    text-decoration: none;

    box-shadow: 0 5px 12px rgba(47, 120, 255, .15);

    transition:
        transform .18s ease,
        background-color .18s ease,
        box-shadow .18s ease;
}


.registro-opcion .registro-boton:hover {
    background: #2368eb;
    border-color: #2368eb;

    transform: translateY(-1px);

    box-shadow: 0 7px 16px rgba(47, 120, 255, .22);
}


.registro-opcion .registro-boton:active {
    transform: translateY(0);
}


/* ---------------------------------------------------------
   VOLVER AL LOGIN
   IMPORTANTE:
   NO ES BOTÓN
   --------------------------------------------------------- */

.registro-retorno {
    margin-top: 22px;
    padding-top: 0;

    border-top: 0 !important;

    text-align: center;
}


.registro-retorno a {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    margin: 0;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    color: #2f78ff !important;

    font-size: 13px;
    font-weight: 700;

    line-height: 1.4;
    text-decoration: none;

    padding: 2px 4px !important;

    transition:
        color .18s ease,
        transform .18s ease;
}


.registro-retorno a:hover {
    color: #123b68 !important;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    transform: translateX(-2px);
}


.registro-retorno a span:first-child {
    font-size: 16px;
    line-height: 1;
}


/* ---------------------------------------------------------
   ANIMACIÓN SUTIL
   --------------------------------------------------------- */

@keyframes registro-icono-flotante {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-3px);
    }

}


/* ---------------------------------------------------------
   RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 720px) {

    .registro-pagina {
        padding: 18px 12px 30px;
    }

    .registro-contenedor {
        padding: 22px 18px;
        border-radius: 15px;
    }

    .registro-encabezado {
        align-items: flex-start;
    }

    .registro-grid {
        grid-template-columns: 1fr;
    }

    .registro-opcion {
        min-height: 84px;
    }

}


@media (max-width: 430px) {

    .registro-encabezado {
        gap: 11px;
    }

    .registro-icono {
        width: 44px;
        height: 44px;
        flex-basis: 44px;
        border-radius: 12px;
        font-size: 23px;
    }

    .registro-encabezado h1 {
        font-size: 30px;
    }

    .registro-opcion {
        align-items: flex-start;
        flex-direction: column;
    }

    .registro-opcion .registro-boton {
        width: 100%;
    }

}

</style>

{% endblock %}