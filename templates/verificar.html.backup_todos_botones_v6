{% extends 'base.html' %}
{% block contenido %}
<div class="tarjeta formulario">
    <h1>Verificar cuenta</h1>
    <p>Escribe el código de verificación generado por el sistema.</p>
    {% if codigo %}<div class="codigo">Código de desarrollo: {{ codigo }}</div>{% endif %}
    <form method="post">{{ csrf_field()|safe }}
        <label>Código<input name="codigo" maxlength="6" required></label>
        <button class="boton" type="submit">Verificar</button>
    </form>
</div>


<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
