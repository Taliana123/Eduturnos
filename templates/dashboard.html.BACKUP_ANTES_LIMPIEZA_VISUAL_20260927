<style id="EDUTURNOS_DASHBOARD_UNICO">

/* ============================================================
   EDUTURNOS
   DASHBOARD — REDISEÑO VISUAL COMPLETO
   ============================================================ */

/* ------------------------------------------------------------
   FONDO GENERAL
   ------------------------------------------------------------ */

body:has(.dashboard-page) #contenido {
    background: #f4f7fb !important;
}

body:has(.dashboard-page) {
    background: #f4f7fb !important;
}

.dashboard-page {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 42px 0 70px;

    color: #172942;
}

/* ------------------------------------------------------------
   CABECERA PRINCIPAL
   ------------------------------------------------------------ */

.dashboard-head {
    position: relative;

    min-height: 280px;

    padding: 42px 46px;

    display: flex;
    align-items: center;

    border-radius: 30px;

    overflow: hidden;

    color: #ffffff;

    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(242,184,75,.20),
            transparent 23%
        ),
        radial-gradient(
            circle at 8% 100%,
            rgba(35,102,143,.32),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #14263e 0%,
            #193954 48%,
            #21668e 100%
        );

    box-shadow:
        0 22px 55px rgba(23,41,66,.16);
}

/* círculos decorativos */

.dashboard-head::before {
    content: "";

    position: absolute;

    width: 420px;
    height: 420px;

    right: -175px;
    top: -250px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.11);

    box-shadow:
        0 0 0 35px rgba(255,255,255,.025),
        0 0 0 70px rgba(255,255,255,.018);
}

.dashboard-head::after {
    content: "";

    position: absolute;

    width: 240px;
    height: 240px;

    right: 115px;
    bottom: -185px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.10);
}

/* contenido */

.dashboard-head-info {
    position: relative;

    z-index: 5;

    max-width: 650px;
}

/* etiqueta */

.dashboard-head-info .badge {
    display: inline-flex;
    align-items: center;

    padding: 7px 13px;

    border-radius: 999px;

    background: rgba(255,255,255,.10);

    border: 1px solid rgba(255,255,255,.12);

    color: #ffd36a;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .14em;

    backdrop-filter: blur(5px);
}

/* título */

.dashboard-head-info h1 {
    margin: 15px 0 10px !important;

    color: #ffffff !important;

    font-family: "Source Serif 4", Georgia, serif;

    font-size: clamp(36px, 4vw, 52px);

    line-height: 1.02;

    letter-spacing: -.035em;
}

/* texto */

.dashboard-head-info p {
    margin: 0;

    max-width: 550px;

    color: #d8e6f0 !important;

    font-size: 15px;

    line-height: 1.6;
}

/* ------------------------------------------------------------
   BOTÓN CERRAR SESIÓN
   ------------------------------------------------------------ */

.dashboard-head-action {
    position: relative;

    z-index: 10;

    margin-left: auto;

    align-self: flex-start;
}

.dashboard-logout {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 43px;

    padding: 0 19px;

    border-radius: 12px;

    background: #d85d58 !important;

    color: #ffffff !important;

    text-decoration: none;

    font-size: 13px;
    font-weight: 800;

    box-shadow:
        0 8px 20px rgba(0,0,0,.15);

    transition:
        transform .22s ease,
        box-shadow .22s ease;
}

.dashboard-logout:hover {
    transform: translateY(-3px);

    box-shadow:
        0 13px 25px rgba(0,0,0,.20);
}

/* ------------------------------------------------------------
   ILUSTRACIÓN ABSTRACTA DEL ROL
   ------------------------------------------------------------ */

.dashboard-role-art {
    position: absolute;

    right: 150px;
    top: 43px;

    width: 190px;
    height: 190px;

    z-index: 2;

    opacity: 1;
}

.dashboard-role-art::before {
    content: "";

    position: absolute;

    inset: 4px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.18);
}

.dashboard-role-art::after {
    content: "";

    position: absolute;

    inset: 27px;

    border-radius: 50%;

    border: 1px dashed rgba(255,255,255,.17);

    animation:
        giroRol 18s linear infinite;
}

.role-symbol {
    position: absolute;

    inset: 0;
}

.role-symbol span {
    position: absolute;

    left: 55px;
    top: 55px;

    width: 78px;
    height: 78px;

    border-radius: 24px;

    background: #f2b84b;

    transform: rotate(18deg);

    box-shadow:
        0 18px 35px rgba(0,0,0,.20);

    transition:
        transform .30s ease;
}

.dashboard-role-art:hover .role-symbol span {
    transform:
        rotate(24deg)
        scale(1.04);
}

.role-symbol i {
    position: absolute;

    left: 33px;
    top: 88px;

    width: 24px;
    height: 24px;

    border-radius: 50%;

    background: #7fc4ed;

    box-shadow:
        0 8px 18px rgba(0,0,0,.12);
}

.role-symbol b {
    position: absolute;

    right: 29px;
    top: 36px;

    width: 14px;
    height: 14px;

    border-radius: 50%;

    background: #ffffff;
}

.role-rectoria span {
    border-radius: 13px 13px 31px 31px;
}

.role-estudiante span {
    border-radius: 50%;

    transform: rotate(0);
}

.role-acudiente span {
    border-radius: 50% 18px 50% 18px;
}

.role-docente span {
    border-radius: 9px;

    transform: rotate(45deg);
}

.role-coordinador span {
    clip-path:
        polygon(
            50% 0,
            100% 25%,
            82% 100%,
            18% 100%,
            0 25%
        );

    border-radius: 0;

    transform: rotate(0);
}

.role-default span {
    border-radius: 22px;
}

@keyframes giroRol {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

/* ------------------------------------------------------------
   INDICADORES
   ------------------------------------------------------------ */

.dashboard-kpis {
    display: grid !important;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;

    margin: 24px 0 62px !important;
}

.dashboard-kpi {
    position: relative;

    padding: 22px 22px 20px;

    min-height: 100px;

    border: 1px solid #dce5ed;

    border-radius: 18px;

    background: rgba(255,255,255,.94);

    box-shadow:
        0 9px 28px rgba(23,41,66,.055);

    overflow: hidden;

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
}

.dashboard-kpi::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;

    width: 4px;
    height: 100%;

    background:
        linear-gradient(
            180deg,
            #1769aa,
            #f2b84b
        );
}

.dashboard-kpi:hover {
    transform: translateY(-4px);

    border-color: #c4d9e8;

    box-shadow:
        0 15px 32px rgba(23,41,66,.09);
}

.dashboard-kpi span {
    display: block;

    color: #718094 !important;

    font-size: 12px;

    line-height: 1.35;
}

.dashboard-kpi strong {
    display: block;

    margin-top: 9px;

    color: #172942 !important;

    font-size: 30px;

    line-height: 1;
}

/* ------------------------------------------------------------
   CONTENEDORES
   ------------------------------------------------------------ */

.dashboard-card {
    border: 0 !important;

    background: transparent !important;

    box-shadow: none !important;

    padding: 0 !important;
}

/* ------------------------------------------------------------
   ENCABEZADOS DE SECCIÓN
   ------------------------------------------------------------ */

.dashboard-card-head {
    margin-bottom: 25px !important;
}

.dashboard-card-head .badge {
    display: inline-block;

    color: #1769aa;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .14em;
}

.dashboard-card-head h2 {
    margin: 7px 0 7px !important;

    color: #172942 !important;

    font-family:
        "Source Serif 4",
        Georgia,
        serif;

    font-size: 34px;

    line-height: 1.05;

    letter-spacing: -.025em;
}

.dashboard-card-head p {
    margin: 0;

    color: #718094 !important;

    font-size: 14px;

    line-height: 1.5;
}

/* ------------------------------------------------------------
   ACCIONES RÁPIDAS
   ------------------------------------------------------------ */

.dashboard-action-grid {
    display: grid !important;

    grid-template-columns:
        repeat(3, minmax(0, 1fr)) !important;

    gap: 19px !important;
}

.dashboard-action {
    position: relative;

    min-height: 218px !important;

    padding: 25px !important;

    display: flex !important;

    flex-direction: column;

    border:
        1px solid #dce5ed !important;

    border-radius: 21px !important;

    background:
        #ffffff !important;

    box-shadow:
        0 9px 27px rgba(23,41,66,.055) !important;

    text-decoration: none !important;

    overflow: hidden;

    transition:
        transform .24s ease,
        box-shadow .24s ease,
        border-color .24s ease !important;
}

/* línea superior */

.dashboard-action::before {
    content: "";

    position: absolute;

    top: 0;

    left: 23px;
    right: 23px;

    height: 3px;

    border-radius:
        0 0 9px 9px;

    background:
        linear-gradient(
            90deg,
            #1769aa 0%,
            #4e9dcc 55%,
            #f2b84b 100%
        );
}

/* brillo muy sutil */

.dashboard-action::after {
    content: "";

    position: absolute;

    width: 150px;
    height: 150px;

    right: -95px;
    bottom: -95px;

    border-radius: 50%;

    background:
        rgba(23,105,170,.045);

    transition:
        transform .35s ease;
}

.dashboard-action:hover::after {
    transform: scale(1.45);
}

.dashboard-action:hover {
    transform: translateY(-5px) !important;

    border-color:
        #b9d4e8 !important;

    box-shadow:
        0 18px 38px rgba(23,41,66,.105) !important;
}

/* etiqueta */

.dashboard-action-icon {
    position: relative;

    z-index: 2;

    width: fit-content;

    min-height: 33px;

    padding: 7px 11px !important;

    display: inline-flex;

    align-items: center;

    border-radius: 9px !important;

    background:
        #e8f3fb !important;

    color:
        #1769aa !important;

    font-size: 11px !important;

    font-weight: 800 !important;
}

/* título */

.dashboard-action h3 {
    position: relative;

    z-index: 2;

    margin: 19px 0 8px !important;

    color: #172942 !important;

    font-family:
        "Source Serif 4",
        Georgia,
        serif;

    font-size: 24px !important;

    line-height: 1.08;
}

/* descripción */

.dashboard-action p {
    position: relative;

    z-index: 2;

    flex: 1;

    margin: 0 !important;

    color: #718094 !important;

    font-size: 13.5px !important;

    line-height: 1.55 !important;
}

/* enlace */

.dashboard-action-link {
    position: relative;

    z-index: 2;

    margin-top: 19px !important;

    color: #1769aa !important;

    font-size: 13px;

    font-weight: 800 !important;
}

/* ------------------------------------------------------------
   CUENTA
   ------------------------------------------------------------ */

.dashboard-account-card {
    position: relative;

    margin-top: 42px;

    padding: 29px 31px !important;

    border-radius: 22px !important;

    border:
        1px solid #d8e7f1 !important;

    background:
        linear-gradient(
            135deg,
            #edf5fa 0%,
            #f5f9fc 100%
        ) !important;

    overflow: hidden;
}

.dashboard-account-card::after {
    content: "";

    position: absolute;

    width: 220px;
    height: 220px;

    right: -90px;
    top: -135px;

    border-radius: 50%;

    border:
        1px solid rgba(23,105,170,.08);
}

.dashboard-account-text {
    position: relative;

    z-index: 2;

    color: #68798a !important;

    font-size: 13.5px;
}

.dashboard-account-action {
    position: relative;

    z-index: 3;

    max-width: 280px;

    margin-top: 17px;
}

.dashboard-account-action .boton-full {
    background:
        #1769aa !important;

    color:
        #ffffff !important;

    border-radius:
        12px !important;

    box-shadow:
        0 8px 18px rgba(23,105,170,.14);

    transition:
        transform .22s ease,
        box-shadow .22s ease;
}

.dashboard-account-action .boton-full:hover {
    transform: translateY(-3px);

    box-shadow:
        0 13px 24px rgba(23,105,170,.20);
}

/* ------------------------------------------------------------
   ANIMACIÓN DE ENTRADA
   ------------------------------------------------------------ */

.dashboard-head,
.dashboard-kpi,
.dashboard-action,
.dashboard-account-card {
    animation:
        dashboardEntrada .55s ease both;
}

.dashboard-kpi:nth-child(2) {
    animation-delay: .05s;
}

.dashboard-kpi:nth-child(3) {
    animation-delay: .10s;
}

.dashboard-kpi:nth-child(4) {
    animation-delay: .15s;
}

.dashboard-action:nth-child(2) {
    animation-delay: .05s;
}

.dashboard-action:nth-child(3) {
    animation-delay: .10s;
}

.dashboard-action:nth-child(4) {
    animation-delay: .15s;
}

.dashboard-action:nth-child(5) {
    animation-delay: .20s;
}

@keyframes dashboardEntrada {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ------------------------------------------------------------
   TABLET
   ------------------------------------------------------------ */

@media (max-width: 1050px) {

    .dashboard-role-art {
        right: 70px;
        opacity: .60;
    }

    .dashboard-action-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
    }

    .dashboard-kpis {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

/* ------------------------------------------------------------
   MÓVIL
   ------------------------------------------------------------ */

@media (max-width: 700px) {

    .dashboard-page {
        width: calc(100% - 28px);

        padding:
            22px 0 45px;
    }

    .dashboard-head {
        min-height: 0;

        padding: 30px 25px;

        flex-direction: column;

        align-items: flex-start;

        border-radius: 23px;
    }

    .dashboard-head-info h1 {
        font-size: 34px;
    }

    .dashboard-head-info p {
        font-size: 14px;
    }

    .dashboard-role-art {
        display: none;
    }

    .dashboard-head-action {
        width: 100%;

        margin-left: 0;

        align-self: stretch;
    }

    .dashboard-logout {
        width: 100%;
    }

    .dashboard-kpis {
        grid-template-columns: 1fr !important;

        margin-bottom: 45px !important;
    }

    .dashboard-card-head h2 {
        font-size: 29px;
    }

    .dashboard-action-grid {
        grid-template-columns: 1fr !important;
    }

    .dashboard-action {
        min-height: 200px !important;
    }

    .dashboard-account-card {
        padding: 24px !important;
    }

    .dashboard-account-action {
        max-width: none;
    }
}

/* ------------------------------------------------------------
   REDUCCIÓN DE MOVIMIENTO
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

    .dashboard-role-art::after {
        animation: none;
