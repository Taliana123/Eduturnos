{% extends 'base.html' %}{% block title %}Justificaciones · EDUTURNOS{% endblock %}{% block content %}<div class="page-head"><div><h1>Justificaciones</h1><p class="muted">Solicitudes y resoluciones relacionadas con citaciones.</p></div></div><div class="table-wrap"><table><thead><tr><th>Cita</th><th>Fecha</th><th>Estudiante</th><th>Motivo</th><th>Estado</th>{% if rol in ['Super Admin','Rector','Administrador / Coordinador'] %}<th>Acción</th>{% endif %}</tr></thead><tbody>{% for j in justificaciones %}<tr><td>#{{ j.id_cita }}</td><td>{{ j.fecha }}</td><td>{{ j.estudiante }}</td><td>{{ j.motivo }}</td><td><span class="badge">{{ j.estado }}</span></td>{% if rol in ['Super Admin','Rector','Administrador / Coordinador'] and j.estado == 'Pendiente' %}<td><form method="post" action="{{ url_for('justificaciones.resolver', justificacion_id=j.id) }}" class="inline-form">{{ csrf_field()|safe }}<button name="estado" value="Aceptada">Aceptar</button><button name="estado" value="Rechazada">Rechazar</button></form></td>{% endif %}</tr>{% else %}<tr><td colspan="6">No hay solicitudes.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
