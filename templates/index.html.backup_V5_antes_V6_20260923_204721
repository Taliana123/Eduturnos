        linear-gradient(
            135deg,
            #0B2E55,
            #123B68
        );

    color: white;
}

.ed-v5-final::after {
    content: "EDU";

    position: absolute;

    right: -30px;
    bottom: -90px;

    color: rgba(255,255,255,.035);

    font:
        900 240px "Public Sans",
        sans-serif;

    letter-spacing: -.08em;
}

.ed-v5-final-inner {
    position: relative;
    z-index: 2;

    width: min(1320px, calc(100% - 64px));
    min-height: 350px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 60px;
}

.ed-v5-final h2 {
    max-width: 820px;

    margin: 0;

    color: white;

    font:
        600 clamp(42px, 5vw, 69px)/.98
        "Source Serif 4",
        Georgia,
        serif;

    letter-spacing: -.05em;
}

.ed-v5-final h2 span {
    color: var(--blue-light);
    font-style: italic;
}

.ed-v5-final-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;

    min-height: 54px;

    padding: 0 23px;

    flex-shrink: 0;

    background: var(--amber);
    color: var(--ink);

    text-decoration: none;

    font:
        800 11px "Public Sans",
        sans-serif;

    box-shadow:
        0 14px 30px rgba(0,0,0,.20);

    transition:
        transform .2s ease,
        background .2s ease;
}

.ed-v5-final-button:hover {
    color: var(--ink);

    background: #FFD477;

    transform: translateY(-2px);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {

    .ed-v5-hero-inner {
        grid-template-columns: 1fr;
        gap: 20px;
        padding-bottom: 70px;
    }

    .ed-v5-copy {
        padding-bottom: 20px;
    }

    .ed-v5-visual {
        min-height: 580px;
    }

    .ed-v5-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .ed-v5-statement-inner {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 75px 0;
    }
}

@media (max-width: 700px) {

    .ed-v5-nav,
    .ed-v5-hero-inner,
    .ed-v5-statement-inner,
    .ed-v5-services,
    .ed-v5-final-inner {
        width: calc(100% - 34px);
    }

    .ed-v5-nav {
        height: 70px;
    }

    .ed-v5-nav-right span {
        display: none;
    }

    .ed-v5-hero {
        min-height: auto;
    }

    .ed-v5-copy {
        padding-top: 55px;
    }

    .ed-v5-title {
        font-size: clamp(60px, 17vw, 90px);
    }

    .ed-v5-description {
        font-size: 14px;
    }

    .ed-v5-actions {
        flex-wrap: wrap;
    }

    .ed-v5-meta {
        margin-top: 38px;
    }

    .ed-v5-visual {
        min-height: 480px;
    }

    .ed-v5-orbit {
        width: 330px;
        height: 330px;
    }

    .ed-v5-card {
        padding: 23px;
    }

    .ed-v5-card h2 {
        font-size: 31px;
    }

    .ed-v5-floating.one {
        top: 25px;
        right: -3px;
    }

    .ed-v5-floating.two {
        left: -3px;
        bottom: 30px;
    }

    .ed-v5-blue-square {
        left: -7px;
        top: 70px;
        width: 60px;
        height: 60px;
    }

    .ed-v5-accent-square {
        right: -6px;
        bottom: 25px;
        width: 80px;
        height: 80px;
    }

    .ed-v5-services {
        padding: 75px 0 80px;
    }

    .ed-v5-services-head {
        display: block;
    }

    .ed-v5-services-head p {
        margin-top: 20px;
    }

    .ed-v5-grid {
        grid-template-columns: 1fr;
    }

    .ed-v5-service {
        min-height: 230px;
    }

    .ed-v5-final-inner {
        display: block;
        padding: 70px 0;
    }

    .ed-v5-final-button {
        margin-top: 32px;
    }
}

@media (prefers-reduced-motion: reduce) {

    .ed-v5-primary,
    .ed-v5-login,
    .ed-v5-service,
    .ed-v5-final-button {
        transition: none;
    }
}
</style>

