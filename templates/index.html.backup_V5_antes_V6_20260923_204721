}

.ed-v5-service:nth-child(3) {
    background: #F7F4FF;
}

.ed-v5-service:nth-child(4) {
    background: #F1FBF7;
}

.ed-v5-service-number {
    display: inline-flex;

    width: 34px;
    height: 34px;

    align-items: center;
    justify-content: center;

    background: var(--ink);

    color: white;

    font:
        800 9px "Public Sans",
        sans-serif;
}

.ed-v5-service-icon {
    position: absolute;

    right: 24px;
    top: 24px;

    color: var(--blue);

    font:
        400 23px "Public Sans",
        sans-serif;
}

.ed-v5-service h3 {
    margin: 75px 0 10px;

    color: var(--ink);

    font:
        800 18px "Public Sans",
        sans-serif;
}

.ed-v5-service p {
    margin: 0;

    color: #68819C;

    font:
        400 12px/1.7
        "Public Sans",
        sans-serif;
}

.ed-v5-service-line {
    position: absolute;

    left: 25px;
    bottom: 25px;

    width: 34px;
    height: 2px;

    background: var(--amber);
}

/* =========================================================
   FINAL CTA
   ========================================================= */

.ed-v5-final {
    position: relative;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 80% 25%,
            rgba(47,120,255,.24),
            transparent 27%
