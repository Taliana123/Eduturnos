    margin-top: 25px;

    border-top: 1px solid #DCEBFA;
}

.ed-v5-info-item {
    min-height: 70px;

    padding: 15px 0;

    border-bottom: 1px solid #DCEBFA;
}

.ed-v5-info-item:nth-child(odd) {
    margin-right: 20px;
    border-right: 1px solid #DCEBFA;
}

.ed-v5-info-label {
    display: block;

    margin-bottom: 7px;

    color: #91A5B9;

    font:
        800 8px "Public Sans",
        sans-serif;

    letter-spacing: .10em;
    text-transform: uppercase;
}

.ed-v5-info-value {
    color: var(--ink-2);

    font:
        800 11px "Public Sans",
        sans-serif;
}

.ed-v5-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 23px;
}

.ed-v5-date {
