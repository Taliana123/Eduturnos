        Georgia,
        serif;
}

.ed-v5-card-brand span {
    color: #91A5B9;

    font:
        700 7px "Public Sans",
        sans-serif;

    letter-spacing: .08em;
    text-transform: uppercase;
}

.ed-v5-accent-square {
    position: absolute;

    width: 105px;
    height: 105px;

    right: -24px;
    bottom: 38px;

    background: var(--amber);

    opacity: .92;
}

.ed-v5-blue-square {
    position: absolute;

    width: 74px;
    height: 74px;

    left: 6px;
    top: 110px;

    background: var(--blue);
}

/* =========================================================
   STATEMENT
   ========================================================= */

.ed-v5-statement {
    background: var(--ink);
    color: white;
}

.ed-v5-statement-inner {
    width: min(1320px, calc(100% - 64px));
    min-height: 390px;

    margin: 0 auto;

    display: grid;
    grid-template-columns: .55fr 1.45fr;
    align-items: center;
    gap: 70px;
}

.ed-v5-statement-label {
    color: var(--amber);

    font:
        800 10px "Public Sans",
        sans-serif;

    letter-spacing: .16em;
    text-transform: uppercase;
}

.ed-v5-statement h2 {
    max-width: 900px;

    margin: 0;

    color: white;

    font:
        500 clamp(39px, 5vw, 70px)/1.03
        "Source Serif 4",
        Georgia,
        serif;

    letter-spacing: -.045em;
}

.ed-v5-statement h2 em {
    color: var(--blue-light);
    font-style: italic;
}

/* =========================================================
   SERVICES
   ========================================================= */

.ed-v5-services {
    width: min(1320px, calc(100% - 64px));

    margin: 0 auto;

    padding: 105px 0 120px;
}

.ed-v5-services-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 50px;

    margin-bottom: 48px;
}

.ed-v5-services-head h2 {
    max-width: 700px;

    margin: 0;

    color: var(--ink);

    font:
        600 clamp(42px, 5vw, 67px)/.96
        "Source Serif 4",
        Georgia,
        serif;

    letter-spacing: -.05em;
}

.ed-v5-services-head p {
    max-width: 330px;

    margin: 0 0 5px;

    color: #69829D;

    font:
        400 13px/1.75
        "Public Sans",
        sans-serif;
}

.ed-v5-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.ed-v5-service {
