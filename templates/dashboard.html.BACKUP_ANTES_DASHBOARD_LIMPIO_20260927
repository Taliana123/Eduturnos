/* El dashboard no debe tener un panel gris detrás */
body:has(.dashboard-page) .dashboard-page {
    background: transparent !important;
}

/* Evita que un contenedor de base cree otro panel */
body:has(.dashboard-page) .dashboard-main {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
}

/* ---------------------------------------------------------
   CABECERA
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-head {
    background:
        radial-gradient(
            circle at 84% 17%,
            rgba(242,184,75,.20),
            transparent 24%
        ),
        radial-gradient(
            circle at 8% 100%,
            rgba(35,102,143,.28),
            transparent 32%
        ),
        linear-gradient(
            135deg,
            #172942 0%,
            #1c3855 52%,
            #23668f 100%
        ) !important;

    border: 1px solid rgba(255,255,255,.08) !important;
    box-shadow:
        0 18px 45px rgba(23,41,66,.15),
        0 2px 0 rgba(255,255,255,.04) inset !important;
}

/* Etiqueta de rol */
body:has(.dashboard-page) .dashboard-head-info .badge {
    background: rgba(255,255,255,.10) !important;
    border: 1px solid rgba(255,255,255,.10) !important;
    color: #ffd36a !important;
}

/* Título */
body:has(.dashboard-page) .dashboard-head-info h1 {
    color: #ffffff !important;
}

/* Texto */
body:has(.dashboard-page) .dashboard-head-info p {
    color: #dce8f1 !important;
}

/* ---------------------------------------------------------
   BOTÓN CERRAR SESIÓN
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-logout {
    background: #d85d58 !important;
    border: 1px solid rgba(255,255,255,.10) !important;
    color: #ffffff !important;
    box-shadow:
        0 7px 18px rgba(0,0,0,.14) !important;
    transition:
        transform .22s ease,
        box-shadow .22s ease,
        filter .22s ease !important;
}

body:has(.dashboard-page) .dashboard-logout:hover {
    transform: translateY(-2px) !important;
    filter: brightness(1.04) !important;
    box-shadow:
        0 11px 24px rgba(0,0,0,.18) !important;
}

/* ---------------------------------------------------------
   ILUSTRACIÓN ABSTRACTA
   Conservamos su animación original.
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-role-art::before {
    border-color: rgba(255,255,255,.18) !important;
}

body:has(.dashboard-page) .dashboard-role-art::after {
    border-color: rgba(255,255,255,.15) !important;
}

/* ---------------------------------------------------------
   INDICADORES
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-kpi {
    background: #ffffff !important;
    border-color: #e1e8ef !important;
    box-shadow:
        0 7px 22px rgba(23,41,66,.055) !important;
    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
}

body:has(.dashboard-page) .dashboard-kpi:hover {
    transform: translateY(-2px) !important;
    border-color: #c9ddeb !important;
    box-shadow:
        0 12px 28px rgba(23,41,66,.09) !important;
}

body:has(.dashboard-page) .dashboard-kpi span {
    color: #718094 !important;
}

body:has(.dashboard-page) .dashboard-kpi strong {
    color: #172942 !important;
}

/* ---------------------------------------------------------
   TÍTULOS DE SECCIÓN
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-card-head .badge {
    color: #1769aa !important;
}

body:has(.dashboard-page) .dashboard-card-head h2 {
    color: #172942 !important;
}

body:has(.dashboard-page) .dashboard-card-head p {
    color: #718094 !important;
}

/* ---------------------------------------------------------
   TARJETAS DE ACCIONES
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-action {
    background: #ffffff !important;
    border-color: #dce5ed !important;

    box-shadow:
        0 8px 25px rgba(23,41,66,.055) !important;

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
}

/* Línea institucional azul + ámbar */
body:has(.dashboard-page) .dashboard-action::before {
    background:
        linear-gradient(
            90deg,
            #1769aa,
            #2b83bd,
            #f2b84b
        ) !important;
}

/* Hover original conservado */
body:has(.dashboard-page) .dashboard-action:hover {
    transform: translateY(-4px) !important;
    border-color: #b8d3e8 !important;
    box-shadow:
        0 16px 32px rgba(23,41,66,.11) !important;
}

/* Etiqueta interna */
body:has(.dashboard-page) .dashboard-action-icon {
    background: #e8f3fb !important;
    color: #1769aa !important;
    border: 1px solid rgba(23,105,170,.08) !important;
}

/* Título */
body:has(.dashboard-page) .dashboard-action h3 {
    color: #172942 !important;
}

/* Descripción */
body:has(.dashboard-page) .dashboard-action p {
    color: #718094 !important;
}

/* Enlace */
body:has(.dashboard-page) .dashboard-action-link {
    color: #1769aa !important;
}

/* ---------------------------------------------------------
   CUENTA
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-account-card {
    background: #ffffff !important;
    border: 1px solid #dce5ed !important;
    box-shadow:
        0 8px 25px rgba(23,41,66,.055) !important;
}

body:has(.dashboard-page) .dashboard-account-text {
    color: #68798a !important;
}

body:has(.dashboard-page) .dashboard-account-action .boton-full {
    background: #1769aa !important;
    color: #ffffff !important;
    border: 1px solid #1769aa !important;
    box-shadow:
        0 7px 18px rgba(23,105,170,.16) !important;

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        background .22s ease !important;
}

body:has(.dashboard-page) .dashboard-account-action .boton-full:hover {
    background: #155f99 !important;
    transform: translateY(-2px) !important;
    box-shadow:
        0 11px 24px rgba(23,105,170,.20) !important;
}

/* ---------------------------------------------------------
   UNIFORMIDAD TIPOGRÁFICA
   --------------------------------------------------------- */

body:has(.dashboard-page) .dashboard-head-info h1,
body:has(.dashboard-page) .dashboard-card-head h2,
body:has(.dashboard-page) .dashboard-action h3 {
    font-family:
        "Source Serif 4",
        Georgia,
        serif !important;
}

/* ---------------------------------------------------------
   RESPONSIVE
   Solo conserva el comportamiento existente.
   --------------------------------------------------------- */

@media (max-width: 950px) {

    body:has(.dashboard-page) .dashboard-page {
        background: transparent !important;
    }

    body:has(.dashboard-page) .dashboard-action {
        background: #ffffff !important;
    }

    body:has(.dashboard-page) .dashboard-kpi {
        background: #ffffff !important;
    }
}

@media (max-width: 650px) {

    body:has(.dashboard-page) .dashboard-head {
        box-shadow:
            0 12px 30px rgba(23,41,66,.13) !important;
    }
}

