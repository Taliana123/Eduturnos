<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#165dca"><meta name="description" content="EDUTURNOS: gestión institucional de citaciones escolares">
<link rel="manifest" href="{{ url_for('static',filename='manifest.webmanifest') }}"><title>{% block title %}EDUTURNOS{% endblock %}</title><link rel="stylesheet" href="{{ url_for('static',filename='css/estilos.css') }}">


<!-- EDUTURNOS_ESTILO_FIJO -->

<style id="eduturnos-estilo-fijo">

/* =========================================================
   EDUTURNOS - ESTILO VISUAL FIJO
   ========================================================= */

/* Todo calcula sus tamaños correctamente */
#contenido,
#contenido *,
#contenido *::before,
#contenido *::after {
    box-sizing: border-box;
}

/* =========================================================
   TARJETAS Y FORMULARIOS
   ========================================================= */

#contenido .formulario {
    width: 100% !important;
    padding: 20px 0 !important;
}

#contenido .form-card,
#contenido .tarjeta {
    width: 100% !important;
    max-width: 850px !important;

    margin-left: auto !important;
    margin-right: auto !important;

    padding: 30px !important;

    border-radius: 14px !important;
}

/* =========================================================
   ENCABEZADO
   ========================================================= */

#contenido .section-heading {
    width: 100% !important;

    margin: 0 0 26px 0 !important;

    padding: 0 !important;
}

#contenido .section-heading .badge {
    display: inline-block !important;
    margin-bottom: 10px !important;
}

#contenido .section-heading h1 {
    display: block !important;

    width: 100% !important;

    margin: 0 0 10px 0 !important;

    line-height: 1.2 !important;
}

#contenido .section-heading p {
    display: block !important;

    width: 100% !important;

    margin: 0 !important;

    line-height: 1.55 !important;
}

/* =========================================================
   FORMULARIO PRINCIPAL
   ========================================================= */

#contenido form.stack-form,
#contenido form.form-uniform {
    width: 100% !important;

    display: flex !important;

    flex-direction: column !important;

    gap: 20px !important;

    margin: 0 !important;
}

/* =========================================================
   CADA CAMPO
   ========================================================= */

#contenido form.stack-form > label,
#contenido form.form-uniform > label {
    width: 100% !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: stretch !important;

    justify-content: flex-start !important;

    gap: 7px !important;

    margin: 0 !important;
    padding: 0 !important;

    line-height: 1.3 !important;

    font-size: 14px !important;
}

/* =========================================================
   CAMPOS DE TEXTO
   ========================================================= */

#contenido form.stack-form input:not([type="checkbox"]):not([type="radio"]),
#contenido form.stack-form select,
#contenido form.stack-form textarea,

#contenido form.form-uniform input:not([type="checkbox"]):not([type="radio"]),
#contenido form.form-uniform select,
#contenido form.form-uniform textarea {

    display: block !important;

    width: 100% !important;
    max-width: 100% !important;

    min-height: 46px !important;

    margin: 0 !important;

    padding: 11px 14px !important;

    border-radius: 9px !important;

    font-size: 15px !important;

    font-weight: 400 !important;

    line-height: 1.3 !important;
}

/* =========================================================
   PERSONAL INSTITUCIONAL
   ========================================================= */

#contenido .personal-login {
    width: 100% !important;

    margin: 4px 0 0 0 !important;

    padding: 22px !important;

    border: 1px solid #dbe3ee !important;

    border-radius: 12px !important;

    background: #f8fafc !important;
}

#contenido .personal-login h3 {
    display: block !important;

    width: 100% !important;

    margin: 0 0 8px 0 !important;

    padding: 0 !important;

    line-height: 1.2 !important;
}

#contenido .personal-login > p {
    display: block !important;

    width: 100% !important;

    margin: 0 0 22px 0 !important;

    line-height: 1.55 !important;
}

/* =========================================================
   LOS TRES CAMPOS:
   CÓDIGO | SEDE | JORNADA
   ========================================================= */

#contenido .personal-login .form-grid {

    display: grid !important;

    grid-template-columns:
        repeat(3, minmax(0, 1fr)) !important;

    column-gap: 20px !important;

    row-gap: 20px !important;

    width: 100% !important;

    align-items: start !important;

    margin: 0 !important;

    padding: 0 !important;
}

#contenido .personal-login .form-grid > label {

    width: 100% !important;

    min-width: 0 !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: stretch !important;

    justify-content: flex-start !important;

    gap: 7px !important;

    margin: 0 !important;

    padding: 0 !important;

    line-height: 1.3 !important;

    font-size: 14px !important;

    font-weight: 600 !important;
}

/* =========================================================
   TÍTULOS DE CÓDIGO / SEDE / JORNADA
   ========================================================= */

#contenido .personal-login .form-grid > label:first-child,
#contenido .personal-login .form-grid > label:nth-child(2),
#contenido .personal-login .form-grid > label:nth-child(3) {

    align-self: start !important;
}

/* =========================================================
   QUITAR EL PEQUEÑO TEXTO DE APOYO DEL TÍTULO
   ========================================================= */

#contenido .personal-login label small {
    display: none !important;
}

/* =========================================================
   CAMPOS DE PERSONAL INSTITUCIONAL
   ========================================================= */

#contenido .personal-login input,
#contenido .personal-login select {

    width: 100% !important;

    min-width: 0 !important;

    min-height: 46px !important;

    margin: 0 !important;

    padding: 11px 14px !important;

    background: #ffffff !important;

    border-radius: 9px !important;

    font-size: 15px !important;

    font-weight: 400 !important;

    line-height: 1.3 !important;
}

/* =========================================================
   LISTAS
   ========================================================= */

#contenido select {
    font-weight: 400 !important;
}

#contenido select option {
    font-weight: 400 !important;
}

/* =========================================================
   BOTÓN
   ========================================================= */

#contenido form.stack-form > button,
#contenido form.form-uniform > button {

    width: 100% !important;

    min-height: 48px !important;

    margin: 2px 0 0 0 !important;

    padding: 12px 18px !important;

    border-radius: 9px !important;

    font-size: 15px !important;

    font-weight: 600 !important;
}

/* =========================================================
   ENLACES
   ========================================================= */

#contenido .form-links {

    display: flex !important;

    justify-content: center !important;

    align-items: center !important;

    flex-wrap: wrap !important;

    gap: 18px !important;

    width: 100% !important;

    margin-top: 20px !important;
}

#contenido .form-links a {
    line-height: 1.4 !important;
}

/* =========================================================
   OTROS FORMULARIOS DEL SITIO
   ========================================================= */

#contenido form:not(.inline-form) label {

    line-height: 1.3 !important;
}

#contenido form:not(.inline-form) {

    max-width: 100% !important;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

    #contenido .personal-login .form-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 600px) {

    #contenido .form-card,
    #contenido .tarjeta {

        padding: 20px !important;
    }

    #contenido .personal-login {

        padding: 18px !important;
    }

    #contenido .personal-login .form-grid {

        grid-template-columns: 1fr !important;

        gap: 16px !important;
    }

    #contenido .form-links {

        flex-direction: column !important;

        gap: 10px !important;
    }
}

/* =========================================================
   FIN ESTILO FIJO
   ========================================================= */

</style>
<!-- FIN EDUTURNOS_ESTILO_FIJO -->



<!-- EDUTURNOS_AJUSTE_SEDE_COMPLETA -->
<style id="eduturnos-ajuste-sede">

/* =========================================================
   EDUTURNOS - SEDE SIN TEXTO CORTADO
   ========================================================= */

/* Hacer más ancha la tarjeta donde están los tres campos */
#contenido .form-card {
    max-width: 1050px !important;
}

/* Código | Sede | Jornada */
#contenido .personal-login .form-grid {
    display: grid !important;

    grid-template-columns:
        200px minmax(360px, 1fr) 190px !important;

    column-gap: 20px !important;
    row-gap: 20px !important;

    width: 100% !important;
}

/* Sede */
#contenido .personal-login .form-grid > label:nth-child(2) {
    min-width: 0 !important;
    width: 100% !important;
}

/* El cuadro de Sede debe ocupar todo el espacio disponible */
#contenido .personal-login .form-grid > label:nth-child(2) select {
    width: 100% !important;
    min-width: 0 !important;

    padding-left: 12px !important;
    padding-right: 12px !important;

    font-size: 14px !important;
    font-weight: 400 !important;

    white-space: nowrap !important;
}

/* También mejora el campo de Jornada */
#contenido .personal-login .form-grid > label:nth-child(3) select {
    width: 100% !important;
    min-width: 0 !important;

    font-size: 14px !important;
    font-weight: 400 !important;
}

/* Código */
#contenido .personal-login .form-grid > label:nth-child(1) input {
    width: 100% !important;
    min-width: 0 !important;
}

/* En pantallas medianas se distribuyen mejor */
@media (max-width: 950px) {

    #contenido .personal-login .form-grid {
        grid-template-columns:
            1fr 1.5fr 1fr !important;
    }

}

/* En móvil, una debajo de otra */
@media (max-width: 650px) {

    #contenido .form-card {
        max-width: 100% !important;
    }

    #contenido .personal-login .form-grid {
        grid-template-columns: 1fr !important;
    }

}

</style>
<!-- FIN EDUTURNOS_AJUSTE_SEDE_COMPLETA -->



