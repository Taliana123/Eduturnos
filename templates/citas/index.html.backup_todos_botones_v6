{% extends 'base.html' %}

{% block title %}Citas · EDUTURNOS{% endblock %}

{% block content %}

<section class="page-head">

    <div>

        <div class="page-navigation">
            <a
                class="link-back"
                href="{{ request.referrer or url_for('auth.dashboard') }}"
            >
                ← Atrás
            </a>
        </div>

        <h1>Citas</h1>

        <p>
            Consulta y administra las citaciones según tu rol.
        </p>

    </div>


    {% if puede_crear %}

    <a
        class="boton"
        href="{{ url_for('citas.nueva') }}"
    >
        + Nueva citación
    </a>

    {% endif %}

</section>


<div class="table-wrap">

    <table>

        <thead>

            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Estudiante</th>
                <th>Docente</th>
                <th>Acudiente</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Lugar</th>
                <th>Observaciones</th>
            </tr>

        </thead>


        <tbody>

            {% for c in citas %}

            <tr>

                <td>{{ c.fecha }}</td>

                <td>{{ c.hora }}</td>

                <td>{{ c.estudiante }}</td>

                <td>{{ c.docente }}</td>

                <td>{{ c.acudiente }}</td>

                <td>{{ c.motivo }}</td>

                <td>
                    <span class="badge">
                        {{ c.estado }}
                    </span>
                </td>

                <td>{{ c.lugar }}</td>


                <td>

                    {% if rol in [
                        'Super Admin',
                        'Rector',
                        'Administrador / Coordinador',
                        'Docente'
                    ] %}

                    <a
                        href="{{ url_for(
                            'seguimiento.registrar',
                            id=c.id
                        ) }}"
                    >
                        Seguimiento
                    </a>

                    {% endif %}


                    {% if rol == 'Acudiente'
                          and c.estado == 'Pendiente' %}

                    <form
                        method="post"
                        action="{{ url_for(
                            'citas.cambiar_estado',
                            cita_id=c.id
                        ) }}"
                        class="inline-form"
                    >

                        {{ csrf_field()|safe }}

                        <input
                            type="hidden"
                            name="estado"
                            value="Confirmada"
                        >

                        <button type="submit">
                            Confirmar
                        </button>

                    </form>

                    {% endif %}

                </td>

            </tr>

            {% else %}

            <tr>

                <td colspan="9">
                    No hay citas para mostrar.
                </td>

            </tr>

            {% endfor %}

        </tbody>

    </table>

</div>



<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}