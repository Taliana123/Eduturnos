{% extends 'base.html' %}{% block content %}<div class="page-head"><h1>Nueva citación</h1></div><form method="post" class="panel form-grid">{{ csrf_field()|safe }}
<label>Estudiante<select name="id_estudiante" required>
<option value="" selected disabled hidden></option>
{% for e in estudiantes %}<option value="{{ e.id_estudiante }}">{{ e.nombre }} · {{ e.documento }}{% if e.detalle %} · {{ e.detalle }}{% endif %}</option>{% endfor %}</select></label>
<label>Docente<select name="id_docente" required>
<option value="" selected disabled hidden></option>
{% for d in docentes %}<option value="{{ d.id_docente }}">{{ d.nombre }}</option>{% endfor %}</select></label>
<label>Acudiente<select name="id_acudiente" required>
<option value="" selected disabled hidden></option>
{% for a in acudientes %}<option value="{{ a.id_acudiente }}">{{ a.nombre }}</option>{% endfor %}</select></label>
<label>Motivo<select name="id_motivo" required>
<option value="" selected disabled hidden></option>
{% for m in motivos %}<option value="{{ m.id }}">{{ m.nombre }}</option>{% endfor %}</select></label>
<label>Periodo<select name="id_periodo" required>
<option value="" selected disabled hidden></option>
{% for p in periodos %}<option value="{{ p.id }}">{{ p.nombre }}</option>{% endfor %}</select></label>
<label>Fecha<input type="date" name="fecha" required></label><label>Hora<input type="time" name="hora" required></label><label>Lugar<input name="lugar" required placeholder="Ej. Coordinación"></label>
<label class="full-field">Observaciones<textarea name="observaciones"></textarea></label><div class="full-field"><button class="boton">Crear citación</button> <a class="boton secundario" href="{{ url_for('citas.index') }}">Cancelar</a></div></form>{% endblock %}

