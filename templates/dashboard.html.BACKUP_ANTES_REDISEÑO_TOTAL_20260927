{% extends 'base.html' %}

{% block title %}Panel · EDUTURNOS{% endblock %}

{% block content %}

<section class="dashboard-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="dashboard-head">

        <div class="dashboard-head-info">
<div class="dashboard-role-art" aria-hidden="true">
    {% if usuario.rol_nombre == 'Rector' %}
        <div class="role-symbol role-rectoria">
            <span></span><i></i><b></b>
        </div>
    {% elif usuario.rol_nombre == 'Estudiante' %}
        <div class="role-symbol role-estudiante">
            <span></span><i></i><b></b>
        </div>
    {% elif usuario.rol_nombre == 'Acudiente' %}
        <div class="role-symbol role-acudiente">
            <span></span><i></i><b></b>
        </div>
    {% elif usuario.rol_nombre == 'Docente' %}
        <div class="role-symbol role-docente">
            <span></span><i></i><b></b>
        </div>
    {% elif usuario.rol_nombre == 'Administrador / Coordinador' %}
        <div class="role-symbol role-coordinador">
            <span></span><i></i><b></b>
        </div>
    {% else %}
        <div class="role-symbol role-default">
            <span></span><i></i><b></b>
        </div>
    {% endif %}
</div>

            <span class="badge">
                {{ usuario.rol_nombre }}
            </span>

            <h1>
                Hola, {{ usuario.nombres }} {{ usuario.apellidos }}
            </h1>

            <p class="muted">
                Información y accesos según tu rol institucional.
            </p>

        </div>

        <div class="dashboard-head-action">

            <a
                class="boton boton-danger dashboard-logout"
                href="{{ url_for('auth.logout') }}"
            >
                Cerrar sesión
            </a>

        </div>

    </div>


    <!-- =====================================================
         INDICADORES
         ===================================================== -->

    <section class="dashboard-kpis">

        <article class="dashboard-kpi">
            <span>Total de citas</span>
            <strong>{{ datos.total_citas }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Pendientes</span>
            <strong>{{ datos.pendientes }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Confirmadas</span>
            <strong>{{ datos.confirmadas }}</strong>
        </article>

        <article class="dashboard-kpi">
            <span>Notificaciones sin leer</span>
            <strong>{{ notificaciones_no_leidas }}</strong>
        </article>

    </section>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="dashboard-main">

        <!-- ACCIONES -->
        <section class="dashboard-card dashboard-actions-card">

            <div class="dashboard-card-head">

                <div>
                    <span class="badge">Accesos</span>

                    <h2>Acciones rápidas</h2>

                    <p class="muted">
                        Accede directamente a las funciones disponibles para tu rol.
                    </p>
                </div>

            </div>


            <div class="dashboard-action-grid">

                <!-- CITAS -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('citas.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Citas
                        </span>
                    </div>

                    <h3>Citas</h3>

                    <p>
                        Consultar y gestionar citaciones.
                    </p>

                    <span class="dashboard-action-link">
                        Ver citas →
                    </span>

                </a>


                <!-- CALENDARIO -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('calendario.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Calendario
                        </span>
                    </div>

                    <h3>Calendario</h3>

                    <p>
                        Revisar fechas y horarios.
                    </p>

                    <span class="dashboard-action-link">
                        Abrir calendario →
                    </span>

                </a>


                <!-- NOTIFICACIONES -->

                <a
                    class="dashboard-action"
                    href="{{ url_for('notificaciones.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Avisos
                        </span>
                    </div>

                    <h3>Notificaciones</h3>

                    <p>
                        Ver avisos y novedades del sistema.
                    </p>

                    {% if notificaciones_no_leidas > 0 %}

                    <span class="dashboard-action-link">
                        {{ notificaciones_no_leidas }} sin leer →
                    </span>

                    {% else %}

                    <span class="dashboard-action-link">
                        Ver notificaciones →
                    </span>

                    {% endif %}

                </a>


                <!-- SOLICITUDES -->

                {% if usuario.rol_nombre in [
                    'Docente',
                    'Administrador / Coordinador',
                    'Rector',
                    'Super Admin'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('solicitudes.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Solicitudes
                        </span>
                    </div>

                    <h3>Solicitudes</h3>

                    <p>
                        Gestionar reuniones y propuestas.
                    </p>

                    <span class="dashboard-action-link">
                        Ver solicitudes →
                    </span>

                </a>

                {% endif %}


                <!-- REPORTES -->

                {% if usuario.rol_nombre in [
                    'Administrador / Coordinador',
                    'Rector',
                    'Super Admin'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('reportes.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Reportes
                        </span>
                    </div>

                    <h3>Reportes</h3>

                    <p>
                        Consultar indicadores institucionales.
                    </p>

                    <span class="dashboard-action-link">
                        Ver reportes →
                    </span>

                </a>

                {% endif %}


                <!-- JUSTIFICACIONES -->

                {% if usuario.rol_nombre in [
                    'Estudiante',
                    'Acudiente'
                ] %}

                <a
                    class="dashboard-action"
                    href="{{ url_for('justificaciones.index') }}"
                >

                    <div class="dashboard-action-top">
                        <span class="dashboard-action-icon">
                            Justificaciones
                        </span>
                    </div>

                    <h3>Justificaciones</h3>

                    <p>
                        Consultar o presentar solicitudes.
                    </p>

                    <span class="dashboard-action-link">
                        Ver justificaciones →
                    </span>

                </a>

                {% endif %}

            </div>

        </section>


        <!-- CUENTA -->

        <section class="dashboard-card dashboard-account-card">

            <div class="dashboard-card-head">

                <div>
                    <span class="badge">Cuenta</span>

                    <h2>Mi cuenta</h2>
                </div>

            </div>

            <p class="muted dashboard-account-text">
                Mantén una contraseña personal segura y actualizada.
            </p>

            <div class="dashboard-account-action">

                <a
                    class="boton boton-full"
                    href="{{ url_for('passwords.cambiar_password') }}"
                >
                    Cambiar contraseña
                </a>

            </div>

        </section>

    </div>

</section>
<!-- EDUTURNOS - ESPACIADO TITULOS DASHBOARD -->
<!-- FIN EDUTURNOS - ESPACIADO TITULOS DASHBOARD -->



<!-- EDUTURNOS_ACCESOS_ANIMADOS -->
<!-- FIN EDUTURNOS_ACCESOS_ANIMADOS -->


<style id="EDUTURNOS_DASHBOARD_UNICO">

/* =========================================================
   EDUTURNOS · DASHBOARD
   MISMA IDENTIDAD VISUAL DE INICIO / LOGIN / REGISTRO
   ========================================================= */

.dashboard-page {
    width: min(1180px, calc(100% - 44px));
    margin: 34px auto 64px;
    color: #172942;
}

/* =========================================================
   CABECERA
   ========================================================= */

.dashboard-head {
    position: relative;
    min-height: 238px;
    padding: 34px 38px;
    display: flex;
    align-items: center;
    gap: 24px;
    overflow: hidden;
    border-radius: 24px;
    color: #ffffff;

    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(242,184,75,.18),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #172942 0%,
            #1d3b5a 55%,
            #23668f 100%
        );

    box-shadow:
        0 16px 38px rgba(23,41,66,.14);
}

.dashboard-head::before {
    content: "";
    position: absolute;
    width: 360px;
    height: 360px;
    right: -145px;
    top: -205px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.10);
}

.dashboard-head::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -75px;
    bottom: -145px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
}

.dashboard-head-info {
    position: relative;
    z-index: 2;
    max-width: 620px;
}

.dashboard-head-info .badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;

    background: rgba(255,255,255,.10);
    color: #ffd36a;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
}

.dashboard-head-info h1 {
    margin: 12px 0 8px !important;

    color: #ffffff !important;

    font-family: "Source Serif 4", Georgia, serif;
    font-size: clamp(31px, 3.8vw, 44px);
    line-height: 1.04;
    letter-spacing: -.025em;
}

.dashboard-head-info p {
    margin: 0;

    color: #d9e7f2 !important;

    font-size: 14px;
    line-height: 1.5;
}

.dashboard-head-action {
    position: relative;
    z-index: 5;

    margin-left: auto;
    align-self: flex-start;
}

.dashboard-logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;
    padding: 0 17px;

    border-radius: 11px;

    background: #d85d58 !important;
    color: #ffffff !important;

    text-decoration: none;
    font-size: 13px;
    font-weight: 700;

    box-shadow: 0 7px 18px rgba(0,0,0,.12);

    transition:
        transform .20s ease,
        box-shadow .20s ease;
}

.dashboard-logout:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(0,0,0,.17);
}

/* =========================================================
   ILUSTRACIÓN ABSTRACTA DEL ROL
   ========================================================= */

.dashboard-role-art {
    position: absolute;
    right: 145px;
    top: 24px;

    width: 175px;
    height: 175px;

    z-index: 1;
}

.dashboard-role-art::before {
    content: "";

    position: absolute;
    inset: 7px;

    border: 1px solid rgba(255,255,255,.18);
    border-radius: 50%;
}

.dashboard-role-art::after {
    content: "";

    position: absolute;
    inset: 27px;

    border: 1px dashed rgba(255,255,255,.14);
    border-radius: 50%;

    animation: giroRol 18s linear infinite;
}

.role-symbol {
    position: absolute;
    inset: 0;
}

.role-symbol span {
    position: absolute;

    left: 50px;
    top: 49px;

    width: 72px;
    height: 72px;

    border-radius: 22px;
    background: #f2b84b;

    transform: rotate(18deg);

    box-shadow:
        0 15px 28px rgba(0,0,0,.17);
}

.role-symbol i {
    position: absolute;

    left: 30px;
    top: 80px;

    width: 22px;
    height: 22px;

    border-radius: 50%;
    background: #7fc4ed;
}

.role-symbol b {
    position: absolute;

    right: 26px;
    top: 32px;

    width: 13px;
    height: 13px;

    border-radius: 50%;
    background: #ffffff;
}

.role-rectoria span {
    border-radius: 12px 12px 28px 28px;
}

.role-estudiante span {
    border-radius: 50%;
    transform: rotate(0);
}

.role-acudiente span {
    border-radius: 50% 18px 50% 18px;
}

.role-docente span {
    border-radius: 8px;
    transform: rotate(45deg);
}

.role-coordinador span {
    clip-path: polygon(
        50% 0,
        100% 25%,
        82% 100%,
        18% 100%,
        0 25%
    );

    border-radius: 0;
    transform: rotate(0);
}

.role-default span {
    border-radius: 22px;
}

@keyframes giroRol {
    from {
        transform: rotate(0);
    }

    to {
        transform: rotate(360deg);
    }
}

/* =========================================================
   INDICADORES
   ========================================================= */

.dashboard-kpis {
    display: grid !important;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 14px;

    margin: 20px 0 48px !important;
}

.dashboard-kpi {
    padding: 18px 19px;

    border: 1px solid #dce5ed;
    border-radius: 15px;

    background: #ffffff;

    box-shadow:
        0 6px 20px rgba(23,41,66,.045);

    transition:
        transform .20s ease,
        box-shadow .20s ease,
        border-color .20s ease;
}

.dashboard-kpi:hover {
    transform: translateY(-2px);

    border-color: #c4d9e8;

    box-shadow:
        0 10px 25px rgba(23,41,66,.075);
}

.dashboard-kpi span {
    color: #718094 !important;

    font-size: 12px;
    line-height: 1.3;
}

.dashboard-kpi strong {
    display: block;

    margin-top: 7px;

    color: #172942 !important;

    font-size: 27px;
    line-height: 1;
}

/* =========================================================
   TITULARES
   ========================================================= */

.dashboard-card {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;

    padding: 0 !important;
}

.dashboard-card-head {
    margin-bottom: 20px !important;
}

.dashboard-card-head .badge {
    color: #1769aa;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .13em;
}

.dashboard-card-head h2 {
    margin: 7px 0 6px !important;

    color: #172942 !important;

    font-family: "Source Serif 4", Georgia, serif;
    font-size: 29px;
    line-height: 1.1;
}

.dashboard-card-head p {
    color: #718094 !important;

    font-size: 13px;
}

/* =========================================================
   ACCIONES RÁPIDAS
   ========================================================= */

.dashboard-action-grid {
    display: grid !important;

    grid-template-columns:
        repeat(3, minmax(0, 1fr)) !important;

    gap: 16px !important;
}

.dashboard-action {
    position: relative;

    min-height: 190px !important;

    padding: 21px !important;

    display: flex !important;
    flex-direction: column;

    border: 1px solid #dce5ed !important;
    border-radius: 18px !important;

    background: #ffffff !important;

    box-shadow:
        0 7px 23px rgba(23,41,66,.045) !important;

    text-decoration: none !important;

    overflow: hidden;

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
}

.dashboard-action::before {
    content: "";

    position: absolute;

    top: 0;
    left: 18px;
    right: 18px;

    height: 3px;

    border-radius: 0 0 8px 8px;

    background:
        linear-gradient(
            90deg,
            #1769aa,
            #f2b84b
        );
}

.dashboard-action:hover {
    transform: translateY(-4px) !important;

    border-color: #b8d3e8 !important;

    box-shadow:
        0 14px 30px rgba(23,41,66,.10) !important;
}

.dashboard-action-top {
    position: relative;
    z-index: 1;
}

.dashboard-action-icon {
    width: fit-content;

    min-height: 30px;

    padding: 6px 10px !important;

    display: inline-flex;
    align-items: center;

    border-radius: 8px !important;

    background: #e8f3fb !important;
    color: #1769aa !important;

    font-size: 11px !important;
    font-weight: 800 !important;
}

.dashboard-action h3 {
    margin: 16px 0 7px !important;

    color: #172942 !important;

    font-family: "Source Serif 4", Georgia, serif;
    font-size: 22px !important;
    line-height: 1.1;
}

.dashboard-action p {
    flex: 1;

    margin: 0 !important;

    color: #718094 !important;

    font-size: 13px !important;
    line-height: 1.48 !important;
}

.dashboard-action-link {
    margin-top: 15px !important;

    color: #1769aa !important;

    font-size: 13px;
    font-weight: 800 !important;
}

/* =========================================================
   MI CUENTA
   ========================================================= */

.dashboard-account-card {
    margin-top: 28px;

    padding: 24px !important;

    border-radius: 19px !important;

    background: #edf5fa !important;

    border: 1px solid #dcebf4 !important;
}

.dashboard-account-text {
    color: #68798a !important;

    font-size: 13px;
}

.dashboard-account-action {
    max-width: 270px;
}

.dashboard-account-action .boton-full {
    background: #1769aa !important;
    color: #ffffff !important;

    border-radius: 11px !important;

    transition:
        transform .20s ease,
        box-shadow .20s ease;
}

.dashboard-account-action .boton-full:hover {
    transform: translateY(-2px);

    box-shadow:
        0 9px 20px rgba(23,105,170,.18);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 950px) {

    .dashboard-role-art {
        opacity: .45;
        right: 50px;
    }

    .dashboard-action-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
    }

    .dashboard-kpis {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {

    .dashboard-page {
        width: calc(100% - 24px);
        margin-top: 20px;
    }

    .dashboard-head {
        padding: 27px 23px;

        min-height: 235px;

        flex-direction: column;
        align-items: flex-start;
    }

    .dashboard-role-art {
        display: none;
    }

    .dashboard-head-action {
        margin-left: 0;
        align-self: stretch;
    }

    .dashboard-logout {
        width: 100%;
    }

    .dashboard-action-grid,
    .dashboard-kpis {
        grid-template-columns: 1fr !important;
    }

    .dashboard-account-action {
        max-width: none;
    }
}

@media (prefers-reduced-motion: reduce) {

    .dashboard-role-art::after {
        animation: none;
    }

    .dashboard-action,
    .dashboard-kpi,
    .dashboard-logout,
    .dashboard-account-action .boton-full {
        transition: none !important;
    }
}

</style>

{% endblock %}