{% extends 'base.html' %}{% block content %}<h1>{{ 'Editar' if estudiante else 'Nuevo' }} estudiante</h1><form method="post" class="panel form-grid">{{ csrf_field()|safe }}
<label>Código estudiantil<input name="codigo" value="{{ estudiante.codigo_estudiantil if estudiante else '' }}" required></label><label>Tipo documento<select name="tipo_documento">
<option value="" selected disabled hidden></option>
<option value="CC" {% if not estudiante or estudiante.tipo_documento=='CC' %}selected{% endif %}>Cédula de ciudadanía</option><option value="TI" {% if estudiante and estudiante.tipo_documento=='TI' %}selected{% endif %}>Tarjeta de identidad</option><option value="CE" {% if estudiante and estudiante.tipo_documento=='CE' %}selected{% endif %}>Cédula de extranjería</option></select></label><label>Documento<input name="documento" value="{{ estudiante.documento if estudiante else '' }}" required></label><label>Nombres<input name="nombres" value="{{ estudiante.nombres if estudiante else '' }}" required></label><label>Apellidos<input name="apellidos" value="{{ estudiante.apellidos if estudiante else '' }}" required></label><label>Curso<input name="curso" value="{{ estudiante.curso if estudiante else '' }}" placeholder="Ej. 11A"></label>
<label>Sede<select name="sede" required>
<option value="" selected disabled hidden></option>
{% for s in catalogos.sedes %}<option value="{{ s.id }}" {% if estudiante and estudiante.id_sede==s.id %}selected{% endif %}>{{ s.nombre }}</option>{% endfor %}</select></label><label>Jornada<select name="jornada" required>
<option value="" selected disabled hidden></option>
{% for j in catalogos.jornadas %}<option value="{{ j.id }}" {% if estudiante and estudiante.id_jornada==j.id %}selected{% endif %}>{{ j.nombre }}</option>{% endfor %}</select></label><label>Grado<select name="grado">
<option value="" selected disabled hidden></option>
{% for g in catalogos.grados %}<option value="{{ g.id }}" {% if estudiante and estudiante.id_grado==g.id %}selected{% endif %}>{{ g.nombre }}</option>{% endfor %}</select></label><label>Grupo<select name="grupo">
<option value="" selected disabled hidden></option>
{% for g in catalogos.grupos %}<option value="{{ g.id }}" {% if estudiante and estudiante.id_grupo==g.id %}selected{% endif %}>{{ g.grado }} - {{ g.nombre }}</option>{% endfor %}</select></label><label>Periodo<select name="periodo" required>
<option value="" selected disabled hidden></option>
{% for p in catalogos.periodos %}<option value="{{ p.id }}" {% if estudiante and estudiante.id_periodo==p.id %}selected{% endif %}>{{ p.nombre }}</option>{% endfor %}</select></label>{% if estudiante %}<label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option>Activo</option><option {% if estudiante.estado=='Retirado' %}selected{% endif %}>Retirado</option></select></label>{% endif %}<div class="full-field"><button class="boton" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button> <a class="boton secundario" href="{{ url_for('estudiantes.lista') }}" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cancelar</a></div></form>



{% endblock %}


<style id="EDUTURNOS_BOTONES_REALES_V6">
button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a.btn,
a[class*="boton"],
a[class*="button"],
a[class*="btn-"],
a[role="button"],
a.link-back,
a.edc-back,
.edc-header-actions a,
.edc-header-actions button,
.edc-buttons a,
.edc-buttons button,
.edc-month-toolbar a,
.edc-month-toolbar button,
.citas-actions a,
.citas-actions button,
.form-actions a,
.form-actions button,
.acciones a,
.acciones button,
.page-actions a,
.page-actions button,
.dashboard-actions a,
.dashboard-actions button,
.dashboard-card a.boton,
.dashboard-card button,
.quick-card a.boton,
.quick-card button,
.account-actions a.boton,
.account-actions button {
    background: #1769aa !important;
    background-color: #1769aa !important;
    color: #ffffff !important;
    border-color: #1769aa !important;
    text-decoration: none !important;
    box-shadow: none !important;
    opacity: 1 !important;
}

button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a.btn:hover,
a[class*="boton"]:hover,
a[class*="button"]:hover,
a[class*="btn-"]:hover,
a[role="button"]:hover,
a.link-back:hover,
a.edc-back:hover,
.edc-header-actions a:hover,
.edc-header-actions button:hover,
.edc-buttons a:hover,
.edc-buttons button:hover,
.edc-month-toolbar a:hover,
.edc-month-toolbar button:hover,
.citas-actions a:hover,
.citas-actions button:hover,
.form-actions a:hover,
.form-actions button:hover,
.acciones a:hover,
.acciones button:hover,
.page-actions a:hover,
.page-actions button:hover,
.dashboard-actions a:hover,
.dashboard-actions button:hover,
.dashboard-card a.boton:hover,
.dashboard-card button:hover,
.quick-card a.boton:hover,
.quick-card button:hover,
.account-actions a.boton:hover,
.account-actions button:hover {
    background: #145b91 !important;
    background-color: #145b91 !important;
    color: #ffffff !important;
    border-color: #145b91 !important;
}

button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a.btn *,
a[role="button"] *,
a.link-back *,
a.edc-back *,
.edc-header-actions a *,
.edc-header-actions button *,
.edc-buttons a *,
.edc-buttons button *,
.edc-month-toolbar a *,
.edc-month-toolbar button *,
.citas-actions a *,
.citas-actions button *,
.form-actions a *,
.form-actions button *,
.acciones a *,
.acciones button *,
.page-actions a *,
.page-actions button *,
.dashboard-actions a *,
.dashboard-actions button *,
.dashboard-card a.boton *,
.dashboard-card button *,
.quick-card a.boton *,
.quick-card button *,
.account-actions a.boton *,
.account-actions button * {
    color: #ffffff !important;
}
</style>

<script id="EDUTURNOS_BOTONES_REALES_V6">
(function() {
    "use strict";

    const azul = "#1769aa";
    const hover = "#145b91";
    const blanco = "#ffffff";

    const selectores = [
        "button",
        "input[type='submit']",
        "input[type='button']",
        "input[type='reset']",

        "a.boton",
        "a.btn",
        "a[class*='boton']",
        "a[class*='button']",
        "a[class*='btn-']",
        "a[class*='accion']",
        "a[class*='action']",
        "a[role='button']",

        "a.link-back",
        "a.edc-back",

        ".edc-header-actions a",
        ".edc-header-actions button",

        ".edc-buttons a",
        ".edc-buttons button",

        ".edc-month-toolbar a",
        ".edc-month-toolbar button",

        ".citas-actions a",
        ".citas-actions button",

        ".form-actions a",
        ".form-actions button",

        ".acciones a",
        ".acciones button",

        ".page-actions a",
        ".page-actions button",

        ".dashboard-actions a",
        ".dashboard-actions button",

        ".account-actions a",
        ".account-actions button",

        ".quick-card a.boton",
        ".quick-card button",

        ".dashboard-card a.boton",
        ".dashboard-card button"
    ].join(",");


    function aplicar(elemento) {
        if (!elemento) return;

        elemento.style.setProperty(
            "background",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "background-color",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "color",
            blanco,
            "important"
        );

        elemento.style.setProperty(
            "border-color",
            azul,
            "important"
        );

        elemento.style.setProperty(
            "text-decoration",
            "none",
            "important"
        );

        elemento.style.setProperty(
            "box-shadow",
            "none",
            "important"
        );

        elemento.style.setProperty(
            "opacity",
            "1",
            "important"
        );

        elemento.querySelectorAll("*").forEach(function(hijo) {
            hijo.style.setProperty(
                "color",
                blanco,
                "important"
            );
        });

        if (!elemento.dataset.eduturnosBotonV6) {
            elemento.dataset.eduturnosBotonV6 = "1";

            elemento.addEventListener("mouseenter", function() {
                elemento.style.setProperty(
                    "background",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "background-color",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "border-color",
                    hover,
                    "important"
                );

                elemento.style.setProperty(
                    "color",
                    blanco,
                    "important"
                );
            });

            elemento.addEventListener("mouseleave", function() {
                elemento.style.setProperty(
                    "background",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "background-color",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "border-color",
                    azul,
                    "important"
                );

                elemento.style.setProperty(
                    "color",
                    blanco,
                    "important"
                );
            });
        }
    }


    function buscarBotonesPorTexto() {
        document.querySelectorAll("a").forEach(function(a) {
            const texto = (a.textContent || "")
                .trim()
                .toLowerCase();

            const href = (a.getAttribute("href") || "")
                .toLowerCase();

            const palabras = [
                "atrás",
                "atras",
                "nueva citación",
                "nueva cita",
                "ver citas",
                "filtrar",
                "limpiar",
                "editar",
                "eliminar",
                "confirmar",
                "cancelar",
                "reprogramar",
                "descargar",
                "exportar",
                "importar",
                "guardar",
                "enviar",
                "volver",
                "marcar",
                "crear",
                "solicitar"
            ];

            const coincideTexto = palabras.some(function(p) {
                return texto === p || texto.includes(p);
            });

            const coincideRuta =
                href.includes("/citas/") ||
                href.includes("/calendario") ||
                href.includes("/notificaciones/") ||
                href.includes("/solicitudes/") ||
                href.includes("/reportes/") ||
                href.includes("/usuarios/") ||
                href.includes("/auth/recuperar");

            const contenedor = a.closest(
                ".edc-header-actions," +
                ".edc-buttons," +
                ".edc-month-toolbar," +
                ".citas-actions," +
                ".form-actions," +
                ".acciones," +
                ".page-actions," +
                ".dashboard-actions," +
                ".dashboard-card," +
                ".quick-card," +
                ".account-actions"
            );

            if (coincideTexto || coincideRuta || contenedor) {
                aplicar(a);
            }
        });
    }


    function ejecutar() {
        document.querySelectorAll(selectores).forEach(aplicar);
        buscarBotonesPorTexto();
    }


    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ejecutar);
    } else {
        ejecutar();
    }


    const observador = new MutationObserver(function() {
        ejecutar();
    });

    observador.observe(document.documentElement, {
        childList: true,
        subtree: true
    });

})();
</script>

