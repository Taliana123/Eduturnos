{% extends 'base.html' %}{% block content %}<div class="page-head"><div><h1>Estudiantes</h1></div><a class="boton" href="{{ url_for('estudiantes.nuevo') }}">+ Nuevo</a></div><form method="get" class="search">{{ csrf_field()|safe }}<input name="q" value="{{ q }}" placeholder="Nombre, apellido o documento"><button class="boton secundario">Buscar</button></form><div class="table-wrap"><table><tr><th>Estudiante</th><th>Documento</th><th>Curso</th><th>Sede</th><th>Estado</th><th>Acción</th></tr>{% for e in estudiantes %}<tr><td>{{ e.nombres }} {{ e.apellidos }}</td><td>{{ e.documento }}</td><td>{{ e.curso or '-' }}</td><td>{{ e.sede or '-' }}</td><td>{{ e.estado }}</td><td><a href="{{ url_for('estudiantes.editar',id=e.id_estudiante) }}">Editar</a></td></tr>{% else %}<tr><td colspan="6">No hay resultados.</td></tr>{% endfor %}</table></div>{% endblock %}
