                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =================================================
         FOOTER
         ================================================= -->

    <footer>

        <div class="footer-interior">

            <span>
                <strong>EDUTURNOS</strong> &middot;
                Sistema de gesti&oacute;n de citaciones escolares
            </span>

            <span>
                Comunidad educativa
            </span>

        </div>

    </footer>

</div>

</body>
