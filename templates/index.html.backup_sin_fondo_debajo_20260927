<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EDUTURNOS | Comunidad educativa</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0d3158;
            color: #102a43;
            line-height: 1.6;
            min-height: 100vh;
            min-height: 100dvh;
        }

        .pagina {    
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%) !important;}

        .pagina > main {    
    flex: 0 0 auto;
    width: 100%;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%) !important;
    margin: 0 !important;
    padding-bottom: 0 !important;}

        .pagina > footer {    
    flex: 0 0 auto;
    width: 100%;
    margin: 0 !important;
    background: #0d3158 !important;
    color: #aac6dd;
    padding: 25px 28px;
    border: 0 !important;}

        .pagina > footer .footer-interior {
            width: 100%;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .pagina {    
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%) !important;}

        .pagina > main {    
    flex: 0 0 auto;
    width: 100%;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%) !important;
    margin: 0 !important;
    padding-bottom: 0 !important;}

        .pagina > footer {    
    flex: 0 0 auto;
    width: 100%;
    margin: 0 !important;
    background: #0d3158 !important;
    color: #aac6dd;
    padding: 25px 28px;
    border: 0 !important;}

        .pagina > footer .footer-interior {
            width: 100%;
        }

        /* =================================================
           NAVEGACION
           ================================================= */

        .barra {
            width: 100%;
            background: #ffffff;
            border-bottom: 1px solid #dbe8f5;
        }

        .barra-interior {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 78px;
            padding: 0 28px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        .marca {
            display: flex;
            align-items: center;
            gap: 12px;

            font-size: 20px;
            font-weight: 800;
            letter-spacing: .04em;
            color: #123f73;
            white-space: nowrap;
        }

        .marca-icono {
            width: 40px;
            height: 40px;
            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #1769aa;
            color: white;

            font-size: 19px;
            font-weight: 800;

            box-shadow: 0 8px 20px rgba(23,105,170,.20);
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 28px;
        }

        .nav a {
            font-size: 15px;
            font-weight: 700;
            color: #45627d;
            transition: .2s ease;
        }

        .nav a:hover {
            color: #1769aa;
        }

        .nav-login {
            padding: 11px 18px;
            border-radius: 10px;

            background: #1769aa;
            color: #ffffff !important;

            box-shadow: 0 7px 18px rgba(23,105,170,.20);
        }

        .nav-login:hover {
            background: #12568d;
            transform: translateY(-1px);
        }

        /* =================================================
           HERO
           ================================================= */

        .hero {    
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%);}

        .hero-interior {
            max-width: 1180px;
            margin: 0 auto;

            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
            gap: 70px;
            align-items: center;
    transform: translateY(30px);}

        .etiqueta {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            margin-bottom: 22px;

            color: #1769aa;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .13em;
        }

        .etiqueta::before {
            content: "";
            width: 28px;
            height: 3px;
            border-radius: 99px;
            background: #d89b27;
        }

        .hero h1 {
            max-width: 680px;

            color: #10385f;

            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(48px, 6vw, 76px);
            line-height: .98;
            letter-spacing: -.045em;

            margin-bottom: 28px;
        }

        .hero-texto {
            max-width: 650px;

            color: #385a76;
            font-size: 18px;
            line-height: 1.8;

            margin-bottom: 34px;
        }

        .acciones {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        .boton {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-height: 50px;
            padding: 0 22px;

            border-radius: 11px;

            font-size: 15px;
            font-weight: 800;

            transition: .2s ease;
        }

        .boton:hover {
            transform: translateY(-2px);
        }

        .boton-principal {
            background: #1769aa;
            color: white;

            box-shadow: 0 12px 25px rgba(23,105,170,.23);
        }

        .boton-secundario {
            background: rgba(255,255,255,.72);
            color: #174a73;
            border: 1px solid rgba(23,74,115,.12);
        }

        /* =================================================
           FLUJO
           ================================================= */

        .flujo {
            background: #ffffff;
            border-radius: 24px;

            padding: 30px;

            box-shadow:
                0 25px 60px rgba(35,78,115,.18),
                0 4px 14px rgba(35,78,115,.07);

            border: 1px solid rgba(255,255,255,.9);
        }

        .flujo-cabecera {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;

            padding-bottom: 22px;
            margin-bottom: 6px;

            border-bottom: 1px solid #e5edf5;
        }

        .flujo-mini {
            color: #d08e1b;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .12em;
        }

        .flujo h2 {
            margin-top: 7px;

            color: #173e63;

            font-family: Georgia, "Times New Roman", serif;
            font-size: 27px;
        }

        .flujo-estado {
            padding: 7px 10px;
            border-radius: 999px;

            background: #eef8f3;
            color: #26764e;

            font-size: 11px;
            font-weight: 800;
            letter-spacing: .06em;
        }

        .paso {
            display: grid;
            grid-template-columns: 48px 1fr;
            gap: 16px;

            padding: 21px 0;

            border-bottom: 1px solid #edf2f6;
        }

        .paso:last-child {
            border-bottom: 0;
            padding-bottom: 3px;
        }

        .numero {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: #e7f3fd;
            color: #1769aa;

            font-size: 13px;
            font-weight: 900;
        }

        .paso h3 {
            color: #183e60;
            font-size: 16px;
            margin-bottom: 3px;
        }

        .paso p {
            color: #6a8093;
            font-size: 14px;
        }

        /* =================================================
           SECCION INFORMACION
           ================================================= */

        .informacion {
            max-width: 1180px;
            margin: 0 auto;
            padding: 100px 28px;
        }

        .encabezado-seccion {
            max-width: 700px;
            margin-bottom: 45px;
        }

        .encabezado-seccion span {
            color: #d08e1b;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .13em;
        }

        .encabezado-seccion h2 {
            margin-top: 10px;

            color: #143e63;

            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(35px, 4vw, 52px);
            line-height: 1.08;
        }

        .encabezado-seccion p {
            margin-top: 17px;

            color: #60788e;
            font-size: 17px;
        }

        .beneficios-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .beneficio {
            background: white;
            border: 1px solid #dfeaf3;
            border-radius: 18px;

            padding: 28px;

            box-shadow: 0 10px 30px rgba(31,73,107,.06);
        }

        .beneficio-numero {
            color: #1769aa;
            font-size: 13px;
            font-weight: 900;
        }

        .beneficio h3 {
            margin: 13px 0 8px;

            color: #183e60;
            font-size: 19px;
        }

        .beneficio p {
            color: #6a8093;
            font-size: 15px;
        }

        /* =================================================
           CTA
           ================================================= */

        .cierre {
            background:
                radial-gradient(circle at 80% 20%, rgba(96,173,230,.25), transparent 30%),
                #123f73;

            padding: 80px 28px;
        }

        .cierre-interior {
            max-width: 950px;
            margin: 0 auto;
            text-align: center;
        }

        .cierre h2 {
            color: white;

            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(35px, 5vw, 57px);
            line-height: 1.05;
        }

        .cierre p {
            max-width: 690px;
            margin: 20px auto 30px;

            color: #c9dff1;
            font-size: 17px;
        }

        .boton-claro {
            background: white;
            color: #1769aa;
        }

        /* =================================================
           FOOTER
           ================================================= */

        footer {
            background: #0d3158;
            color: #aac6dd;

            padding: 25px 28px;
        }

        .footer-interior {
            max-width: 1180px;
            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        footer strong {
            color: white;
        }

        footer span {
            font-size: 13px;
        }

        /* =================================================
           RESPONSIVE
           ================================================= */

        @media (max-width: 900px) {

            .barra-interior {
                min-height: auto;
                padding-top: 18px;
                padding-bottom: 18px;
                flex-direction: column;
                align-items: flex-start;
            }

            .nav {
                width: 100%;
                justify-content: flex-start;
                flex-wrap: wrap;
                gap: 15px 22px;
            }

            .hero {    
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, .50), transparent 30%),
linear-gradient(135deg, #dceeff 0%, #b9dcf7 48%, #91c7ee 100%);}

            .hero-interior {
                grid-template-columns: 1fr;
                gap: 45px;}

            .beneficios-grid {
                grid-template-columns: 1fr;
            }

            .footer-interior {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (max-width: 560px) {

            .barra-interior,
            .hero,
            .informacion,
            .cierre {
                padding-left: 18px;
                padding-right: 18px;
            }

            .nav {
                gap: 12px 16px;
            }

            .nav a {
                font-size: 14px;
            }

            .hero h1 {
                font-size: 48px;
            }

            .flujo {
                padding: 22px;
            }

            .acciones {
                align-items: stretch;
                flex-direction: column;
            }

            .boton {
                width: 100%;
            }
        }
.pagina > footer {    
    flex: 0 0 auto;
    width: 100%;
    margin: 0 !important;
    background: #0d3158 !important;
    color: #aac6dd;
    padding: 25px 28px;
    border: 0 !important;}
</style>
</head>

<body>

<div class="pagina">

    <!-- =================================================
         NAVEGACION
         ================================================= -->

    <header class="barra">
