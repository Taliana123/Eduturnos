{% extends 'base.html' %}{% block content %}<h1>Seguimiento</h1><div class="table-wrap"><table><tr><th>Fecha</th><th>Estudiante</th><th>Estado</th><th>Asistencia</th><th>Observaciones</th><th>Usuario</th></tr>{% for s in seguimientos %}<tr><td>{{ s.fecha_seguimiento }}</td><td>{{ s.nombres }} {{ s.apellidos }}</td><td>{{ s.estado_actual }}</td><td>{{ s.asistencia }}</td><td>{{ s.observaciones or '-' }}</td><td>{{ s.usuario_n }} {{ s.usuario_a }}</td></tr>{% else %}<tr><td colspan="6">Sin seguimientos.</td></tr>{% endfor %}</table></div>{% endblock %}
