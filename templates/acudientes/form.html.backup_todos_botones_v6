{% extends 'base.html' %}{% block content %}<h1>{{ 'Editar' if acudiente else 'Nuevo' }} acudiente</h1><form method="post" class="panel form-grid">{{ csrf_field()|safe }}<label>Tipo documento<select name="tipo_documento">
<option value="" selected disabled hidden></option>
<option value="CC">Cédula de ciudadanía</option><option value="TI">Tarjeta de identidad</option><option value="CE">Cédula de extranjería</option></select></label><label>Documento<input name="documento" value="{{ acudiente.documento if acudiente else '' }}" required></label><label>Nombres<input name="nombres" value="{{ acudiente.nombres if acudiente else '' }}" required></label><label>Apellidos<input name="apellidos" value="{{ acudiente.apellidos if acudiente else '' }}" required></label><label>Teléfono<input name="telefono" value="{{ acudiente.telefono if acudiente else '' }}"></label><label>Correo<input type="email" name="correo" value="{{ acudiente.correo if acudiente else '' }}"></label><label>Dirección<input name="direccion" value="{{ acudiente.direccion if acudiente else '' }}"></label><label>Barrio<input name="barrio" value="{{ acudiente.barrio if acudiente else '' }}"></label><label>Municipio<input name="municipio" value="{{ acudiente.municipio if acudiente else 'Ibagué' }}"></label>{% if acudiente %}<label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activo</option><option value="0" {% if not acudiente.estado %}selected{% endif %}>Inactivo</option></select></label>{% endif %}<div class="full-field"><button class="boton">Guardar</button> <a class="boton secundario" href="{{ url_for('acudientes.lista') }}">Cancelar</a></div></form>

<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
