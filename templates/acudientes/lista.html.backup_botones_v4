{% extends 'base.html' %}{% block content %}<div class="page-head"><h1>Acudientes</h1><a class="boton" href="{{ url_for('acudientes.nuevo') }}">+ Nuevo</a></div><div class="table-wrap"><table><tr><th>Nombre</th><th>Documento</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr>{% for a in acudientes %}<tr><td>{{ a.nombres }} {{ a.apellidos }}</td><td>{{ a.documento }}</td><td>{{ a.correo or '-' }}</td><td>{{ a.telefono or '-' }}</td><td>{{ 'Activo' if a.estado else 'Inactivo' }}</td><td><a href="{{ url_for('acudientes.editar',id=a.id_acudiente) }}">Editar</a> · <a href="{{ url_for('acudientes.relaciones',id=a.id_acudiente) }}">Estudiantes</a></td></tr>{% else %}<tr><td colspan="6">No hay acudientes.</td></tr>{% endfor %}</table></div>{% endblock %}
