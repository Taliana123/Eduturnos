{% extends 'base.html' %}{% block content %}<h1>Auditoría</h1><div class="table-wrap"><table><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Módulo</th><th>Registro</th><th>Detalle</th></tr>{% for a in datos %}<tr><td>{{ a.fecha_creacion }}</td><td>{{ a.nombres or '' }} {{ a.apellidos or '' }}</td><td>{{ a.accion }}</td><td>{{ a.modulo }}</td><td>{{ a.registro_id or '-' }}</td><td>{{ a.detalle or '' }}</td></tr>{% else %}<tr><td colspan="6">No hay registros.</td></tr>{% endfor %}</table></div>

<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
