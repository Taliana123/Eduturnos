{% extends 'base.html' %}
{% block title %}Configuración · EDUTURNOS{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Configuración institucional</h1>
    <p class="muted">Administra los catálogos que alimentan formularios, citaciones y reportes. Los cambios se guardan directamente en MySQL.</p>
  </div>
</div>

{% if puede_editar_institucion %}
<section class="panel">
  <div class="section-heading">
    <h2>Institución</h2>
    <p>Datos generales mostrados por EDUTURNOS.</p>
  </div>
  <form method="post" action="{{ url_for('configuracion.guardar_institucion') }}" class="form-grid">
    {{ csrf_field()|safe }}
    <input type="hidden" name="id_institucion" value="{{ institucion.id if institucion else '' }}">
    <label>Nombre<input name="nombre" maxlength="180" required value="{{ institucion.nombre if institucion else '' }}"></label>
    <label>Ciudad<input name="ciudad" maxlength="100" required value="{{ institucion.ciudad if institucion else '' }}"></label>
    <label>Departamento<input name="departamento" maxlength="100" required value="{{ institucion.departamento if institucion else '' }}"></label>
    <label>Teléfono<input name="telefono" maxlength="40" value="{{ institucion.telefono if institucion else '' }}"></label>
    <label class="full-field">Dirección<input name="direccion" maxlength="255" value="{{ institucion.direccion if institucion else '' }}"></label>
    <label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if not institucion or institucion.estado %} selected{% endif %}>Activa</option><option value="0"{% if institucion and not institucion.estado %} selected{% endif %}>Inactiva</option></select></label>
    <div class="form-actions"><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar institución</button></div>
  </form>
</section>
{% endif %}

<section class="panel">
  <div class="section-heading"><h2>Periodos académicos</h2><p>El periodo activo alimenta las nuevas citaciones y registros.</p></div>
  {% if puede_editar_institucion %}
  <form method="post" action="{{ url_for('configuracion.nuevo_periodo') }}" class="form-grid">
    {{ csrf_field()|safe }}
    <label>Nombre<input name="nombre" maxlength="80" required placeholder="Periodo académico 2027"></label>
    <label>Inicio<input type="date" name="inicio" required></label>
    <label>Fin<input type="date" name="fin" required></label>
    <div class="form-actions"><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Crear periodo</button></div>
  </form>
  {% endif %}
  <div class="table-wrap">
    <table>
      <thead><tr><th>Periodo</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Acciones</th></tr></thead>
      <tbody>
      {% for p in periodos %}
        <tr>
          <td>{{ p.nombre }}</td><td>{{ p.fecha_inicio }}</td><td>{{ p.fecha_fin }}</td>
          <td>{% if p.cerrado %}<span class="badge">Cerrado</span>{% elif p.activo %}<span class="badge">Activo</span>{% else %}<span class="muted">Inactivo</span>{% endif %}</td>
          <td class="acciones">
            {% if puede_editar_institucion and not p.cerrado %}
            <form method="post" action="{{ url_for('configuracion.activar_periodo', periodo_id=p.id) }}">{{ csrf_field()|safe }}<button class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Activar</button></form>
            <form method="post" action="{{ url_for('configuracion.cerrar_periodo', periodo_id=p.id) }}">{{ csrf_field()|safe }}<button class="boton pequeno secundario" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cerrar</button></form>
            {% else %}<span class="muted">Sin cambios</span>{% endif %}
          </td>
        </tr>
      {% else %}<tr><td colspan="5">No hay periodos registrados.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="section-heading"><h2>Sedes</h2><p>Cada sede puede desactivarse sin borrar las relaciones históricas.</p></div>
  <form method="post" action="{{ url_for('configuracion.guardar_sede') }}" class="form-grid">
    {{ csrf_field()|safe }}
    <input type="hidden" name="id_institucion" value="{{ institucion.id if institucion else '' }}">
    <label>Nombre<input name="nombre" maxlength="140" required placeholder="Nueva sede"></label>
    <label>Código (6 dígitos)<input name="codigo_sede" maxlength="6" pattern="[0-9]{6}" placeholder="000001"></label>
    <label class="full-field">Dirección<input name="direccion" maxlength="255"></label>
    <label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1" selected>Activa</option><option value="0">Inactiva</option></select></label>
    <div class="form-actions"><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar sede</button></div>
  </form>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Nombre</th><th>Código</th><th>Dirección</th><th>Estado</th><th>Guardar</th><th>Cambiar</th></tr></thead>
      <tbody>
      {% for s in sedes %}
        <tr>
          <td>
            <form id="sede-{{ s.id }}" method="post" action="{{ url_for('configuracion.guardar_sede') }}">
              {{ csrf_field()|safe }}<input type="hidden" name="id_sede" value="{{ s.id }}"><input type="hidden" name="id_institucion" value="{{ s.id_institucion }}">
            </form>
            <input form="sede-{{ s.id }}" name="nombre" value="{{ s.nombre }}" maxlength="140" required>
          </td>
          <td><input form="sede-{{ s.id }}" name="codigo_sede" value="{{ s.codigo_sede or '' }}" maxlength="6" pattern="[0-9]{6}"></td>
          <td><input form="sede-{{ s.id }}" name="direccion" value="{{ s.direccion or '' }}" maxlength="255"></td>
          <td><select form="sede-{{ s.id }}" name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if s.estado %} selected{% endif %}>Activa</option><option value="0"{% if not s.estado %} selected{% endif %}>Inactiva</option></select></td>
          <td><button form="sede-{{ s.id }}" class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button></td>
          <td><form method="post" action="{{ url_for('configuracion.toggle_sede', sede_id=s.id) }}">{{ csrf_field()|safe }}<button class="boton pequeno secundario" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Activar/desactivar</button></form></td>
        </tr>
      {% else %}<tr><td colspan="6">No hay sedes registradas.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="grid">
  <div class="panel">
    <div class="section-heading"><h2>Jornadas</h2><p>Horarios disponibles para estudiantes y personal.</p></div>
    <form method="post" action="{{ url_for('configuracion.guardar_jornada') }}" class="stack-form">
      {{ csrf_field()|safe }}<label>Nombre<input name="nombre" maxlength="50" required placeholder="Tarde"></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activa</option><option value="0">Inactiva</option></select></label><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar jornada</button>
    </form>
    {% for j in jornadas %}
      <form method="post" action="{{ url_for('configuracion.guardar_jornada') }}" class="acciones" style="margin-top:12px;">
        {{ csrf_field()|safe }}<input type="hidden" name="id_jornada" value="{{ j.id }}"><input name="nombre" value="{{ j.nombre }}" maxlength="50" required><select name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if j.estado %} selected{% endif %}>Activa</option><option value="0"{% if not j.estado %} selected{% endif %}>Inactiva</option></select><button class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button><button class="boton pequeno secundario" formmethod="post" formaction="{{ url_for('configuracion.toggle_jornada', jornada_id=j.id) }}" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cambiar</button>
      </form>
    {% else %}<p class="muted">No hay jornadas.</p>{% endfor %}
  </div>

  <div class="panel">
    <div class="section-heading"><h2>Grados</h2><p>Niveles académicos activos o inactivos.</p></div>
    <form method="post" action="{{ url_for('configuracion.guardar_grado') }}" class="stack-form">
      {{ csrf_field()|safe }}<label>Nombre<input name="nombre" maxlength="30" required placeholder="11"></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activo</option><option value="0">Inactivo</option></select></label><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar grado</button>
    </form>
    {% for g in grados %}
      <form method="post" action="{{ url_for('configuracion.guardar_grado') }}" class="acciones" style="margin-top:12px;">
        {{ csrf_field()|safe }}<input type="hidden" name="id_grado" value="{{ g.id }}"><input name="nombre" value="{{ g.nombre }}" maxlength="30" required><select name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if g.estado %} selected{% endif %}>Activo</option><option value="0"{% if not g.estado %} selected{% endif %}>Inactivo</option></select><button class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button><button class="boton pequeno secundario" formmethod="post" formaction="{{ url_for('configuracion.toggle_grado', grado_id=g.id) }}" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cambiar</button>
      </form>
    {% else %}<p class="muted">No hay grados.</p>{% endfor %}
  </div>
</section>

<section class="panel">
  <div class="section-heading"><h2>Grupos</h2><p>Cada grupo pertenece a un grado y mantiene sus relaciones históricas.</p></div>
  <form method="post" action="{{ url_for('configuracion.guardar_grupo') }}" class="form-grid">
    {{ csrf_field()|safe }}
    <label>Grado<select name="id_grado" required>
<option value="" selected disabled hidden></option>
{% for g in grados if g.estado %}<option value="{{ g.id }}">{{ g.nombre }}</option>{% endfor %}</select></label>
    <label>Nombre del grupo<input name="nombre" maxlength="20" required placeholder="A"></label>
    <label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activo</option><option value="0">Inactivo</option></select></label>
    <div class="form-actions"><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar grupo</button></div>
  </form>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Grado</th><th>Grupo</th><th>Estado</th><th>Guardar</th><th>Cambiar</th></tr></thead>
      <tbody>
      {% for g in grupos %}
        <tr>
          <td>
            <form id="grupo-{{ g.id }}" method="post" action="{{ url_for('configuracion.guardar_grupo') }}">
              {{ csrf_field()|safe }}<input type="hidden" name="id_grupo" value="{{ g.id }}">
            </form>
            <select form="grupo-{{ g.id }}" name="id_grado" required>
<option value="" selected disabled hidden></option>
{% for grado in grados %}<option value="{{ grado.id }}"{% if grado.id == g.id_grado %} selected{% endif %}>{{ grado.nombre }}</option>{% endfor %}</select>
          </td>
          <td><input form="grupo-{{ g.id }}" name="nombre" value="{{ g.nombre }}" maxlength="20" required></td>
          <td><select form="grupo-{{ g.id }}" name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if g.estado %} selected{% endif %}>Activo</option><option value="0"{% if not g.estado %} selected{% endif %}>Inactivo</option></select></td>
          <td><button form="grupo-{{ g.id }}" class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button></td>
          <td><form method="post" action="{{ url_for('configuracion.toggle_grupo', grupo_id=g.id) }}">{{ csrf_field()|safe }}<button class="boton pequeno secundario" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cambiar</button></form></td>
        </tr>
      {% else %}<tr><td colspan="5">No hay grupos registrados.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="grid">
  <div class="panel">
    <div class="section-heading"><h2>Motivos</h2><p>Motivos disponibles al crear una citación.</p></div>
    <form method="post" action="{{ url_for('configuracion.guardar_motivo') }}" class="stack-form">
      {{ csrf_field()|safe }}<label>Nombre<input name="nombre" maxlength="120" required></label><label>Descripción<input name="descripcion" maxlength="255"></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activo</option><option value="0">Inactivo</option></select></label><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar motivo</button>
    </form>
    {% for m in motivos %}
      <form method="post" action="{{ url_for('configuracion.guardar_motivo') }}" class="stack-form" style="margin-top:18px;border-top:1px solid var(--borde);padding-top:18px;">
        {{ csrf_field()|safe }}<input type="hidden" name="id_motivo" value="{{ m.id }}"><label>Nombre<input name="nombre" value="{{ m.nombre }}" maxlength="120" required></label><label>Descripción<input name="descripcion" value="{{ m.descripcion or '' }}" maxlength="255"></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if m.estado %} selected{% endif %}>Activo</option><option value="0"{% if not m.estado %} selected{% endif %}>Inactivo</option></select></label><div class="acciones"><button class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button><button class="boton pequeno secundario" formmethod="post" formaction="{{ url_for('configuracion.toggle_motivo', motivo_id=m.id) }}" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cambiar</button></div>
      </form>
    {% else %}<p class="muted">No hay motivos.</p>{% endfor %}
  </div>

  <div class="panel">
    <div class="section-heading"><h2>Estados de citación</h2><p>Los estados inactivos dejan de estar disponibles para cambios futuros.</p></div>
    <form method="post" action="{{ url_for('configuracion.guardar_estado') }}" class="stack-form">
      {{ csrf_field()|safe }}<label>Nombre<input name="nombre" maxlength="40" required></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1">Activo</option><option value="0">Inactivo</option></select></label><button class="boton" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Agregar estado</button>
    </form>
    {% for e in estados %}
      <form method="post" action="{{ url_for('configuracion.guardar_estado') }}" class="stack-form" style="margin-top:18px;border-top:1px solid var(--borde);padding-top:18px;">
        {{ csrf_field()|safe }}<input type="hidden" name="id_estado" value="{{ e.id }}"><label>Nombre<input name="nombre" value="{{ e.nombre }}" maxlength="40" required></label><label>Estado<select name="estado">
<option value="" selected disabled hidden></option>
<option value="1"{% if e.estado %} selected{% endif %}>Activo</option><option value="0"{% if not e.estado %} selected{% endif %}>Inactivo</option></select></label><div class="acciones"><button class="boton pequeno" type="submit" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Guardar</button><button class="boton pequeno secundario" formmethod="post" formaction="{{ url_for('configuracion.toggle_estado', estado_id=e.id) }}" style="background:#1769aa !important;background-color:#1769aa !important;color:#ffffff !important;border-color:#1769aa !important;text-decoration:none !important;box-shadow:none !important;opacity:1 !important;cursor:pointer !important;">Cambiar</button></div>
      </form>
    {% else %}<p class="muted">No hay estados.</p>{% endfor %}
  </div>
</section>

<p class="muted"><a href="{{ url_for('configuracion.arquitectura') }}">Ver arquitectura</a>{% if puede_editar_institucion %} · <a href="{{ url_for('configuracion.auditoria_view') }}">Ver auditoría</a>{% endif %}</p>




{% endblock %}


