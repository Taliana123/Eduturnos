    background: #d85d58 !important;
    color: #fff !important;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 7px 18px rgba(0,0,0,.12);
}

/* ILUSTRACIÓN ABSTRACTA */

.dashboard-role-art {
    position: absolute;
    right: 145px;
    top: 30px;
    width: 190px;
    height: 190px;
    z-index: 1;
}

.dashboard-role-art::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 50%;
}

.dashboard-role-art::after {
    content: "";
    position: absolute;
    inset: 30px;
    border: 1px dashed rgba(255,255,255,.14);
    border-radius: 50%;
    animation: giroRol 18s linear infinite;
}

.role-symbol {
    position: absolute;
    inset: 0;
}

.role-symbol span {
    position: absolute;
    left: 55px;
    top: 54px;
    width: 78px;
    height: 78px;
    border-radius: 24px;
    background: #f2b84b;
    transform: rotate(18deg);
    box-shadow: 0 16px 30px rgba(0,0,0,.18);
}

.role-symbol i {
    position: absolute;
    left: 34px;
    top: 87px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #7fc4ed;
}

.role-symbol b {
    position: absolute;
    right: 28px;
    top: 35px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffffff;
}

.role-rectoria span {
    border-radius: 12px 12px 30px 30px;
}

.role-estudiante span {
    border-radius: 50%;
    transform: rotate(0);
}

.role-acudiente span {
    border-radius: 50% 18px 50% 18px;
}

.role-docente span {
    border-radius: 8px;
    transform: rotate(45deg);
}

.role-coordinador span {
    clip-path: polygon(50% 0,100% 25%,82% 100%,18% 100%,0 25%);
    border-radius: 0;
    transform: rotate(0);
}

.role-default span {
    border-radius: 22px;
}

@keyframes giroRol {
    from { transform: rotate(0); }
    to { transform: rotate(360deg); }
}

/* INDICADORES */

.dashboard-kpis {
    display: grid !important;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 16px;
    margin: 22px 0 55px !important;
}

.dashboard-kpi {
    padding: 21px;
    border: 1px solid #dce5ed;
    border-radius: 17px;
    background: #ffffff;
    box-shadow: 0 7px 22px rgba(23,41,66,.055);
}

.dashboard-kpi span {
    color: #718094 !important;
