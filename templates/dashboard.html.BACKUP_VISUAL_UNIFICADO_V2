    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
}

.dashboard-card-head h2 {
    margin: 8px 0 7px !important;
    color: #172942 !important;
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 31px;
}

.dashboard-card-head p {
    color: #718094 !important;
}

/* TARJETAS */

.dashboard-action-grid {
    display: grid !important;
    grid-template-columns: repeat(3,minmax(0,1fr)) !important;
    gap: 18px !important;
}

.dashboard-action {
    position: relative;
    min-height: 205px !important;
    padding: 23px !important;
    display: flex !important;
    flex-direction: column;
    border: 1px solid #dce5ed !important;
    border-radius: 20px !important;
    background: #ffffff !important;
    box-shadow: 0 8px 25px rgba(23,41,66,.055) !important;
    text-decoration: none !important;
    overflow: hidden;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease !important;
}

.dashboard-action::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20px;
    right: 20px;
    height: 3px;
    border-radius: 0 0 8px 8px;
    background: linear-gradient(90deg,#1769aa,#f2b84b);
}

.dashboard-action:hover {
    transform: translateY(-4px) !important;
    border-color: #b8d3e8 !important;
    box-shadow: 0 16px 32px rgba(23,41,66,.11) !important;
}

.dashboard-action-icon {
    width: fit-content;
    min-height: 32px;
    padding: 7px 11px !important;
    display: inline-flex;
    align-items: center;
    border-radius: 9px !important;
    background: #e8f3fb !important;
    color: #1769aa !important;
    font-size: 12px !important;
    font-weight: 800 !important;
}

.dashboard-action h3 {
    margin: 18px 0 8px !important;
    color: #172942 !important;
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 23px !important;
}

.dashboard-action p {
    flex: 1;
    margin: 0 !important;
    color: #718094 !important;
    font-size: 13.5px !important;
    line-height: 1.5 !important;
}

.dashboard-action-link {
    margin-top: 18px !important;
    color: #1769aa !important;
    font-weight: 800 !important;
}

/* CUENTA */

.dashboard-account-card {
    margin-top: 30px;
    padding: 27px !important;
    border-radius: 21px !important;
    background: #edf5fa !important;
}

.dashboard-account-text {
    color: #68798a !important;
}

.dashboard-account-action {
    max-width: 280px;
}

.dashboard-account-action .boton-full {
    background: #1769aa !important;
    color: #fff !important;
    border-radius: 12px !important;
}

/* RESPONSIVE */

@media (max-width: 950px) {
    .dashboard-role-art {
        opacity: .45;
        right: 50px;
    }

    .dashboard-action-grid {
        grid-template-columns: repeat(2,minmax(0,1fr)) !important;
    }

    .dashboard-kpis {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }
}

@media (max-width: 650px) {
    .dashboard-page {
        width: calc(100% - 24px);
    }

    .dashboard-head {
        padding: 30px 25px;
        min-height: 250px;
    }

    .dashboard-role-art {
        display: none;
    }

    .dashboard-head-action {
        margin-left: 0;
        align-self: auto;
    }

    .dashboard-head {
        flex-direction: column;
    }

    .dashboard-logout {
        width: 100%;
    }

    .dashboard-action-grid,
    .dashboard-kpis {
        grid-template-columns: 1fr !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    .dashboard-role-art::after {
        animation: none;
    }

    .dashboard-action {
        transition: none !important;
    }
}

</style>
