{% extends 'base.html' %}
{% block title %}EDUTURNOS · Gestión de citaciones escolares{% endblock %}
{% block content %}
<section class="hero">
  <div class="tarjeta hero-card">
    <span class="badge">Portal institucional</span>
    <h1>EDUTURNOS</h1>
    <p>Un solo lugar para crear, confirmar y hacer seguimiento a las citaciones escolares, con calendario, notificaciones y reportes.</p>
    <div class="acciones">
      <a class="boton" href="{{ url_for('auth.login') }}">Iniciar sesión</a>
      <a class="boton secundario" href="{{ url_for('auth.registro') }}">Crear cuenta</a>
    </div>
  </div>
  <div class="hero-visual hero-card">
    <span class="badge">Portal institucional</span>
    <h2>Multiusuario</h2>
    <p>Estudiantes, acudientes, docentes, coordinación y rectoría trabajan sobre la misma información institucional.</p>
    <p class="muted">Segura · centralizada · multiusuario</p>
  </div>
</section>
<div class="grid equal-cards feature-grid">
  <div class="tarjeta feature-card"><h3>Citaciones</h3><p>Agenda y consulta reuniones sin duplicar horarios.</p></div>
  <div class="tarjeta feature-card"><h3>Seguimiento</h3><p>Registra asistencia, resultados y justificaciones.</p></div>
  <div class="tarjeta feature-card"><h3>Comunicación</h3><p>Notificaciones y eventos de calendario en un solo sitio.</p></div>
</div>


<style id="EDUTURNOS_BOTONES_V4">
/* =========================================================
   EDUTURNOS
   SOLO BOTONES
   Mismo azul y letra que "+ Nueva citación" de Citas
   ========================================================= */

button,
input[type="submit"],
input[type="button"],
input[type="reset"],
a.boton,
a[class*="boton"],
a.btn,
a[class*="btn-"],
a.link-back,
a.edc-back,
.boton,
.btn,
[class*="boton-"],
[class*="btn-"],
.link-back,
.edc-back {

    background: #1769aa !important;
    background-color: #1769aa !important;

    color: #ffffff !important;

    border-color: #1769aa !important;

    text-decoration: none !important;
}

/* Texto dentro de botones */
button *,
input[type="submit"] *,
input[type="button"] *,
input[type="reset"] *,
a.boton *,
a[class*="boton"] *,
a.btn *,
a[class*="btn-"] *,
.link-back *,
.edc-back * {
    color: #ffffff !important;
}

/* Hover */
button:hover,
input[type="submit"]:hover,
input[type="button"]:hover,
input[type="reset"]:hover,
a.boton:hover,
a[class*="boton"]:hover,
a.btn:hover,
a[class*="btn-"]:hover,
a.link-back:hover,
a.edc-back:hover,
.boton:hover,
.btn:hover,
[class*="boton-"]:hover,
[class*="btn-"]:hover,
.link-back:hover,
.edc-back:hover {

    background: #145b91 !important;
    background-color: #145b91 !important;

    color: #ffffff !important;

    border-color: #145b91 !important;

    text-decoration: none !important;
}

/* Elementos hijos durante hover */
button:hover *,
a.boton:hover *,
a[class*="boton"]:hover *,
a.btn:hover *,
a[class*="btn-"]:hover *,
.link-back:hover *,
.edc-back:hover * {
    color: #ffffff !important;
}
</style>

{% endblock %}
