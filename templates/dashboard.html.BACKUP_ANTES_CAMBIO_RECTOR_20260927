<style id="EDUTURNOS_DASHBOARD_VISUAL_COMPACTO_FINAL">

/* =========================================================
   EDUTURNOS
   DASHBOARD COMPACTO
   ========================================================= */

.dashboard-page {
    width: min(1160px, calc(100% - 44px));
    margin: 0 auto;
    padding: 28px 0 48px;
    box-sizing: border-box;

    color: #243b53;
}

/* =========================================================
   CABECERA
   ========================================================= */

.dashboard-head {
    position: relative;

    min-height: 150px !important;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 28px;

    margin-bottom: 18px;
    padding: 24px 28px !important;

    box-sizing: border-box;

    border: 1px solid #d9e7f2 !important;
    border-radius: 22px !important;

    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #f7fbff 100%
        ) !important;

    box-shadow:
        0 8px 24px rgba(42, 91, 125, .07) !important;

    color: #243b53 !important;

    overflow: hidden;
}

.dashboard-head::before {
    content: "";

    position: absolute;

    left: 0;
    top: 18px;
    bottom: 18px;

    width: 5px;

    border-radius: 0 5px 5px 0;

    background: #2f7da8;
}

/* =========================================================
   INFORMACIÓN DEL USUARIO
   ========================================================= */

.dashboard-head-info {

    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns: 76px minmax(0, 1fr);

    grid-template-areas:
        "art badge"
        "art title"
        "art text";

    column-gap: 18px;
    row-gap: 2px;

    align-items: center;

    min-width: 0;
}

.dashboard-role-art {

    grid-area: art;

    width: 76px;
    height: 76px;

    display: grid;
    place-items: center;
}

/* =========================================================
   DIBUJO / ILUSTRACIÓN DEL ROL
   ========================================================= */

.role-symbol {

    position: relative;

    width: 68px;
    height: 68px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            #eaf5fb,
            #d7edf8
        );

    border: 1px solid #c8e0ee;

    box-shadow:
        0 7px 16px rgba(43, 112, 150, .10);

    overflow: hidden;

    animation: eduturnosRolFlota 3.8s ease-in-out infinite;
}

/* cabeza */

.role-symbol::after {

    content: "";

    position: absolute;

    width: 20px;
    height: 20px;

    left: 24px;
    top: 12px;

    border-radius: 50%;

    background: #ffffff;

    border: 3px solid #2f7da8;

    box-sizing: border-box;

    box-shadow:
        0 2px 0 rgba(47,125,168,.08);
}

/* cuerpo */

.role-symbol::before {

    content: "";

    position: absolute;

    width: 34px;
    height: 23px;

    left: 17px;
    bottom: 12px;

    border-radius: 12px 12px 8px 8px;

    background: #2f7da8;

    box-shadow:
        inset 0 4px 0 rgba(255,255,255,.20);
}

/* detalles */

.role-symbol span,
.role-symbol i,
.role-symbol b {

    display: block;

    position: absolute;

    z-index: 3;

    font-style: normal;
}

/* ojos */

.role-symbol span::before,
.role-symbol span::after {

    content: "";

    position: absolute;

    width: 3px;
    height: 3px;

    top: 20px;

    border-radius: 50%;

    background: #243b53;
}

.role-symbol span::before {
    left: 29px;
}

.role-symbol span::after {
    left: 36px;
}

/* detalle inferior */

.role-symbol i {

    width: 10px;
    height: 4px;

    left: 29px;
    bottom: 20px;

    border-radius: 5px;

    background: #f2b84b;
}

/* detalle superior */

.role-symbol b {

    width: 28px;
    height: 4px;

    left: 20px;
    top: 7px;

    border-radius: 5px;

    background: #f2b84b;

    opacity: .9;
}

@keyframes eduturnosRolFlota {

    0%,
    100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-3px) rotate(.5deg);
    }
}

/* =========================================================
   BADGE
   ========================================================= */

.dashboard-head .badge {

    grid-area: badge;

    width: fit-content;

    margin: 0 0 2px;

    padding: 4px 9px;

    border-radius: 999px;

    background: #eaf4fa !important;

    border: 1px solid #d3e7f2;

    color: #2f7da8 !important;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: .07em;

    text-transform: uppercase;
}

/* =========================================================
   SALUDO
   ========================================================= */

.dashboard-head h1 {

    grid-area: title;

    margin: 0 !important;

    color: #213b52 !important;

    font-family:
        "Source Serif 4",
        Georgia,
        serif !important;

    font-size: clamp(28px, 3vw, 39px) !important;

    line-height: 1.04 !important;

    letter-spacing: -.025em;
}

.dashboard-head .muted {

    grid-area: text;

    margin: 3px 0 0 !important;

    color: #718496 !important;

    font-size: 12px !important;

    line-height: 1.45;
}

/* =========================================================
   CERRAR SESIÓN
   ========================================================= */

.dashboard-head-action {

    position: relative;
    z-index: 2;

    flex: 0 0 auto;
}

.dashboard-logout {

    min-width: 112px;
    height: 38px;

    display: inline-flex !important;

    align-items: center;
    justify-content: center;

    padding: 0 15px !important;

    border-radius: 10px !important;

    border: 1px solid #d6e3ec !important;

    background: #ffffff !important;

    color: #2f6f94 !important;

    box-shadow: 0 3px 10px rgba(35,80,110,.05) !important;

    font-size: 11px !important;
    font-weight: 800;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.dashboard-logout:hover {

    transform: translateY(-2px);

    border-color: #a9cadc !important;

    box-shadow:
        0 7px 16px rgba(35,80,110,.10) !important;
}

/* =========================================================
   INDICADORES
   ========================================================= */

.dashboard-kpis {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 12px;

    margin-bottom: 18px;
}

.dashboard-kpi {

    position: relative;

    min-height: 82px !important;

    display: flex;

    flex-direction: column;
    justify-content: center;

    padding: 14px 17px !important;

    box-sizing: border-box;

    border: 1px solid #dce8f0 !important;

    border-radius: 14px !important;

    background: #ffffff !important;

    box-shadow:
        0 5px 16px rgba(37,87,119,.055) !important;

    overflow: hidden;

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.dashboard-kpi::before {

    content: "";

    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    height: 3px;

    background: #4b91b8;
}

.dashboard-kpi:nth-child(2)::before,
.dashboard-kpi:nth-child(4)::before {

    background: #e8b653;
}

.dashboard-kpi:hover {

    transform: translateY(-2px);

    box-shadow:
        0 9px 20px rgba(37,87,119,.09) !important;
}

.dashboard-kpi span {

    margin-bottom: 4px;

    color: #718496 !important;

    font-size: 10px !important;

    font-weight: 700;
}

.dashboard-kpi strong {

    color: #24445d !important;

    font-family:
        "Source Serif 4",
        Georgia,
        serif !important;

    font-size: 27px !important;

    line-height: 1;
}

/* =========================================================
   CONTENIDO
   ========================================================= */

.dashboard-main {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        235px;

    gap: 18px;

    align-items: start;
}

/* =========================================================
   TARJETAS PRINCIPALES
   ========================================================= */

.dashboard-card {

    box-sizing: border-box;

    border: 1px solid #dce8f0 !important;

    border-radius: 17px !important;

    background: #ffffff !important;

    box-shadow:
        0 6px 19px rgba(37,87,119,.06) !important;
}

.dashboard-actions-card {

    padding: 20px !important;
}

.dashboard-account-card {

    padding: 20px !important;

    display: flex;

    flex-direction: column;
}

/* =========================================================
   CABECERA DE SECCIÓN
   ========================================================= */

.dashboard-card-head {

    display: flex;

    align-items: flex-start;

    gap: 14px;

    margin-bottom: 14px;
}

.dashboard-card-head .badge {

    display: inline-flex;

    width: fit-content;

    margin-bottom: 5px;

    padding: 4px 9px;

    border-radius: 999px;

    background: #edf6fb !important;

    border: 1px solid #d9eaf3;

    color: #2f7da8 !important;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: .07em;

    text-transform: uppercase;
}

.dashboard-card h2 {

    margin: 0 !important;

    color: #24445d !important;

    font-family:
        "Source Serif 4",
        Georgia,
        serif !important;

    font-size: 23px !important;

    line-height: 1.05 !important;
}

.dashboard-card-head .muted {

    max-width: 520px;

    margin: 5px 0 0 !important;

    color: #7a8b9a !important;

    font-size: 11px !important;

    line-height: 1.45;
}

/* =========================================================
   ACCIONES PEQUEÑAS
   ========================================================= */

.dashboard-action-grid {

    display: grid !important;

    grid-template-columns:
        repeat(3, minmax(0, 1fr)) !important;

    gap: 10px !important;
}

.dashboard-action {

    position: relative;

    min-height: 112px !important;

    padding: 13px 14px !important;

    box-sizing: border-box;

    display: flex !important;

    flex-direction: column;

    justify-content: flex-start;

    overflow: hidden;

    border: 1px solid #e0eaf1 !important;

    border-radius: 13px !important;

    background: #fbfdff !important;

    box-shadow: none !important;

    text-decoration: none !important;

    transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

.dashboard-action::before {

    content: "";

    position: absolute;

    left: 0;
    top: 10px;
    bottom: 10px;

    width: 3px;

    border-radius: 0 4px 4px 0;

    background: #4b91b8;
}

.dashboard-action:nth-child(even)::before {

    background: #e8b653;
}

.dashboard-action:hover {

    transform: translateY(-3px);

    border-color: #c7dce9 !important;

    background: #ffffff !important;

    box-shadow:
        0 8px 18px rgba(37,87,119,.09) !important;
}

.dashboard-action-top {

    margin-bottom: 7px;

    min-height: 22px;
}

.dashboard-action-icon {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 4px 7px;

    border-radius: 7px;

    background: #edf6fb;

    color: #2f7da8;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: .03em;

    text-transform: uppercase;
}

.dashboard-action:nth-child(even)
.dashboard-action-icon {

    background: #fff6df;

    color: #a9761c;
}

.dashboard-action h3 {

    margin: 0 !important;

    color: #24445d !important;

    font-family:
        "Public Sans",
        Arial,
        sans-serif !important;

    font-size: 13px !important;

    font-weight: 800 !important;

    line-height: 1.15 !important;
}

.dashboard-action p {

    margin: 4px 0 0 !important;

    color: #7a8b9a !important;

    font-size: 9.5px !important;

    line-height: 1.35 !important;
}

.dashboard-action-link {

    margin-top: auto;

    padding-top: 7px;

    color: #2f7da8 !important;

    font-size: 9.5px !important;

    font-weight: 800;

    text-decoration: none !important;
}

.dashboard-action:nth-child(even)
.dashboard-action-link {

    color: #a9761c !important;
}

/* =========================================================
   MI CUENTA COMPACTA
   ========================================================= */

.dashboard-account-card {

    min-height: 0 !important;
}

.dashboard-account-card .dashboard-card-head {

    margin-bottom: 8px;
}

.dashboard-account-text {

    margin: 0 !important;

    color: #7a8b9a !important;

    font-size: 10.5px !important;

    line-height: 1.5;
}

.dashboard-account-action {

    margin-top: 18px;

    padding-top: 0;
}

.dashboard-account-action .boton-full {

    width: 100%;

    min-height: 39px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 10px !important;

    background: #2f7da8 !important;

    color: #ffffff !important;

    font-size: 10.5px !important;

    font-weight: 800;

    box-shadow: none !important;

    transition:
        transform .2s ease,
        background .2s ease;
}

.dashboard-account-action .boton-full:hover {

    transform: translateY(-2px);

    background: #286d94 !important;
}

/* =========================================================
   ANIMACIONES
   ========================================================= */

.dashboard-head,
.dashboard-kpi,
.dashboard-card {

    animation:
        eduturnosDashboardEntrada
        .42s
        ease
        both;
}

.dashboard-kpi:nth-child(2) {
    animation-delay: .04s;
}

.dashboard-kpi:nth-child(3) {
    animation-delay: .08s;
}

.dashboard-kpi:nth-child(4) {
    animation-delay: .12s;
}

.dashboard-main {
    animation-delay: .10s;
}

@keyframes eduturnosDashboardEntrada {

    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1050px) {

    .dashboard-main {

        grid-template-columns: 1fr;
    }

    .dashboard-account-card {

        max-width: none;
    }

    .dashboard-action-grid {

        grid-template-columns:
            repeat(3, minmax(0, 1fr)) !important;
    }
}

/* =========================================================
   TABLET PEQUEÑA
   ========================================================= */

@media (max-width: 800px) {

    .dashboard-page {

        width: calc(100% - 30px);

        padding-top: 20px;
    }

    .dashboard-head {

        padding: 22px !important;
    }

    .dashboard-kpis {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .dashboard-action-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
    }
}

/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 560px) {

    .dashboard-head {

        align-items: flex-start;

        flex-direction: column;

        gap: 18px;
    }

    .dashboard-head-info {

        grid-template-columns:
            64px minmax(0, 1fr);

        column-gap: 13px;
    }

    .dashboard-role-art {

        width: 64px;
        height: 64px;
    }

    .role-symbol {

        width: 58px;
        height: 58px;
    }

    .dashboard-head h1 {

        font-size: 29px !important;
    }

    .dashboard-head-action {

        width: 100%;
    }

    .dashboard-logout {

        width: 100%;
    }

    .dashboard-kpis {

