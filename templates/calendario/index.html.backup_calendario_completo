<script>
(function () {

    "use strict";


    const CITAS = {{ citas|tojson }};


    let citas = Array.isArray(CITAS)
        ? CITAS.slice()
        : [];


    let fechaActual = new Date();

    let vista = "mes";


    const $ = function (id) {
        return document.getElementById(id);
    };


    function txt(valor) {
        return String(valor === null || valor === undefined ? "" : valor);
    }


    function escapar(valor) {

        return txt(valor)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    function pad(valor) {
        return String(valor).padStart(2, "0");
    }


    function isoFecha(fecha) {

        return (
            fecha.getFullYear() +
            "-" +
            pad(fecha.getMonth() + 1) +
            "-" +
            pad(fecha.getDate())
        );

    }


    function fechaHumana(fecha) {

        const partes =
            txt(fecha).split("-");

        if (partes.length !== 3) {
            return txt(fecha);
        }

        return (
            partes[2] +
            "/" +
            partes[1] +
            "/" +
            partes[0]
        );

    }


    function horaHumana(hora) {

        const partes =
            txt(hora).split(":");

        if (partes.length < 2) {
            return txt(hora);
        }

        let horas =
            parseInt(partes[0], 10);

        const minutos =
            partes[1];

        if (isNaN(horas)) {
            return txt(hora);
        }

        const periodo =
            horas >= 12 ? "p. m." : "a. m.";

        horas =
            horas % 12 || 12;

        return (
            pad(horas) +
            ":" +
            minutos +
            " " +
            periodo
        );

    }


    function nombreMes(numero) {

        const meses = [
            "enero",
            "febrero",
            "marzo",
            "abril",
            "mayo",
            "junio",
            "julio",
            "agosto",
            "septiembre",
            "octubre",
            "noviembre",
            "diciembre"
        ];

        return meses[numero];

    }


    function nombreDia(numero) {

        const dias = [
            "domingo",
            "lunes",
            "martes",
            "miÃ©rcoles",
            "jueves",
            "viernes",
            "sÃ¡bado"
        ];

        return dias[numero];

    }


    function claseEstado(estado) {

        const valor =
            txt(estado).toLowerCase();

        if (valor.indexOf("confirm") !== -1) {
            return "confirmada";
        }

        if (valor.indexOf("cancel") !== -1) {
            return "cancelada";
        }

        if (valor.indexOf("reprogram") !== -1) {
            return "reprogramada";
        }

        if (valor.indexOf("complet") !== -1) {
            return "completada";
        }

        return "pendiente";

    }


    function obtenerCitasFiltradas() {

        const busqueda =
            txt($("ed-buscar").value)
                .toLowerCase()
                .trim();


        const sede =
            txt($("ed-sede").value);


        const jornada =
            txt($("ed-jornada").value);


        const estado =
            txt($("ed-estado").value)
                .toLowerCase();


        const fechaDesde =
            txt($("ed-fecha-desde").value);


        return citas.filter(function (cita) {

            if (busqueda) {

                const contenido = [

                    cita.estudiante,
                    cita.docente,
                    cita.acudiente,
                    cita.motivo_nombre,
                    cita.sede_nombre,
                    cita.jornada_nombre,
                    cita.lugar,
                    cita.observaciones

                ]
                    .map(txt)
                    .join(" ")
                    .toLowerCase();


                if (
                    contenido.indexOf(
                        busqueda
                    ) === -1
                ) {
                    return false;
                }

            }


            if (
                sede &&
                txt(cita.id_sede) !== sede
            ) {
                return false;
            }


            if (
                jornada &&
                txt(cita.id_jornada) !== jornada
            ) {
                return false;
            }


            if (
                estado &&
                txt(cita.estado_nombre)
                    .toLowerCase() !== estado
            ) {
                return false;
            }


            if (
                fechaDesde &&
                txt(cita.fecha) < fechaDesde
            ) {
                return false;
            }


            return true;

        });

    }


    function citasDelDia(fecha, lista) {

        const iso =
            isoFecha(fecha);


        return lista

            .filter(function (cita) {

                return txt(cita.fecha) === iso;

            })

            .sort(function (a, b) {

                return txt(a.hora)
                    .localeCompare(
                        txt(b.hora)
                    );

            });

    }


    function renderCita(cita) {

        return (

            '<button ' +
            'type="button" ' +
            'class="ed-cita ' +
            claseEstado(
                cita.estado_nombre
            ) +
            '" ' +
            'data-cita="' +
            escapar(cita.id) +
            '">' +

                '<span class="ed-cita-hora">' +
                    escapar(
                        horaHumana(
                            cita.hora
                        )
                    ) +
                '</span> ' +

                escapar(
                    cita.motivo_nombre ||
                    "Cita"
                ) +

            '</button>'

        );

    }


    function renderMes(lista) {

        const contenedor =
            $("ed-vista-mes");


        const year =
            fechaActual.getFullYear();


        const month =
            fechaActual.getMonth();


        const primerDia =
            new Date(
                year,
                month,
                1
            );


        const ultimoDia =
            new Date(
                year,
                month + 1,
                0
            );


        let inicio =
            primerDia.getDay();


        inicio =
            inicio === 0
                ? 6
                : inicio - 1;


        const diasMes =
            ultimoDia.getDate();


        const celdas =
            Math.ceil(
                (inicio + diasMes) / 7
            ) * 7;


        const diasAnterior =
            new Date(
                year,
                month,
                0
            ).getDate();


        const hoy =
            isoFecha(
                new Date()
            );


        let html = "";

        html +=
            '<table class="ed-month-table">';


        html +=
            '<thead><tr>';


        [
            "Lunes",
            "Martes",
            "MiÃ©rcoles",
            "Jueves",
            "Viernes",
            "SÃ¡bado",
            "Domingo"
        ].forEach(function (dia) {

            html +=
                "<th>" +
                dia +
                "</th>";

        });


        html +=
            "</tr></thead><tbody>";


        for (
            let i = 0;
            i < celdas;
            i++
        ) {

            if (i % 7 === 0) {
                html += "<tr>";
            }


            let fechaCelda;

            let numero;

            let otroMes = false;


            if (i < inicio) {

                numero =
                    diasAnterior -
                    inicio +
                    i +
                    1;

                fechaCelda =
                    new Date(
                        year,
                        month - 1,
                        numero
                    );

                otroMes = true;

            } else if (
                i >= inicio + diasMes
            ) {

                numero =
                    i -
                    inicio -
                    diasMes +
                    1;

                fechaCelda =
                    new Date(
                        year,
                        month + 1,
                        numero
                    );

                otroMes = true;

            } else {

                numero =
                    i -
                    inicio +
                    1;

                fechaCelda =
                    new Date(
                        year,
                        month,
                        numero
                    );

            }


            const iso =
                isoFecha(
                    fechaCelda
                );


            const diaCitas =
                citasDelDia(
                    fechaCelda,
                    lista
                );


            html +=
                '<td class="ed-day-cell ' +
                (otroMes ? "otro-mes " : "") +
                (iso === hoy ? "hoy" : "") +
                '" data-fecha="' +
                iso +
                '">';


            html +=
                '<div class="ed-day-number">' +
                numero +
                "</div>";


            html +=
                '<div class="ed-day-events">';


            const max =
                Math.min(
                    diaCitas.length,
                    4
                );


            for (
                let j = 0;
                j < max;
                j++
            ) {

                html +=
                    renderCita(
                        diaCitas[j]
                    );

            }


            if (
                diaCitas.length > 4
            ) {

                html +=
                    '<div class="ed-mas">' +
                    "+ " +
                    (
                        diaCitas.length -
                        4
                    ) +
                    " mÃ¡s" +
                    "</div>";

            }


            html +=
                "</div>";


            html +=
                "</td>";


            if (
                i % 7 === 6
            ) {

                html +=
                    "</tr>";

            }

        }


        html +=
            "</tbody></table>";


        contenedor.innerHTML =
            html;


        contenedor
            .querySelectorAll(
                "[data-cita]"
            )
            .forEach(
                function (boton) {

                    boton.addEventListener(
                        "click",
                        function (event) {

                            event.stopPropagation();

                            abrirDetalle(
                                this.getAttribute(
                                    "data-cita"
                                )
                            );

                        }
                    );

                }
            );


        contenedor
            .querySelectorAll(
                ".ed-day-cell"
            )
            .forEach(
                function (celda) {

                    celda.addEventListener(
                        "dblclick",
                        function () {

                            {% if puede_crear %}

                            const fecha =
                                this.getAttribute(
                                    "data-fecha"
                                );

                            window.location.href =
                                "{{ url_for('citas.nueva') }}" +
                                "?fecha=" +
                                encodeURIComponent(
                                    fecha
                                );

                            {% endif %}

                        }
                    );

                }
            );

    }


    function renderSemana(lista) {

        const contenedor =
            $("ed-vista-semana");


        const inicio =
            new Date(
                fechaActual
            );


        const dia =
            inicio.getDay();


        const diferencia =
            dia === 0
                ? -6
                : 1 - dia;


        inicio.setDate(
            inicio.getDate() +
            diferencia
        );


        let html =
            '<div class="ed-week-wrapper">' +
            '<table class="ed-week-table">' +
            "<thead><tr>" +
            "<th>Hora</th>";


        for (
            let i = 0;
            i < 7;
            i++
        ) {

            const fecha =
                new Date(
                    inicio
                );

            fecha.setDate(
                fecha.getDate() + i
            );


            html +=
                "<th>" +
                nombreDia(
                    fecha.getDay()
                ) +
                "<br>" +
                fecha.getDate() +
                "</th>";

        }


        html +=
            "</tr></thead><tbody>";


        for (
            let hora = 6;
            hora <= 18;
            hora++
        ) {

            html +=
                "<tr>";

            html +=
                '<td class="ed-hora">' +
                pad(hora) +
                ":00</td>";


            for (
                let i = 0;
                i < 7;
                i++
            ) {

                const fecha =
                    new Date(
                        inicio
                    );

                fecha.setDate(
                    fecha.getDate() + i
                );


                const fechaIso =
                    isoFecha(
                        fecha
                    );


                const citasHora =
                    citasDelDia(
                        fecha,
                        lista
                    ).filter(
                        function (cita) {

                            const partes =
                                txt(
                                    cita.hora
                                ).split(":");

                            return (
                                Number(
                                    partes[0]
                                ) === hora
                            );

                        }
                    );


                html +=
                    '<td class="' +
                    (
                        fechaIso ===
                        isoFecha(new Date())
                            ? "ed-dia-hoy"
                            : ""
                    ) +
                    '">';


                citasHora.forEach(
                    function (cita) {

                        html += renderCita(
                            cita
                        );

                    }
                );


                html +=
                    "</td>";

            }


            html +=
                "</tr>";

        }


        html +=
            "</tbody></table></div>";


        contenedor.innerHTML =
            html;


        contenedor
            .querySelectorAll(
                "[data-cita]"
            )
            .forEach(
                function (boton) {

                    boton.addEventListener(
                        "click",
                        function () {

                            abrirDetalle(
                                this.getAttribute(
                                    "data-cita"
                                )
                            );

                        }
                    );

                }
            );

    }


    function renderDia(lista) {

        const contenedor =
            $("ed-vista-dia");


        const diaCitas =
            citasDelDia(
                fechaActual,
                lista
            );


        let html =
            '<div class="ed-day-detail">';


        html +=
            '<div class="ed-day-detail-head">' +

                "<h3>" +

                    nombreDia(
                        fechaActual.getDay()
                    ) +

                    ", " +

                    fechaActual.getDate() +

                    " de " +

                    nombreMes(
                        fechaActual.getMonth()
                    ) +

                    " de " +

                    fechaActual.getFullYear() +

                "</h3>" +

            "</div>";


        if (!diaCitas.length) {

            html +=
                '<div class="ed-sin-citas">' +

                    "<strong>No hay citas este dÃ­a</strong>" +

                    "No existen citaciones registradas para esta fecha." +

                "</div>";

        } else {

            diaCitas.forEach(
                function (cita) {

                    html +=
                        '<div class="ed-day-detail-row">' +

                            '<div class="ed-day-detail-time">' +
                                escapar(
                                    horaHumana(
                                        cita.hora
                                    )
                                ) +
                            "</div>" +

                            '<div class="ed-day-detail-content">' +

                                renderCita(
                                    cita
                                ) +

                            "</div>" +

                        "</div>";

                }
            );

        }


        html +=
            "</div>";


        contenedor.innerHTML =
            html;


        contenedor
            .querySelectorAll(
                "[data-cita]"
            )
            .forEach(
                function (boton) {

                    boton.addEventListener(
                        "click",
                        function () {

                            abrirDetalle(
                                this.getAttribute(
                                    "data-cita"
                                )
                            );

                        }
                    );

                }
            );

    }


    function renderAgenda(lista) {

        const contenedor =
            $("ed-vista-agenda");


        const ordenadas =
            lista

                .filter(function (cita) {

                    return (
                        cita.fecha &&
                        cita.hora
                    );

                })

                .slice()

                .sort(function (a, b) {

                    return (
                        (
                            txt(a.fecha) +
                            "T" +
                            txt(a.hora)
                        )
                        .localeCompare(
                            txt(b.fecha) +
                            "T" +
                            txt(b.hora)
                        )
                    );

                });


        if (!ordenadas.length) {

            contenedor.innerHTML =
                '<div class="ed-sin-citas">' +
                    "<strong>No hay citas para mostrar</strong>" +
                    "No existen citaciones con los filtros seleccionados." +
                "</div>";

            return;

        }


        let html =
            '<div class="ed-agenda">';


        ordenadas.forEach(
            function (cita) {

                html +=
                    '<div class="ed-agenda-item" data-cita="' +
                    escapar(cita.id) +
                    '">' +

                        '<div class="ed-agenda-date">' +

                            escapar(
                                fechaHumana(
                                    cita.fecha
                                )
                            ) +

                            "<br>" +

                            escapar(
                                horaHumana(
                                    cita.hora
                                )
                            ) +

                        "</div>" +


                        '<div class="ed-agenda-main">' +

                            "<strong>" +

                                escapar(
                                    cita.motivo_nombre ||
                                    "Cita escolar"
                                ) +

                            "</strong>" +


                            "<span>" +

                                escapar(
                                    cita.estudiante ||
                                    "Estudiante"
                                ) +

                                " Â· " +

                                escapar(
                                    cita.docente ||
                                    "Docente"
                                ) +

                                " Â· " +

                                escapar(
                                    cita.lugar ||
                                    "Lugar pendiente"
                                ) +

                            "</span>" +

                        "</div>" +


                        '<span class="ed-estado">' +

                            escapar(
                                cita.estado_nombre ||
                                "Pendiente"
                            ) +

                        "</span>" +

                    "</div>";

            }
        );


        html +=
            "</div>";


        contenedor.innerHTML =
            html;


        contenedor
            .querySelectorAll(
                "[data-cita]"
            )
            .forEach(
                function (elemento) {

                    elemento.addEventListener(
                        "click",
                        function () {

                            abrirDetalle(
                                this.getAttribute(
                                    "data-cita"
                                )
                            );

                        }
                    );

                }
            );

    }


    function actualizarEstadisticas(lista) {

        const hoy =
            isoFecha(
                new Date()
            );


        $("ed-total").textContent =
            lista.length;


        $("ed-hoy-total").textContent =
            lista.filter(
                function (cita) {

                    return (
                        txt(cita.fecha) ===
                        hoy
                    );

                }
            ).length;


        $("ed-pendientes").textContent =
            lista.filter(
                function (cita) {

                    return txt(
                        cita.estado_nombre
                    )
                        .toLowerCase()
                        .indexOf(
                            "pendiente"
                        ) !== -1;

                }
            ).length;


        $("ed-confirmadas").textContent =
            lista.filter(
                function (cita) {

                    return txt(
                        cita.estado_nombre
                    )
                        .toLowerCase()
                        .indexOf(
                            "confirm"
                        ) !== -1;

                }
            ).length;


        $("ed-contador").textContent =
            lista.length +
            (
                lista.length === 1
                    ? " cita"
                    : " citas"
            );

    }


    function actualizarTitulo() {

        if (vista === "mes") {

            $("ed-periodo").textContent =
                nombreMes(
                    fechaActual.getMonth()
                ) +
                " " +
                fechaActual.getFullYear();

        } else if (
            vista === "semana"
        ) {

            $("ed-periodo").textContent =
                "Semana";

        } else if (
            vista === "dia"
        ) {

            $("ed-periodo").textContent =
                nombreDia(
                    fechaActual.getDay()
                ) +
                ", " +
                fechaActual.getDate() +
                " de " +
                nombreMes(
                    fechaActual.getMonth()
                );

        } else {

            $("ed-periodo").textContent =
                "Agenda";

        }

    }


    function renderizar() {

        const lista =
            obtenerCitasFiltradas();


        actualizarEstadisticas(
            lista
        );


        actualizarTitulo();


        $("ed-vista-mes")
            .classList.toggle(
                "activa",
                vista === "mes"
            );


        $("ed-vista-semana")
            .classList.toggle(
                "activa",
                vista === "semana"
            );


        $("ed-vista-dia")
            .classList.toggle(
                "activa",
                vista === "dia"
            );


        $("ed-vista-agenda")
            .classList.toggle(
                "activa",
                vista === "agenda"
            );


        if (
            vista === "mes"
        ) {

            renderMes(lista);

        } else if (
            vista === "semana"
        ) {

            renderSemana(lista);

        } else if (
            vista === "dia"
        ) {

            renderDia(lista);

        } else {

            renderAgenda(lista);

        }


        renderProximas(lista);

    }


    function renderProximas(lista) {

        const ahora =
            new Date();


        const proximas =
            lista

                .map(function (cita) {

                    const partesFecha =
                        txt(cita.fecha)
                            .split("-");


                    const partesHora =
                        txt(cita.hora)
                            .split(":");


                    if (
                        partesFecha.length !== 3 ||
                        partesHora.length < 2
                    ) {
                        return null;
                    }


                    const fecha =
                        new Date(
                            Number(
                                partesFecha[0]
                            ),
                            Number(
                                partesFecha[1]
                            ) - 1,
                            Number(
                                partesFecha[2]
                            ),
                            Number(
                                partesHora[0]
                            ) || 0,
                            Number(
                                partesHora[1]
                            ) || 0
                        );


                    return {
                        cita: cita,
                        fecha: fecha
                    };

                })

                .filter(function (item) {

                    return (
                        item &&
                        !isNaN(
                            item.fecha.getTime()
                        ) &&
                        item.fecha >= ahora
                    );

                })

                .sort(function (a, b) {

                    return (
                        a.fecha -
                        b.fecha
                    );

                })

                .slice(0, 8);


        const contenedor =
            $("ed-proximas-lista");


        if (!proximas.length) {

            contenedor.innerHTML =
                '<div class="ed-sin-citas">' +
                    "<strong>No hay prÃ³ximas citas</strong>" +
                    "Las nuevas citaciones aparecerÃ¡n aquÃ­." +
                "</div>";

            return;

        }


        let html = "";


        proximas.forEach(
            function (item) {

                const cita =
                    item.cita;


                html +=
                    '<div class="ed-proxima" data-cita="' +
                    escapar(cita.id) +
                    '">' +

                        '<div class="ed-proxima-fecha">' +

                            escapar(
                                fechaHumana(
                                    cita.fecha
                                )
                            ) +

                            "<br>" +

                            escapar(
                                horaHumana(
                                    cita.hora
                                )
                            ) +

                        "</div>" +


                        '<div class="ed-proxima-main">' +

                            "<strong>" +

                                escapar(
                                    cita.motivo_nombre ||
                                    "Cita escolar"
                                ) +

                            "</strong>" +

                            "<span>" +

                                escapar(
                                    cita.estudiante ||
                                    "Estudiante"
                                ) +

                                " Â· " +

                                escapar(
                                    cita.docente ||
                                    "Docente"
                                ) +

                            "</span>" +

                        "</div>" +


                        '<span class="ed-estado">' +

                            escapar(
                                cita.estado_nombre ||
                                "Pendiente"
                            ) +

                        "</span>" +

                    "</div>";

            }
        );


        contenedor.innerHTML =
            html;


        contenedor
            .querySelectorAll(
                "[data-cita]"
            )
            .forEach(
                function (elemento) {

                    elemento.addEventListener(
                        "click",
                        function () {

                            abrirDetalle(
                                this.getAttribute(
                                    "data-cita"
                                )
                            );

                        }
                    );

                }
            );

    }


    function abrirDetalle(id) {

        const cita =
            citas.find(
                function (item) {

                    return (
                        String(
                            item.id
                        ) ===
                        String(id)
                    );

                }
            );


        if (!cita) {
            return;
        }


        $("ed-modal-titulo").textContent =
            cita.motivo_nombre ||
            "Detalle de la cita";


        $("det-fecha").textContent =
            fechaHumana(
                cita.fecha
            );


        $("det-hora").textContent =
            horaHumana(
                cita.hora
            );


        $("det-estudiante").textContent =
            cita.estudiante ||
            "â€”";


        $("det-documento").textContent =
            cita.estudiante_documento ||
            "â€”";


        $("det-docente").textContent =
            cita.docente ||
            "â€”";


        $("det-acudiente").textContent =
            cita.acudiente ||
            "â€”";


        $("det-motivo").textContent =
            cita.motivo_nombre ||
            "â€”";


        $("det-estado").textContent =
            cita.estado_nombre ||
            "â€”";


        $("det-sede").textContent =
            cita.sede_nombre ||
            "â€”";


        $("det-jornada").textContent =
            cita.jornada_nombre ||
            "â€”";


        $("det-lugar").textContent =
            cita.lugar ||
            "â€”";


        $("det-codigo").textContent =
            cita.codigo_estudiantil ||
            "â€”";


        $("det-observaciones").textContent =
            cita.observaciones ||
            "Sin observaciones.";


        $("det-ics").href =
            "/calendario/" +
            encodeURIComponent(
                cita.id
            ) +
            ".ics";


        $("ed-modal-fondo").style.display =
            "flex";

    }


    function cerrarModal() {

        $("ed-modal-fondo").style.display =
            "none";

    }


    $("ed-anterior")
        .addEventListener(
            "click",
            function () {

                if (vista === "mes") {

                    fechaActual =
                        new Date(
                            fechaActual.getFullYear(),
                            fechaActual.getMonth() - 1,
                            1
                        );

                } else if (
                    vista === "semana"
                ) {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setDate(
                        fechaActual.getDate() - 7
                    );

                } else if (
                    vista === "dia"
                ) {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setDate(
                        fechaActual.getDate() - 1
                    );

                } else {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setMonth(
                        fechaActual.getMonth() - 1
                    );

                }

                renderizar();

            }
        );


    $("ed-siguiente")
        .addEventListener(
            "click",
            function () {

                if (vista === "mes") {

                    fechaActual =
                        new Date(
                            fechaActual.getFullYear(),
                            fechaActual.getMonth() + 1,
                            1
                        );

                } else if (
                    vista === "semana"
                ) {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setDate(
                        fechaActual.getDate() + 7
                    );

                } else if (
                    vista === "dia"
                ) {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setDate(
                        fechaActual.getDate() + 1
                    );

                } else {

                    fechaActual =
                        new Date(
                            fechaActual
                        );

                    fechaActual.setMonth(
                        fechaActual.getMonth() + 1
                    );

                }

                renderizar();

            }
        );


    $("ed-ir-hoy")
        .addEventListener(
            "click",
            function () {

                fechaActual =
                    new Date();

                renderizar();

            }
        );


    $("ed-limpiar")
        .addEventListener(
            "click",
            function () {

                $("ed-buscar").value = "";
                $("ed-sede").value = "";
                $("ed-jornada").value = "";
                $("ed-estado").value = "";
                $("ed-fecha-desde").value = "";

                renderizar();

            }
        );


    [
        "ed-buscar",
        "ed-sede",
        "ed-jornada",
        "ed-estado",
        "ed-fecha-desde"
    ].forEach(
        function (id) {

            $(id).addEventListener(
                "input",
                renderizar
            );

            $(id).addEventListener(
                "change",
                renderizar
            );

        }
    );


    document
        .querySelectorAll(
            ".ed-vista"
        )
        .forEach(
            function (boton) {

                boton.addEventListener(
                    "click",
                    function () {

                        vista =
                            this.getAttribute(
                                "data-vista"
                            );


                        document
                            .querySelectorAll(
                                ".ed-vista"
                            )
                            .forEach(
                                function (item) {

                                    item.classList.remove(
                                        "activa"
                                    );

                                }
                            );


                        this.classList.add(
                            "activa"
                        );


                        renderizar();

                    }
                );

            }
        );


    $("ed-modal-cerrar")
        .addEventListener(
            "click",
            cerrarModal
        );


    $("ed-modal-cerrar-footer")
        .addEventListener(
            "click",
            cerrarModal
        );


    $("ed-modal-fondo")
        .addEventListener(
            "click",
            function (event) {

                if (
                    event.target ===
                    $("ed-modal-fondo")
                ) {
                    cerrarModal();
                }

            }
        );


    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape"
            ) {
                cerrarModal();
            }

        }
    );


    /*
       INICIO.
       Esta llamada genera inmediatamente
       el calendario de 30/31 dÃ­as.
    */

    renderizar();

})();
</script>

{% endblock %}
