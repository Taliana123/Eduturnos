<div class="ed-calendario">

    <div class="ed-cal-header">

        <div>

            <h1>Calendario de citas</h1>

            <p>
                Consulta las citaciones programadas dentro del calendario institucional.
            </p>

        </div>


        <div class="ed-cal-actions">

            <a
                href="{{ url_for('auth.dashboard') }}"
                class="ed-cal-btn"
            >
                â† AtrÃ¡s
            </a>

            <a
                href="{{ url_for('citas.index') }}"
                class="ed-cal-btn"
            >
                Ver citas
            </a>

            {% if puede_crear %}

            <a
                href="{{ url_for('citas.nueva') }}"
                class="ed-cal-btn ed-cal-btn-primary"
            >
                + Nueva cita
            </a>

            {% endif %}

        </div>

    </div>


    <div class="ed-cal-stats">

        <div class="ed-stat">
            <div class="ed-stat-label">Citas visibles</div>
            <div
                class="ed-stat-value"
                id="ed-total"
            >
                0
            </div>
        </div>

        <div class="ed-stat">
            <div class="ed-stat-label">Citas de hoy</div>
            <div
                class="ed-stat-value"
                id="ed-hoy-total"
            >
                0
            </div>
        </div>

        <div class="ed-stat">
            <div class="ed-stat-label">Pendientes</div>
            <div
                class="ed-stat-value"
                id="ed-pendientes"
            >
                0
            </div>
        </div>

        <div class="ed-stat">
            <div class="ed-stat-label">Confirmadas</div>
            <div
                class="ed-stat-value"
                id="ed-confirmadas"
            >
                0
            </div>
        </div>

    </div>


    <div class="ed-filtros">

        <div class="ed-filtros-grid">

            <input
                id="ed-buscar"
                type="search"
                placeholder="Buscar estudiante, docente, acudiente o motivo..."
            >


            <select id="ed-sede">

                <option value="">
                    Todas las sedes
                </option>

                {% for sede in sedes %}

                <option value="{{ sede.id }}">
                    {{ sede.nombre }}
                </option>

                {% endfor %}

            </select>


            <select id="ed-jornada">

                <option value="">
                    Todas las jornadas
                </option>

                {% for jornada in jornadas %}

                <option value="{{ jornada.id }}">
                    {{ jornada.nombre }}
                </option>

                {% endfor %}

            </select>


            <select id="ed-estado">

                <option value="">
                    Todos los estados
                </option>

                <option value="Pendiente">Pendiente</option>
                <option value="Confirmada">Confirmada</option>
                <option value="Cancelada">Cancelada</option>
                <option value="Reprogramada">Reprogramada</option>
                <option value="Completada">Completada</option>

            </select>


            <input
                id="ed-fecha-desde"
                type="date"
            >

        </div>


        <div class="ed-filtros-footer">

            <button
                type="button"
                class="ed-cal-btn"
                id="ed-limpiar"
            >
                Limpiar filtros
            </button>

            <span
                id="ed-contador"
                style="color:#758399;font-size:12px;font-weight:700;"
            >
                0 citas
            </span>

        </div>

    </div>


    <div class="ed-cal-toolbar">

        <div class="ed-cal-navigation">

            <button
                type="button"
                class="ed-nav"
                id="ed-anterior"
            >
                â€¹
            </button>

            <button
                type="button"
                class="ed-nav"
                id="ed-siguiente"
            >
                â€º
            </button>

            <button
                type="button"
                class="ed-hoy"
                id="ed-ir-hoy"
            >Hoy</button>

            <span
                class="ed-periodo"
                id="ed-periodo"
            >
                Calendario
            </span>

        </div>


        <div class="ed-vistas">

            <button
                type="button"
                class="ed-vista activa"
                data-vista="mes"
            >
                Mes
            </button>

            <button
                type="button"
                class="ed-vista"
                data-vista="semana"
            >
                Semana
            </button>

            <button
                type="button"
                class="ed-vista"
                data-vista="dia"
            >
                DÃ­a
            </button>

            <button
                type="button"
                class="ed-vista"
                data-vista="agenda"
            >
                Agenda
            </button>

        </div>

    </div>


    <div class="ed-cal-card">

        <div
            id="ed-vista-mes"
            class="ed-vista-contenido activa"
        ></div>


        <div
            id="ed-vista-semana"
            class="ed-vista-contenido"
        ></div>


        <div
            id="ed-vista-dia"
            class="ed-vista-contenido"
        ></div>


        <div
            id="ed-vista-agenda"
            class="ed-vista-contenido"
        ></div>

    </div>


    <div class="ed-proximas">

        <h2>
            PrÃ³ximas citas
        </h2>

        <div
            id="ed-proximas-lista"
            class="ed-proximas-lista"
        ></div>

    </div>

</div>


