{% extends "base.html" %}

{% block title %}Calendario de citas | EDUTURNOS{% endblock %}

{% block content %}

<style>
    .ed-calendario {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 20px;
    }

    .ed-cal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .ed-cal-header h1 {
        margin: 0;
        color: #123b68;
        font-size: 30px;
        font-weight: 800;
    }

    .ed-cal-header p {
        margin: 6px 0 0;
        color: #68778b;
        font-size: 14px;
    }

    .ed-cal-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .ed-cal-btn {
        height: 40px;
        padding: 0 14px;
        border: 1px solid #d5dee8;
        border-radius: 8px;
        background: #fff;
        color: #24364f;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
    }

    .ed-cal-btn:hover {
        background: #f5f8fb;
    }

    .ed-cal-btn-primary {
        background: #123b68;
        border-color: #123b68;
        color: #fff;
    }

    .ed-cal-btn-primary:hover {
        background: #0d3158;
    }

    .ed-cal-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .ed-stat {
        background: #fff;
        border: 1px solid #e1e7ee;
        border-radius: 10px;
        padding: 14px 16px;
    }

    .ed-stat-label {
        color: #77869a;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ed-stat-value {
        margin-top: 5px;
        color: #123b68;
        font-size: 25px;
        font-weight: 800;
    }

    .ed-filtros {
        background: #fff;
        border: 1px solid #e1e7ee;
        border-radius: 10px;
        padding: 13px;
        margin-bottom: 18px;
    }

    .ed-filtros-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
        gap: 8px;
    }

    .ed-filtros input,
    .ed-filtros select {
        width: 100%;
        height: 39px;
        padding: 0 10px;
        border: 1px solid #cdd7e2;
        border-radius: 7px;
        background: #fff;
        color: #26384f;
        font-size: 13px;
        outline: none;
    }

    .ed-filtros input:focus,
    .ed-filtros select:focus {
        border-color: #3978b7;
        box-shadow: 0 0 0 2px rgba(57,120,183,.1);
    }

    .ed-filtros-footer {
        margin-top: 9px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .ed-cal-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .ed-cal-navigation {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .ed-nav {
        width: 37px;
        height: 37px;
        border: 1px solid #d3dde7;
        border-radius: 7px;
        background: #fff;
        color: #20354e;
        font-size: 21px;
        cursor: pointer;
    }

    .ed-nav:hover {
        background: #f3f7fa;
    }

    .ed-hoy {
        height: 37px;
        padding: 0 13px;
        border: 1px solid #d3dde7;
        border-radius: 7px;
        background: #fff;
        color: #20354e;
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
    }

    .ed-periodo {
        margin-left: 8px;
        color: #123b68;
        font-size: 21px;
        font-weight: 800;
        text-transform: capitalize;
    }

    .ed-vistas {
        display: flex;
        gap: 5px;
    }

    .ed-vista {
        height: 35px;
        padding: 0 10px;
        border: 1px solid #d3dde7;
        border-radius: 7px;
        background: #fff;
        color: #58697e;
        cursor: pointer;
        font-size: 11px;
        font-weight: 800;
    }

    .ed-vista.activa {
        background: #123b68;
        border-color: #123b68;
        color: white;
    }

    .ed-cal-card {
        background: #fff;
        border: 1px solid #dfe6ed;
        border-radius: 12px;
        padding: 10px;
        overflow-x: auto;
    }

    /*
       CALENDARIO REAL
    */

    .ed-month-table {
        width: 100%;
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
        border: 1px solid #d9e1e9;
        border-radius: 9px;
        overflow: hidden;
    }

    .ed-month-table th {
        height: 44px;
        padding: 8px;
        background: #f3f6f9;
        border-right: 1px solid #dce3ea;
        border-bottom: 1px solid #dce3ea;
        color: #526276;
        font-size: 12px;
        font-weight: 800;
        text-align: center;
    }

    .ed-month-table th:last-child {
        border-right: 0;
    }

    .ed-day-cell {
        height: 145px;
        vertical-align: top;
        padding: 6px;
        background: #fff;
        border-right: 1px solid #e0e6ec;
        border-bottom: 1px solid #e0e6ec;
    }

    .ed-day-cell:last-child {
        border-right: 0;
    }

    .ed-day-cell.otro-mes {
        background: #fafbfd;
    }

    .ed-day-number {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 5px;
        color: #384a61;
        border-radius: 50%;
        font-size: 12px;
        font-weight: 800;
    }

    .ed-day-cell.hoy {
        background: #f3f8fd;
    }

    .ed-day-cell.hoy .ed-day-number {
        background: #123b68;
        color: #fff;
    }

    .ed-day-events {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .ed-cita {
        width: 100%;
        display: block;
        padding: 5px 6px;
        border: 0;
        border-left: 4px solid #28659d;
        border-radius: 5px;
        background: #edf4fb;
        color: #1c3e61;
        text-align: left;
        cursor: pointer;
        font-size: 10px;
        line-height: 1.25;
        font-weight: 700;
    }

    .ed-cita:hover {
        filter: brightness(.96);
    }

    .ed-cita.pendiente {
        border-left-color: #d4931c;
        background: #fff7e6;
        color: #73500e;
    }

    .ed-cita.confirmada {
        border-left-color: #26935d;
        background: #edf8f1;
        color: #195f3e;
    }

    .ed-cita.cancelada {
        border-left-color: #c74a4a;
        background: #fff0f0;
        color: #772626;
        opacity: .75;
    }

    .ed-cita.reprogramada {
        border-left-color: #7652af;
        background: #f4effc;
        color: #573e82;
    }

    .ed-cita.completada {
        border-left-color: #2f6fa6;
        background: #edf5fc;
        color: #245579;
    }

    .ed-cita-hora {
        font-weight: 800;
    }

    .ed-mas {
        padding: 2px 5px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
    }

    /*
       VISTAS SEMANA / DIA / AGENDA
    */

    .ed-vista-contenido {
        display: none;
    }

    .ed-vista-contenido.activa {
        display: block;
    }

    .ed-week-wrapper {
        overflow-x: auto;
    }

    .ed-week-table {
        width: 100%;
        min-width: 1000px;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .ed-week-table th {
        height: 48px;
        background: #f3f6f9;
        border: 1px solid #dce3ea;
        color: #526276;
        font-size: 11px;
        font-weight: 800;
    }

    .ed-week-table td {
        border: 1px solid #e1e7ed;
        height: 60px;
        vertical-align: top;
        padding: 4px;
    }

    .ed-hora {
        width: 70px;
        color: #7b899a;
        font-size: 10px;
        text-align: center;
        font-weight: 700;
        background: #fafbfd;
    }

    .ed-dia-hoy {
        background: #f3f8fd;
    }

    .ed-day-detail {
        border: 1px solid #dfe6ed;
        border-radius: 9px;
        overflow: hidden;
    }

    .ed-day-detail-head {
        padding: 14px;
        background: #f4f7fa;
        border-bottom: 1px solid #dde5ec;
    }

    .ed-day-detail-head h3 {
        margin: 0;
        color: #123b68;
        font-size: 18px;
        text-transform: capitalize;
    }

    .ed-day-detail-row {
        display: grid;
        grid-template-columns: 80px 1fr;
        min-height: 65px;
        border-bottom: 1px solid #e3e8ee;
    }

    .ed-day-detail-row:last-child {
        border-bottom: 0;
    }

    .ed-day-detail-time {
        padding: 16px 8px;
        color: #78879a;
        background: #fafbfd;
        border-right: 1px solid #e1e7ed;
        text-align: center;
        font-size: 11px;
        font-weight: 700;
    }

    .ed-day-detail-content {
        padding: 9px;
    }

    .ed-agenda {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .ed-agenda-item {
        display: grid;
        grid-template-columns: 105px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border: 1px solid #e0e6ed;
        border-radius: 8px;
        background: #fbfcfd;
        cursor: pointer;
    }

    .ed-agenda-date {
        color: #123b68;
        font-size: 11px;
        font-weight: 800;
    }

    .ed-agenda-main strong {
        display: block;
        color: #203149;
        font-size: 12px;
    }

    .ed-agenda-main span {
        display: block;
        margin-top: 3px;
        color: #758399;
        font-size: 11px;
    }

    .ed-estado {
        padding: 5px 8px;
        border-radius: 999px;
        background: #edf1f5;
        color: #4a5a70;
        font-size: 10px;
        font-weight: 800;
    }

    /*
       PROXIMAS
    */

    .ed-proximas {
        margin-top: 16px;
        border: 1px solid #e0e6ed;
        border-radius: 11px;
        background: #fff;
        padding: 15px;
    }

    .ed-proximas h2 {
        margin: 0 0 11px;
        color: #123b68;
        font-size: 18px;
    }

    .ed-proximas-lista {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .ed-proxima {
        display: grid;
        grid-template-columns: 110px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 10px;
        border: 1px solid #e5eaf0;
        border-radius: 8px;
        background: #fafcfd;
        cursor: pointer;
    }

    .ed-proxima-fecha {
        color: #123b68;
        font-size: 11px;
        font-weight: 800;
    }

    .ed-proxima-main strong {
        display: block;
        color: #243750;
        font-size: 12px;
    }

    .ed-proxima-main span {
        display: block;
        margin-top: 2px;
        color: #79879a;
        font-size: 11px;
    }

    /*
       MODAL
    */

    .ed-modal-fondo {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(10, 24, 41, .58);
    }

    .ed-modal {
        width: min(720px, 100%);
        max-height: 90vh;
        overflow-y: auto;
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 24px 70px rgba(0,0,0,.25);
    }

    .ed-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 17px;
        border-bottom: 1px solid #e0e6ed;
    }

    .ed-modal-head h3 {
        margin: 0;
        color: #123b68;
        font-size: 19px;
    }

    .ed-modal-close {
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 7px;
        background: #f1f4f7;
        color: #44556b;
        cursor: pointer;
        font-size: 19px;
    }

    .ed-modal-body {
        padding: 17px;
    }

    .ed-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

    .ed-detail {
        padding: 11px;
        border: 1px solid #e1e7ed;
        border-radius: 8px;
        background: #f8fafc;
    }

    .ed-detail-full {
        grid-column: 1 / -1;
    }

    .ed-detail-label {
        margin-bottom: 3px;
        color: #7c8999;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ed-detail-value {
        color: #263750;
        font-size: 12px;
        font-weight: 700;
        word-break: break-word;
    }

    .ed-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 13px 17px;
        border-top: 1px solid #e0e6ed;
    }

    .ed-sin-citas {
        padding: 45px 20px;
        text-align: center;
        color: #7b899b;
    }

    .ed-sin-citas strong {
        display: block;
        margin-bottom: 5px;
        color: #384a61;
        font-size: 16px;
    }

    @media (max-width: 900px) {

        .ed-cal-stats {
            grid-template-columns: 1fr 1fr;
        }

        .ed-filtros-grid {
            grid-template-columns: 1fr 1fr;
        }

    }

    @media (max-width: 600px) {

        .ed-calendario {
            padding: 10px;
        }

        .ed-cal-header h1 {
            font-size: 25px;
        }

        .ed-filtros-grid {
            grid-template-columns: 1fr;
        }

        .ed-cal-stats {
            grid-template-columns: 1fr 1fr;
        }

        .ed-cal-header-actions {
            width: 100%;
        }

        .ed-cal-actions {
            width: 100%;
        }

        .ed-cal-actions .ed-cal-btn {
            flex: 1;
        }

        .ed-detail-grid {
            grid-template-columns: 1fr;
        }

        .ed-detail-full {
            grid-column: auto;
        }

    }
