        "filtroEstado",
        "filtroDesde",
        "filtroHasta"
    ].forEach(function(id) {

        const elemento =
            document.getElementById(id);

        if (elemento) {
            elemento.value = "";
        }

    });

    cambiarVista();
}

document.addEventListener(
    "DOMContentLoaded",
    function() {

        document.getElementById(
            "vistaCalendario"
        ).addEventListener(
            "change",
            function() {

                vistaActual = this.value;

                cambiarVista();

            }
        );

        document.getElementById(
            "anterior"
        ).addEventListener(
            "click",
            function() {

                if (vistaActual === "month") {
                    fechaActual.setMonth(
                        fechaActual.getMonth() - 1
                    );
                } else if (
                    vistaActual === "week"
                ) {
                    fechaActual.setDate(
                        fechaActual.getDate() - 7
                    );
                } else if (
                    vistaActual === "day"
                ) {
                    fechaActual.setDate(
                        fechaActual.getDate() - 1
                    );
                } else {
                    fechaActual.setDate(
                        fechaActual.getDate() - 7
                    );
                }

                cambiarVista();

            }
        );

        document.getElementById(
            "siguiente"
        ).addEventListener(
            "click",
            function() {

                if (vistaActual === "month") {
                    fechaActual.setMonth(
                        fechaActual.getMonth() + 1
                    );
                } else if (
                    vistaActual === "week"
                ) {
                    fechaActual.setDate(
                        fechaActual.getDate() + 7
                    );
                } else if (
                    vistaActual === "day"
                ) {
                    fechaActual.setDate(
                        fechaActual.getDate() + 1
                    );
                } else {
                    fechaActual.setDate(
                        fechaActual.getDate() + 7
                    );
                }

                cambiarVista();

            }
        );

        document.getElementById(
            "hoy"
        ).addEventListener(
            "click",
            function() {

                fechaActual = new Date();

                cambiarVista();

            }
        );

        document.getElementById(
            "actualizar"
        ).addEventListener(
            "click",
            function() {

                window.location.reload();

            }
        );

        [
            "filtroEstudiante",
            "filtroSede",
            "filtroJornada",
            "filtroDocente",
            "filtroMotivo",
            "filtroEstado",
            "filtroDesde",
            "filtroHasta"
        ].forEach(function(id) {

            document.getElementById(id)
                .addEventListener(
                    "input",
                    cambiarVista
                );

            document.getElementById(id)
                .addEventListener(
                    "change",
                    cambiarVista
                );

        });

        document.getElementById(
            "limpiarFiltros"
        ).addEventListener(
            "click",
            limpiarFiltros
        );

        document.getElementById(
            "cerrarModal"
        ).addEventListener(
            "click",
            cerrarModal
        );

        document.getElementById(
            "cerrarModal2"
        ).addEventListener(
            "click",
            cerrarModal
        );

        document.getElementById(
            "modalCita"
        ).addEventListener(
            "click",
            function(evento) {

                if (evento.target === this) {
                    cerrarModal();
                }

            }
        );

        document.addEventListener(
            "keydown",
            function(evento) {

                if (evento.key === "Escape") {
                    cerrarModal();
                }

            }
        );

        cambiarVista();

    }
);

