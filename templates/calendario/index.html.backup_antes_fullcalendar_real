<script>

const CITAS_REALES = {{ citas|tojson }};

let fechaActual = new Date();
let vistaActual = "month";

const meses = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre"
];

function claveFecha(date) {
    return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, "0"),
        String(date.getDate()).padStart(2, "0")
    ].join("-");
}

function parseFecha(valor) {
    const p = String(valor || "").slice(0, 10).split("-");

    if (p.length !== 3) {
        return null;
    }

    return new Date(
        Number(p[0]),
        Number(p[1]) - 1,
        Number(p[2])
    );
}

function fechaBonita(valor) {
    const d = parseFecha(valor);

    if (!d) {
        return valor || "â€”";
    }

    return d.toLocaleDateString(
        "es-CO",
        {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
        }
    );
}

function estadoClase(estado) {

    const e = String(estado || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    if (e.includes("pend")) {
        return "pendiente";
    }

    if (e.includes("confirm")) {
        return "confirmada";
    }

    if (
        e.includes("cancel") ||
        e.includes("venc")
    ) {
        return "cancelada";
    }

    if (e.includes("reprogram")) {
        return "reprogramada";
    }

    return "";
}

function getCitasFiltradas() {

    const estudiante =
        document.getElementById("filtroEstudiante")
        .value
        .trim()
        .toLowerCase();

    const sede =
        document.getElementById("filtroSede").value;

    const jornada =
        document.getElementById("filtroJornada").value;

    const docente =
        document.getElementById("filtroDocente").value;

    const motivo =
        document.getElementById("filtroMotivo").value;

    const estado =
        document.getElementById("filtroEstado").value;

    const desde =
        document.getElementById("filtroDesde").value;

    const hasta =
        document.getElementById("filtroHasta").value;

    return CITAS_REALES.filter(function(cita) {

        const texto = [
            cita.estudiante,
            cita.documento_estudiante,
            cita.codigo_estudiantil,
            cita.docente,
            cita.acudiente,
            cita.motivo,
            cita.lugar,
            cita.estado
        ]
            .join(" ")
            .toLowerCase();

        if (
            estudiante &&
            !texto.includes(estudiante)
        ) {
            return false;
        }

        if (
            sede &&
            String(cita.id_sede || cita.sede_id || "") !== sede &&
            String(cita.sede || "") !==
                document.querySelector(
                    '#filtroSede option[value="' + sede + '"]'
                )?.textContent?.trim()
        ) {
            const idSedeEncontrada = CITAS_REALES
                .filter(x => x.id === cita.id)
                .map(x => x.id_sede)[0];

            if (
                idSedeEncontrada !== undefined &&
                String(idSedeEncontrada) !== sede
            ) {
                return false;
            }
        }

        if (
            jornada &&
            String(cita.id_jornada || cita.jornada_id || "") !== jornada
        ) {
            const jornadaTexto =
                document.querySelector(
                    '#filtroJornada option[value="' + jornada + '"]'
                )?.textContent?.trim();

            if (
                jornadaTexto &&
                String(cita.jornada || "").trim() !== jornadaTexto
            ) {
                return false;
            }
        }

        if (
            docente &&
            String(cita.id_docente) !== docente
        ) {
            return false;
        }

        if (
            motivo &&
            String(cita.id_motivo) !== motivo
        ) {
            return false;
        }

        if (
            estado &&
            String(cita.id_estado) !== estado
        ) {
            return false;
        }

        if (
            desde &&
            cita.fecha < desde
        ) {
            return false;
        }

        if (
            hasta &&
            cita.fecha > hasta
        ) {
            return false;
        }

        return true;
    });
}

