function renderMes(lista) {

    const contenedor =
        document.getElementById("vistaMes");

    contenedor.innerHTML = "";

    const year = fechaActual.getFullYear();
    const month = fechaActual.getMonth();

    document.getElementById("tituloCalendario").textContent =
        meses[month] + " " + year;

    const primerDia = new Date(year, month, 1);

    let inicio = primerDia.getDay();

    if (inicio === 0) {
        inicio = 7;
    }

    inicio -= 1;

    const totalDias =
        new Date(year, month + 1, 0).getDate();

    const anterior =
        new Date(year, month, 0).getDate();

    const agrupadas = {};

    lista.forEach(function(cita) {

        if (!agrupadas[cita.fecha]) {
            agrupadas[cita.fecha] = [];
        }

        agrupadas[cita.fecha].push(cita);

    });

    const hoy = claveFecha(new Date());

    for (let i = 0; i < 42; i++) {

        let numero = i - inicio + 1;

        let fecha;

        if (numero <= 0) {
            fecha = new Date(
                year,
                month - 1,
                anterior + numero
            );
        } else if (numero > totalDias) {
            fecha = new Date(
                year,
                month + 1,
                numero - totalDias
            );
        } else {
            fecha = new Date(
                year,
                month,
                numero
            );
        }

        const clave = claveFecha(fecha);

        const celda =
            document.createElement("div");

        celda.className = "ed-day";

        if (fecha.getMonth() !== month) {
            celda.classList.add("other");
        }

        if (clave === hoy) {
            celda.classList.add("today");
        }

        const numeroDiv =
            document.createElement("div");

        numeroDiv.className =
            "ed-number";

        numeroDiv.innerHTML =
            "<span>" + fecha.getDate() + "</span>";

        celda.appendChild(numeroDiv);

        const citasDia =
            agrupadas[clave] || [];

        citasDia
            .slice(0, 3)
            .forEach(function(cita) {
                celda.appendChild(
                    crearEvento(cita)
                );
            });

        if (citasDia.length > 3) {

            const mas =
                document.createElement("div");

            mas.className = "ed-more";

            mas.textContent =
                "+" + (citasDia.length - 3) + " mÃ¡s";

            celda.appendChild(mas);
        }

        celda.addEventListener(
            "click",
            function() {

                if (citasDia.length === 1) {
                    abrirModal(citasDia[0]);
                } else if (citasDia.length > 1) {

                    document.getElementById(
                        "vistaCalendario"
                    ).value = "day";

                    fechaActual = fecha;
                    vistaActual = "day";

                    cambiarVista();

                }

            }
        );

        contenedor.appendChild(celda);
    }
}

