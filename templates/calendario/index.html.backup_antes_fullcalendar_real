function cambiarVista() {

    const lista =
        getCitasFiltradas();

    actualizarEstadisticas(lista);

    document.getElementById("vistaMes")
        .style.display = "none";

    document.getElementById("vistaSemana")
        .classList.remove("active");

    document.getElementById("vistaDia")
        .classList.remove("active");

    document.getElementById("vistaLista")
        .classList.remove("active");

    if (vistaActual === "month") {

        document.getElementById("vistaMes")
            .style.display = "grid";

        renderMes(lista);

    } else if (vistaActual === "week") {

        document.getElementById("vistaSemana")
            .classList.add("active");

        renderSemana(lista);

    } else if (vistaActual === "day") {

        document.getElementById("vistaDia")
            .classList.add("active");

        renderDia(lista);

    } else {

        document.getElementById("vistaLista")
            .classList.add("active");

        renderLista(lista);

    }

}

