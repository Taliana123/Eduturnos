{% extends 'base.html' %}

{% block title %}Calendario · EDUTURNOS{% endblock %}

{% block content %}

<style>
.cal-wrap {
    max-width: 1450px;
    margin: 0 auto;
}

.cal-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.cal-top h1 {
    margin: 8px 0 5px;
}

.cal-top p {
    margin: 0;
    opacity: .72;
}

.cal-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.cal-tools {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 12px;
    margin-bottom: 14px;
}

.cal-tools input,
.cal-tools select {
    width: 100%;
    min-height: 44px;
    box-sizing: border-box;
}

.cal-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 7px 24px rgba(0,0,0,.08);
    border: 1px solid rgba(0,0,0,.06);
    overflow: hidden;
}

.cal-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 16px;
    border-bottom: 1px solid #e8edf3;
    flex-wrap: wrap;
}

.cal-toolbar-left,
.cal-toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.cal-month-title {
    min-width: 210px;
    text-align: center;
    font-size: 1.2rem;
    font-weight: 700;
}

.cal-btn {
    border: 1px solid #d9e0e8;
    background: #fff;
    color: #243447;
    border-radius: 9px;
    min-height: 40px;
    padding: 0 13px;
    cursor: pointer;
    font: inherit;
}

.cal-btn:hover {
    background: #f4f7fa;
}

.cal-btn-primary {
    background: #1f4f8f;
    color: #fff;
    border-color: #1f4f8f;
}

.cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
}

.cal-weekday {
    text-align: center;
    padding: 10px 5px;
    background: #f7f9fc;
    color: #667085;
    font-size: .82rem;
    font-weight: 700;
    border-right: 1px solid #e8edf3;
    border-bottom: 1px solid #e8edf3;
}

.cal-day {
    min-height: 128px;
    padding: 8px;
    border-right: 1px solid #e8edf3;
    border-bottom: 1px solid #e8edf3;
    background: #fff;
    cursor: pointer;
    transition: background .15s ease;
}

.cal-day:hover {
    background: #f8fbff;
}

.cal-day.other-month {
    background: #fafbfc;
    color: #a0a8b2;
}

.cal-day.today {
    background: #eef5ff;
}

.cal-day-number {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: .86rem;
    font-weight: 700;
}

.cal-day-number span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    border-radius: 50%;
}

.cal-day.today .cal-day-number span {
    background: #1f4f8f;
    color: #fff;
}

.cal-event {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 4px 0;
    padding: 5px 6px;
    border-radius: 7px;
    font-size: .74rem;
    line-height: 1.25;
    color: #18324c;
    background: #e8f0fb;
    border-left: 3px solid #1f4f8f;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cal-event.pendiente {
    background: #fff5d9;
    border-left-color: #d99a00;
}

.cal-event.confirmada,
.cal-event.confirmado {
    background: #e8f7ef;
    border-left-color: #18845a;
}

.cal-event.cancelada,
.cal-event.cancelado {
    background: #fdeaea;
    border-left-color: #bd3b3b;
}

.cal-event.reprogramada,
.cal-event.reprogramado {
    background: #eaf1ff;
    border-left-color: #4777c7;
}

.cal-more {
    font-size: .72rem;
    color: #52657a;
    padding: 2px 4px;
}

.cal-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, .7fr);
    gap: 16px;
    margin-top: 16px;
}

.cal-list {
    padding: 0 16px 10px;
}

.cal-list-title {
    padding: 16px 0 8px;
    font-size: 1rem;
    font-weight: 700;
}

.cal-row {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #edf0f4;
}

.cal-row:last-child {
    border-bottom: 0;
}

.cal-row-date {
    font-weight: 700;
}

.cal-row-info strong {
    display: block;
    margin-bottom: 3px;
}

.cal-row-info span {
    font-size: .84rem;
    color: #667085;
}

.cal-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 5px 9px;
    white-space: nowrap;
    font-size: .75rem;
    font-weight: 700;
    background: #edf1f5;
    color: #495565;
}

.cal-status.pendiente {
    background: #fff5d9;
    color: #876100;
}

.cal-status.confirmada,
.cal-status.confirmado {
    background: #e8f7ef;
    color: #146c4b;
}

.cal-status.cancelada,
.cal-status.cancelado {
    background: #fdeaea;
    color: #9d2d2d;
}

.cal-status.reprogramada,
.cal-status.reprogramado {
    background: #eaf1ff;
    color: #285aa5;
}

.cal-empty {
    text-align: center;
    padding: 30px 15px;
    color: #667085;
}

.cal-legend {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding: 14px 16px;
    border-top: 1px solid #edf0f4;
}

.cal-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .78rem;
    color: #596576;
}

.cal-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1f4f8f;
}

.cal-dot.pendiente { background: #d99a00; }
.cal-dot.confirmada { background: #18845a; }
.cal-dot.cancelada { background: #bd3b3b; }
.cal-dot.reprogramada { background: #4777c7; }

.cal-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(17,24,39,.56);
    z-index: 10000;
}

.cal-modal.open {
    display: flex;
}

.cal-modal-box {
    width: min(700px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0,0,0,.22);
}

.cal-modal-head {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 22px 14px;
    border-bottom: 1px solid #edf0f4;
}

.cal-modal-head h2 {
    margin: 6px 0 0;
}

.cal-close {
    border: 0;
    background: #f0f3f7;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    cursor: pointer;
    font-size: 20px;
}

.cal-modal-body {
    padding: 18px 22px 22px;
}

.cal-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 12px;
}

.cal-detail {
    background: #f8fafc;
    border-radius: 10px;
    padding: 12px;
}

.cal-detail.full {
    grid-column: 1 / -1;
}

.cal-detail small {
    display: block;
    color: #667085;
    font-weight: 700;
    margin-bottom: 4px;
}

.cal-modal-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
}

@media (max-width: 900px) {
    .cal-bottom {
        grid-template-columns: 1fr;
    }

    .cal-day {
        min-height: 100px;
    }
}

@media (max-width: 700px) {
    .cal-tools {
        grid-template-columns: 1fr;
    }

    .cal-month-title {
        min-width: 150px;
    }

    .cal-day {
        min-height: 84px;
        padding: 5px;
    }

    .cal-event {
        font-size: .67rem;
    }

    .cal-row {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .cal-detail-grid {
        grid-template-columns: 1fr;
    }

    .cal-detail.full {
        grid-column: auto;
    }

    .cal-weekday {
        font-size: .72rem;
        padding: 8px 2px;
    }
}
</style>

<section class="cal-wrap">

    <div class="cal-top">

        <div>
            <a
                class="link-back"
                href="{{ request.referrer or url_for('auth.dashboard') }}"
            >
                ← Atrás
            </a>

            <h1>Calendario</h1>
            <p>Agenda real de tus citaciones registradas en EDUTURNOS.</p>
        </div>

        <div class="cal-actions">

            <a
                class="boton"
                href="{{ url_for('citas.index') }}"
            >
                Ver citas
            </a>

            {% if usuario_sesion is defined and usuario_sesion %}
                {% if usuario_sesion.rol_nombre in ['Docente', 'Administrador / Coordinador', 'Rector', 'Super Admin'] %}
                    <a
                        class="boton"
                        href="{{ url_for('citas.nueva') }}"
                    >
                        + Nueva citación
                    </a>
                {% endif %}
            {% endif %}

        </div>

    </div>

    <div class="cal-tools">

        <input
            type="search"
            id="calBusqueda"
            placeholder="Buscar estudiante, docente, motivo o lugar..."
