                    ‹
                </button>

                <button
                    type="button"
                    class="cal-btn"
                    id="calHoy"
                >
                    Hoy
                </button>

                <button
                    type="button"
                    class="cal-btn"
                    id="calSiguiente"
                >
                    ›
