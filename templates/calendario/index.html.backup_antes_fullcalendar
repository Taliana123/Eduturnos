        document.getElementById("detalleContenido");

    const proximasCitas =
        document.getElementById("proximasCitas");


    /* =====================================================
       CARGAR CITAS REALES
       ===================================================== */

    const elementos =
        document.querySelectorAll(".cita-data");


    const citas = Array.from(elementos).map(
        function (elemento) {

            return {
                id: elemento.dataset.id || "",

                fecha:
                    elemento.dataset.fecha || "",

                hora:
                    normalizarHora(
                        elemento.dataset.hora || ""
                    ),

                estudiante:
                    elemento.dataset.estudiante || "",

                docente:
                    elemento.dataset.docente || "",

                acudiente:
                    elemento.dataset.acudiente || "",

                motivo:
                    elemento.dataset.motivo || "CitaciÃ³n",

                estado:
                    elemento.dataset.estado || "Pendiente",

                lugar:
                    elemento.dataset.lugar || "Por definir",

                observaciones:
                    elemento.dataset.observaciones || "",

                ics:
                    elemento.dataset.ics || ""
            };

        }
    );


    /* =====================================================
       FECHAS
       ===================================================== */

    const hoy = new Date();

    hoy.setHours(
        0, 0, 0, 0
    );


    let mesVista = new Date(
        hoy.getFullYear(),
        hoy.getMonth(),
        1
    );


    let diaSeleccionado = new Date(hoy);


    function normalizarHora(valor) {

        const partes =
            String(valor).split(":");

        if (partes.length < 2) {
            return valor;
        }

        return String(partes[0]).padStart(2, "0")
            + ":"
            + String(partes[1]).padStart(2, "0");
    }


    function convertirFecha(texto) {

        if (!texto) {
            return null;
        }

        const partes =
            String(texto).split("-");

        if (partes.length !== 3) {
            return null;
        }

        const aÃ±o = Number(partes[0]);
        const mes = Number(partes[1]) - 1;
        const dia = Number(partes[2]);

        if (
            !Number.isInteger(aÃ±o) ||
            !Number.isInteger(mes) ||
            !Number.isInteger(dia)
        ) {
            return null;
        }

        return new Date(
            aÃ±o,
            mes,
            dia
        );
    }


    function claveFecha(fecha) {

        return fecha.getFullYear()
            + "-"
            + String(
                fecha.getMonth() + 1
            ).padStart(2, "0")
            + "-"
            + String(
                fecha.getDate()
            ).padStart(2, "0");
    }


    function textoFecha(fecha) {

        return new Intl.DateTimeFormat(
            "es-CO",
            {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric"
            }
        ).format(fecha);
    }


    function nombreMes(fecha) {

        const texto =
            new Intl.DateTimeFormat(
                "es-CO",
                {
                    month: "long",
                    year: "numeric"
                }
            ).format(fecha);

        return texto.charAt(0).toUpperCase()
            + texto.slice(1);
    }


    function claseEstado(estado) {

        const valor =
            String(estado)
                .toLowerCase()
                .normalize("NFD")
                .replace(
                    /[\u0300-\u036f]/g,
                    ""
                );

        if (valor.includes("confirm")) {
            return "confirmada";
        }

        if (valor.includes("reprogram")) {
            return "reprogramada";
        }

        if (
            valor.includes("cancel")
            ||
            valor.includes("anulad")
        ) {
            return "cancelada";
        }

        return "pendiente";
    }


    function citasFiltradas() {

        const filtro =
            filtroEstado.value;

        if (filtro === "Todos") {
            return citas;
        }

        return citas.filter(
            function (cita) {
                return cita.estado === filtro;
            }
        );
    }


    /* =====================================================
       RENDER CALENDARIO
       ===================================================== */

    function renderCalendario() {

        grid.innerHTML = "";

        mesActual.textContent =
            nombreMes(mesVista);


        const aÃ±o =
            mesVista.getFullYear();

        const mes =
            mesVista.getMonth();


        const primerDia =
            new Date(aÃ±o, mes, 1);


        /*
           Lunes = 0
           Domingo = 6
        */

        const desplazamiento =
            primerDia.getDay() === 0
                ? 6
                : primerDia.getDay() - 1;


        const diasMes =
            new Date(
                aÃ±o,
                mes + 1,
                0
            ).getDate();


        const diasAnterior =
            new Date(
                aÃ±o,
                mes,
                0
            ).getDate();


        const visibles =
            citasFiltradas();


        for (
            let indice = 0;
            indice < 42;
            indice++
        ) {

            let fecha;
            let numero;
            let otroMes = false;


            if (
                indice < desplazamiento
            ) {

                numero =
                    diasAnterior
                    - desplazamiento
                    + indice
                    + 1;

                fecha =
                    new Date(
                        aÃ±o,
                        mes - 1,
                        numero
                    );

                otroMes = true;

            } else if (
                indice >=
                desplazamiento + diasMes
            ) {

                numero =
                    indice
                    - desplazamiento
                    - diasMes
                    + 1;

                fecha =
                    new Date(
                        aÃ±o,
                        mes + 1,
                        numero
                    );

                otroMes = true;

            } else {

                numero =
                    indice
                    - desplazamiento
                    + 1;

                fecha =
                    new Date(
                        aÃ±o,
                        mes,
                        numero
                    );
            }


            const clave =
                claveFecha(fecha);


            const eventos =
                visibles.filter(
                    function (cita) {
                        return cita.fecha === clave;
                    }
                );


            const celda =
                document.createElement("div");


            celda.className =
                "cal-day";


            if (otroMes) {
                celda.classList.add(
                    "other-month"
                );
            }


            if (
                clave === claveFecha(hoy)
            ) {

                celda.classList.add(
                    "today"
                );
            }


            if (
                diaSeleccionado
                &&
                clave ===
                claveFecha(diaSeleccionado)
            ) {

                celda.classList.add(
                    "selected"
                );
            }


            const numeroElemento =
                document.createElement("div");


            numeroElemento.className =
                "cal-day-number";


            numeroElemento.textContent =
                numero;


            celda.appendChild(
                numeroElemento
            );


            const eventosContenedor =
                document.createElement("div");


            eventosContenedor.className =
                "cal-events";


            eventos
                .slice(0, 3)
                .forEach(
                    function (cita) {

                        const evento =
                            document.createElement("button");


                        evento.type =
                            "button";


                        evento.className =
                            "cal-event "
                            + claseEstado(
                                cita.estado
                            );


                        const hora =
                            document.createElement("span");


                        hora.className =
                            "cal-event-time";


                        hora.textContent =
                            cita.hora
                            || "Sin hora";


                        const nombre =
                            document.createElement("span");


                        nombre.className =
                            "cal-event-name";


                        nombre.textContent =
                            cita.motivo
                            || cita.estudiante
                            || "CitaciÃ³n";


                        evento.appendChild(hora);
                        evento.appendChild(nombre);


                        evento.addEventListener(
                            "click",
                            function (e) {

                                e.stopPropagation();

                                diaSeleccionado =
                                    new Date(fecha);

                                renderCalendario();

                                mostrarDetalle(
                                    fecha
                                );

                                document
                                    .querySelector(
                                        ".cal-detail-card"
                                    )
                                    .scrollIntoView({
                                        behavior: "smooth",
                                        block: "start"
                                    });
                            }
                        );


                        eventosContenedor.appendChild(
                            evento
                        );

                    }
                );


            if (
                eventos.length > 3
            ) {

                const mas =
                    document.createElement("div");


                mas.className =
                    "cal-more";


                mas.textContent =
                    "+"
                    + (
                        eventos.length - 3
                    )
                    + " mÃ¡s";


                eventosContenedor.appendChild(
                    mas
                );
            }


            celda.appendChild(
                eventosContenedor
            );


            if (!otroMes) {

                celda.addEventListener(
                    "click",
                    function () {

                        diaSeleccionado =
                            new Date(fecha);

                        renderCalendario();

                        mostrarDetalle(
                            fecha
                        );

                    }
                );
            }


            grid.appendChild(celda);
        }

    }


    /* =====================================================
       DETALLE
       ===================================================== */

    function mostrarDetalle(fecha) {

        const clave =
            claveFecha(fecha);


        const eventos =
            citas
                .filter(
                    function (cita) {
                        return (
                            cita.fecha === clave
                            &&
                            (
                                filtroEstado.value
                                === "Todos"
                                ||
                                cita.estado
                                === filtroEstado.value
                            )
                        );
                    }
                )
                .sort(
                    function (a, b) {
                        return a.hora.localeCompare(
                            b.hora
                        );
                    }
                );


        detalleTitulo.textContent =
            capitalizar(
                textoFecha(fecha)
            );


        detalleSubtitulo.textContent =
            eventos.length === 0
                ? "No tienes citaciones programadas para este dÃ­a."
                : eventos.length === 1
                    ? "Tienes 1 citaciÃ³n programada."
                    : "Tienes "
                        + eventos.length
                        + " citaciones programadas.";


        detalleContenido.innerHTML = "";


        if (eventos.length === 0) {

            detalleContenido.innerHTML = `
                <div class="cal-empty">
                    <div class="cal-empty-icon">âœ“</div>
                    <h3>DÃ­a sin citaciones</h3>
                    <p>
                        No hay citas para esta fecha
                        con el filtro seleccionado.
                    </p>
                </div>
            `;

            return;
        }


        eventos.forEach(
            function (cita) {

                const item =
                    document.createElement("article");


                item.className =
                    "cal-detail-item";


                const hora =
                    document.createElement("div");


                hora.className =
                    "cal-detail-time";


                hora.textContent =
                    cita.hora || "Sin hora";


                const contenido =
                    document.createElement("div");


                contenido.className =
                    "cal-detail-content";


                const titulo =
                    document.createElement("h3");


                titulo.textContent =
                    cita.motivo
                    || "CitaciÃ³n";


                contenido.appendChild(
                    titulo
                );


                agregarLinea(
                    contenido,
                    "Estudiante: ",
                    cita.estudiante
                );


                agregarLinea(
                    contenido,
                    "Docente: ",
                    cita.docente
                );


                if (cita.acudiente) {

                    agregarLinea(
                        contenido,
                        "Acudiente: ",
                        cita.acudiente
                    );
                }


                agregarLinea(
                    contenido,
                    "Lugar: ",
                    cita.lugar
                );


                if (cita.observaciones) {

                    agregarLinea(
                        contenido,
                        "Observaciones: ",
                        cita.observaciones
                    );
                }


                if (cita.ics) {

                    const enlace =
                        document.createElement("a");

                    enlace.href =
                        cita.ics;

                    enlace.target =
                        "_blank";

                    enlace.className =
                        "cal-ics";

                    enlace.textContent =
                        "Agregar al calendario (.ics)";

                    contenido.appendChild(
                        enlace
                    );
                }


                const estado =
                    document.createElement("span");


                estado.className =
                    "cal-detail-status "
                    + claseEstado(
                        cita.estado
                    );


                estado.textContent =
                    cita.estado;


                item.appendChild(hora);

                item.appendChild(
                    contenido
                );

                item.appendChild(
                    estado
                );


                detalleContenido.appendChild(
                    item
                );

            }
        );

    }


    function agregarLinea(
        contenedor,
        etiqueta,
        valor
    ) {

        const linea =
            document.createElement("p");


        const fuerte =
            document.createElement("strong");


        fuerte.textContent =
            etiqueta;


        linea.appendChild(
            fuerte
        );


        linea.appendChild(
            document.createTextNode(
                valor || "No informado"
            )
        );


        contenedor.appendChild(
            linea
        );

    }


    function capitalizar(texto) {

        if (!texto) {
            return "";
        }

        return (
            texto.charAt(0).toUpperCase()
            + texto.slice(1)
        );
    }


    /* =====================================================
       PRÃ“XIMAS CITAS
       ===================================================== */

    function renderProximas() {

        const ahora =
            new Date();

        ahora.setHours(
            0, 0, 0, 0
        );


        const siguientes =
            citas
                .map(
                    function (cita) {

                        return {
                            cita: cita,
                            fecha:
                                convertirFecha(
                                    cita.fecha
                                )
                        };

                    }
                )
                .filter(
                    function (obj) {

                        return (
                            obj.fecha
                            &&
                            obj.fecha >= ahora
                            &&
                            claseEstado(
                                obj.cita.estado
                            )
                            !== "cancelada"
                        );

                    }
                )
                .sort(
                    function (a, b) {

                        if (
                            a.fecha - b.fecha
                        ) {
                            return (
                                a.fecha - b.fecha
                            );
                        }

                        return a.cita.hora
                            .localeCompare(
                                b.cita.hora
                            );
                    }
                )
                .slice(0, 5);


        proximasCitas.innerHTML = "";


        if (siguientes.length === 0) {

            proximasCitas.innerHTML = `
                <div class="cal-no-upcoming">
                    No tienes prÃ³ximas citaciones.
                </div>
            `;

            return;
        }


        siguientes.forEach(
            function (obj) {

                const cita =
                    obj.cita;

                const fecha =
                    obj.fecha;


                const item =
                    document.createElement("article");


                item.className =
                    "cal-upcoming-item";


                const fechaCaja =
                    document.createElement("div");


                fechaCaja.className =
                    "cal-upcoming-date";


                const numero =
                    document.createElement("strong");


                numero.textContent =
                    fecha.getDate();


                const mes =
                    document.createElement("span");


                mes.textContent =
                    new Intl.DateTimeFormat(
                        "es-CO",
                        {
                            month: "short"
                        }
                    ).format(
                        fecha
                    );


                fechaCaja.appendChild(
                    numero
                );

                fechaCaja.appendChild(
                    mes
                );


                const contenido =
                    document.createElement("div");


                contenido.className =
                    "cal-upcoming-content";


                const titulo =
                    document.createElement("h3");


                titulo.textContent =
                    cita.motivo
                    || "CitaciÃ³n";


                const informacion =
                    document.createElement("p");


                informacion.textContent =
                    (
                        cita.hora
                        || "Sin hora"
                    )
                    + " Â· "
                    + (
                        cita.estudiante
                        || "Estudiante"
                    );


                const estado =
                    document.createElement("p");


                estado.textContent =
                    cita.estado;


                contenido.appendChild(
                    titulo
                );

                contenido.appendChild(
                    informacion
                );

                contenido.appendChild(
                    estado
                );


                item.appendChild(
                    fechaCaja
                );

                item.appendChild(
                    contenido
                );


                proximasCitas.appendChild(
                    item
                );

            }
        );

    }


    /* =====================================================
       EVENTOS DE BOTONES
       ===================================================== */

    btnAnterior.addEventListener(
        "click",
        function () {

            mesVista =
                new Date(
                    mesVista.getFullYear(),
                    mesVista.getMonth() - 1,
