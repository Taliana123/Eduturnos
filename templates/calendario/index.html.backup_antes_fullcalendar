    );


    btnSiguiente.addEventListener(
        "click",
        function () {

            mesVista =
                new Date(
                    mesVista.getFullYear(),
                    mesVista.getMonth() + 1,
                    1
                );

            diaSeleccionado =
                null;

            renderCalendario();

            limpiarDetalle();
        }
    );


    btnHoy.addEventListener(
        "click",
        function () {

            mesVista =
                new Date(
                    hoy.getFullYear(),
                    hoy.getMonth(),
                    1
                );

            diaSeleccionado =
                new Date(hoy);

            renderCalendario();

            mostrarDetalle(hoy);
        }
    );


    filtroEstado.addEventListener(
        "change",
        function () {

            renderCalendario();

            if (diaSeleccionado) {
                mostrarDetalle(
                    diaSeleccionado
                );
            }

        }
    );


    function limpiarDetalle() {

        detalleTitulo.textContent =
            "Selecciona una fecha";

        detalleSubtitulo.textContent =
            "Haz clic sobre un dÃ­a para consultar sus citaciones.";

        detalleContenido.innerHTML = `
            <div class="cal-empty">
                <div class="cal-empty-icon">+</div>
                <h3>Sin fecha seleccionada</h3>
                <p>
                    Selecciona un dÃ­a del calendario para
                    ver las citas programadas.
                </p>
            </div>
        `;
    }


    /* =====================================================
       INICIALIZAR
       ===================================================== */

    renderCalendario();

    renderProximas();

    if (citas.length > 0) {

        const primera =
            citas
                .map(
                    function (cita) {
                        return {
                            cita: cita,
                            fecha:
                                convertirFecha(
                                    cita.fecha
                                )
                        };
                    }
                )
                .filter(
                    function (obj) {
                        return (
                            obj.fecha
                            &&
                            obj.fecha >= hoy
                        );
                    }
                )
                .sort(
                    function (a, b) {
                        return (
                            a.fecha - b.fecha
                        );
                    }
                )[0];

        if (primera) {

            mesVista =
                new Date(
                    primera.fecha.getFullYear(),
                    primera.fecha.getMonth(),
                    1
                );

            diaSeleccionado =
                new Date(
                    primera.fecha
                );

            renderCalendario();

            mostrarDetalle(
                primera.fecha
            );
        }

    }

});

