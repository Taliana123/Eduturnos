<style id="EDUTURNOS_DASHBOARD_VISUAL_COMPACTO_FINAL">

/* =========================================================
   EDUTURNOS
   DASHBOARD COMPACTO
   ========================================================= */

.dashboard-page {
    width: min(1160px, calc(100% - 44px));
    margin: 0 auto;
    padding: 28px 0 48px;
    box-sizing: border-box;

    color: #243b53;
}

/* =========================================================
   CABECERA
   ========================================================= */

.dashboard-head {
    position: relative;

    min-height: 150px !important;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 28px;

    margin-bottom: 18px;
    padding: 24px 28px !important;

    box-sizing: border-box;

    border: 1px solid #d9e7f2 !important;
    border-radius: 22px !important;

    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #f7fbff 100%
        ) !important;

    box-shadow:
        0 8px 24px rgba(42, 91, 125, .07) !important;

    color: #243b53 !important;

    overflow: hidden;
}

.dashboard-head::before {
    content: "";

    position: absolute;

    left: 0;
    top: 18px;
    bottom: 18px;

    width: 5px;

    border-radius: 0 5px 5px 0;

    background: #2f7da8;
}

/* =========================================================
   INFORMACIÓN DEL USUARIO
   ========================================================= */

.dashboard-head-info {

    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns: 76px minmax(0, 1fr);

    grid-template-areas:
        "art badge"
        "art title"
        "art text";

    column-gap: 18px;
    row-gap: 2px;

    align-items: center;

    min-width: 0;
}

.dashboard-role-art {

    grid-area: art;

    width: 76px;
    height: 76px;

    display: grid;
    place-items: center;
}

/* =========================================================
   DIBUJO / ILUSTRACIÓN DEL ROL
   ========================================================= */

.role-symbol {

    position: relative;

    width: 68px;
    height: 68px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            #eaf5fb,
            #d7edf8
        );

    border: 1px solid #c8e0ee;

    box-shadow:
        0 7px 16px rgba(43, 112, 150, .10);

    overflow: hidden;

    animation: eduturnosRolFlota 3.8s ease-in-out infinite;
}

/* cabeza */

.role-symbol::after {

    content: "";

    position: absolute;

    width: 20px;
    height: 20px;

    left: 24px;
    top: 12px;

    border-radius: 50%;

    background: #ffffff;

    border: 3px solid #2f7da8;

    box-sizing: border-box;

    box-shadow:
        0 2px 0 rgba(47,125,168,.08);
}

/* cuerpo */

.role-symbol::before {

    content: "";

    position: absolute;

    width: 34px;
    height: 23px;

    left: 17px;
    bottom: 12px;

    border-radius: 12px 12px 8px 8px;

    background: #2f7da8;

    box-shadow:
        inset 0 4px 0 rgba(255,255,255,.20);
}

/* detalles */

.role-symbol span,
.role-symbol i,
.role-symbol b {

    display: block;

    position: absolute;

    z-index: 3;

    font-style: normal;
}

/* ojos */

.role-symbol span::before,
.role-symbol span::after {

    content: "";

    position: absolute;

    width: 3px;
    height: 3px;

    top: 20px;

    border-radius: 50%;

    background: #243b53;
}

.role-symbol span::before {
    left: 29px;
}

.role-symbol span::after {
    left: 36px;
}

/* detalle inferior */

.role-symbol i {

    width: 10px;
    height: 4px;

    left: 29px;
    bottom: 20px;

    border-radius: 5px;

    background: #f2b84b;
}

/* detalle superior */

.role-symbol b {

    width: 28px;
    height: 4px;

    left: 20px;
    top: 7px;

    border-radius: 5px;

    background: #f2b84b;

    opacity: .9;
}

@keyframes eduturnosRolFlota {

    0%,
    100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-3px) rotate(.5deg);
    }
}

/* =========================================================
   BADGE
   ========================================================= */

.dashboard-head .badge {

    grid-area: badge;

    width: fit-content;

    margin: 0 0 2px;

    padding: 4px 9px;

    border-radius: 999px;

    background: #eaf4fa !important;

    border: 1px solid #d3e7f2;

    color: #2f7da8 !important;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: .07em;

    text-transform: uppercase;
}

/* =========================================================
